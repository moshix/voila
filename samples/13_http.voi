// 13_http.voi — an HTTP client and server with std/http (§10, §13.3, §13.4).
//
// This sample used to hand-roll the protocol on raw sockets, because there
// was no std/http to reach for. There is now, and the whole of what it used
// to do — build a request line, consume header lines to the blank one, count
// out a Content-Length — is `http.get` on one side and `serve_one` on the
// other. What is left in this file is what a program using HTTP actually
// writes: a handler, a loop, and the answers it cares about.
//
// A server task and a client task run in one group over the loopback
// interface, so the run is self-contained and deterministic (the ephemeral
// port is never printed).
package main

use "std/http"
use "std/fmt"

// handle is the whole server: a `fn(http.Request) http.Response`. The request
// arrives parsed — method, path, query, headers, body — and whatever it
// returns is written back with a status line and a Content-Length that match
// the body it actually carries.
func handle(req http.Request) http.Response {
    if req.path == "/hello" {
        return http.text(200, "You asked for: " || req.path ||
                              ", query=" || req.query || "\n")
    }
    if req.path == "/shout" {
        return http.text(200, str.upper(req.body) || "\n")
    }
    return http.not_found()
}

// server binds an OS-chosen port on loopback, publishes the address it got,
// and serves three requests. `serve_one` accepts one connection, reads one
// request, calls `handle` and writes the response; the loop around it is the
// program's, because how many connections to take — and whether to `spawn` a
// task per connection — is not a decision a library should make.
func server(addr chan[str], done chan[str]) {
    match http.listen("127.0.0.1:0") {
        Err(e)  => { addr <- "" ; done <- ("listen failed: " || e.message()) }
        Ok(srv) => {
            addr <- srv.addr()
            for i in 0..3 {
                match srv.serve_one(handle) {
                    Ok(u)  => u
                    Err(e) => say "server:", e.message()
                }
            }
            srv.close()
            done <- "server: three requests served"
        }
    }
}

// client asks three questions and prints the answers.
func client(addr chan[str]) {
    let where = <-addr
    if where == "" { return }
    let base = "http://" || where

    show("GET /hello", http.get(base || "/hello?who=world"))
    show("POST /shout", http.post(base || "/shout", "voila"))
    show("GET /missing", http.get(base || "/missing"))

    // A scheme std/http does not speak is refused by name, never guessed at.
    match http.get("ftp://example.com/") {
        Ok(r)  => say "unexpected success:", r.status
        Err(e) => say "refused:", e.message()
    }
}

// show prints one exchange: the status line and the body, plus the media type
// the server chose.
func show(what str, result http.Response!) {
    match result {
        Err(e) => say what, "failed:", e.message()
        Ok(r)  => {
            fmt.printf("%s -> %d %s (%s)\n", what, r.status, r.reason,
                       r.header("content-type"))
            fmt.printf("   %s", r.body)
        }
    }
}

func main() {
    let addr = chan[str](1)
    let done = chan[str](1)
    group {
        spawn server(addr, done)
        spawn client(addr)
    }
    say <-done
}
