// std/time — instants, durations, and CALENDAR DATES (§13.4).
//
// The package has two halves that meet in one place.
//
// The STOPWATCH half is C, and predates this file: `time.now()` reads
// CLOCK_REALTIME and hands back an `instant` (nanoseconds since the Unix
// epoch), `time.since(i)` and the six duration constants measure elapsed
// time, `time.sleep` and `time.after` wait. None of it knows what day it is,
// and none of it needs to.
//
// The CALENDAR half is this file: `DateTime`, the decomposition of an instant
// into year/month/day/hour/minute/second/nanosecond, and RFC 3339. It is
// written in Voilà because it is arithmetic — the civil-from-days conversions
// below are exact integer identities over the proleptic Gregorian calendar,
// and there is nothing about them a C implementation would do better. Only
// two things genuinely need the machine, and those are the two C shims this
// file calls: `time._instant` (make an instant out of a nanosecond count) and
// `time._local_offset` (ask the C library what the process's UTC offset is).
//
// -------------------------------------------------------------- timezones
//
// std/time knows THREE things about zones, and this list is exhaustive:
//
//   1. UTC — offset 0.
//   2. A FIXED OFFSET you supply, in seconds east of Greenwich.
//   3. The PROCESS's own offset, as the C library reports it for a given
//      instant (`localtime_r`), which is what `now_local` and `local` use.
//      An instant the C library cannot express — a year beyond what its
//      `struct tm` holds — reads as offset 0 rather than failing.
//
// There is NO tzdata. You cannot name a zone, you cannot ask what
// "Europe/Berlin" was doing in 1974, and a `DateTime` carries an offset
// rather than a zone — so it cannot tell you what its own offset will become
// after the next daylight-saving transition. Case 3 is the one exception
// where a real transition is honoured, and only because the C library is
// asked afresh for the instant in question rather than for "now".
//
// If you need named zones, this package is the wrong tool and saying so
// plainly is better than half-implementing them.
//
// --------------------------------------------------------------- no strftime
//
// Nothing here calls strftime and nothing here ever should. strftime is
// locale-dependent — month names, digit shapes and even separators move under
// LC_TIME — and Voilà's tests compare program output byte for byte, so a
// machine in a different locale would print different bytes for the same
// program. Every character this file emits is emitted by this file.
//
// ------------------------------------------------------------------- ranges
//
// Three different limits apply, and they are far apart, so it is worth being
// exact about which one you are near.
//
//   - The CALENDAR is unbounded in practice: construction, comparison,
//     weekday, yearday, RFC 3339 and the second-based Unix conversions are
//     all seconds arithmetic, good to year ±292 billion.
//   - NANOSECONDS are int64, which is 1677-09-21T00:12:43.145224192Z to
//     2262-04-11T23:47:16.854775807Z, inclusive at both ends. `unix_nanos`,
//     `to_instant` and `add` are the calls that use them; outside that range
//     they overflow, which aborts rather than lying. Everything else keeps
//     working.
//   - RFC 3339 has four year digits and no room for offset seconds, so
//     `rfc3339` is only a legal RFC 3339 timestamp for years 0..9999, and an
//     offset that is not a whole number of minutes renders to its
//     whole-minute part.
package time

use "std/fmt"

const NS_PER_SECOND = 1_000_000_000
const SECONDS_PER_DAY = 86_400

// ---------------------------------------------------------------- the type

// DateTime is one moment, read on a calendar at one offset from UTC.
//
// It is a plain struct with plain integer fields, so `d.year` is the year and
// nothing has to be unwrapped to get at it. The offset is part of the value:
// two DateTimes with different offsets can name the SAME instant, and
// `to_instant` is what says whether they do.
//
// Every DateTime that `date`, `parse_rfc3339` or any of the `from_*`
// constructors produces is normalized and in range. Building one with a
// struct literal skips that check, so use the constructors.
struct DateTime {
    year       int      // proleptic Gregorian; may be negative
    month      int      // 1..12
    day        int      // 1..31, and never past the end of the month
    hour       int      // 0..23
    minute     int      // 0..59
    second     int      // 0..59 — leap seconds are not represented
    nanosecond int      // 0..999999999
    offset     int      // seconds EAST of UTC; 0 is UTC
}

// ---------------------------------------------------------------- the clock

// now_utc is the current moment, read in UTC.
//
// It is deliberately not called `now`: `time.now()` is the stopwatch's
// instant and stays what it always was.
func now_utc() DateTime {
    return from_instant(time.now())
}

// now_local is the current moment, read at the process's own UTC offset.
func now_local() DateTime {
    let i = time.now()
    return from_unix_nanos_at(i.unix_nanos(), time._local_offset(i.unix()))
}

// local_offset is the process's UTC offset right now, in seconds east of
// Greenwich: 3600 in Berlin in winter, -18000 in New York in winter, 0 when
// TZ is UTC.
func local_offset() int {
    return time._local_offset(time.now().unix())
}

// offset_at is local_offset for a moment that is not now. Summer time makes
// the two different answers, and using today's offset to read last winter's
// timestamp is off by an hour — which is why this takes the instant it is
// being asked about.
func offset_at(i instant) int {
    return time._local_offset(i.unix())
}

// ---------------------------------------------------------- constructors

// date builds a DateTime from its parts, checking every one of them. The
// offset is in seconds east of UTC.
//
//     let d = must time.date(2024, 2, 29, 12, 0, 0, 0, 2 * 3600)
func date(year int, month int, day int, hour int, minute int, second int,
          nanosecond int, offset int) DateTime throws ValueError {
    if month < 1 or month > 12 {
        return errf("month {month} out of range (1..12)")
    }
    let dim = days_in_month(year, month)
    if day < 1 or day > dim {
        return errf("day {day} out of range (1..{dim}) for " ||
                    fmt.sprintf("%04d-%02d", year, month))
    }
    if hour < 0 or hour > 23 {
        return errf("hour {hour} out of range (0..23)")
    }
    if minute < 0 or minute > 59 {
        return errf("minute {minute} out of range (0..59)")
    }
    // 60 would be a leap second. This package has no leap-second table and
    // will not pretend to: rejecting is honest, and quietly folding 60 into
    // the next minute would move the timestamp.
    if second < 0 or second > 59 {
        return errf("second {second} out of range (0..59); leap seconds are " ||
                    "not represented")
    }
    if nanosecond < 0 or nanosecond > 999999999 {
        return errf("nanosecond {nanosecond} out of range (0..999999999)")
    }
    if offset <= 0 - SECONDS_PER_DAY or offset >= SECONDS_PER_DAY {
        return errf("offset {offset}s out of range (must be within one day " ||
                    "of UTC)")
    }
    return DateTime{year: year, month: month, day: day, hour: hour,
                    minute: minute, second: second, nanosecond: nanosecond,
                    offset: offset}
}

// utc is `date` for the common case: a whole second, in UTC.
func utc(year int, month int, day int, hour int, minute int,
         second int) DateTime throws ValueError {
    return try date(year, month, day, hour, minute, second, 0, 0)
}

// from_unix reads a Unix timestamp (whole seconds since 1970-01-01T00:00:00Z)
// in UTC. Negative timestamps are dates before 1970 and work.
func from_unix(secs int) DateTime {
    return from_unix_seconds_at(secs, 0, 0)
}

// from_unix_at is from_unix read at a fixed offset instead of in UTC.
func from_unix_at(secs int, offset int) DateTime {
    return from_unix_seconds_at(secs, 0, offset)
}

// from_unix_nanos reads a Unix timestamp in NANOSECONDS, in UTC.
func from_unix_nanos(nanos int) DateTime {
    return from_unix_nanos_at(nanos, 0)
}

// from_unix_nanos_at reads an epoch NANOSECOND count at a fixed offset. It
// splits the count into a floored second and the non-negative fraction above
// it, then hands both to from_unix_seconds_at — so nanoseconds are used for
// nothing but the split, and the seconds path stays free of the int64
// nanosecond range limit.
//
// The fraction is `%`, floor modulus, and NOT `nanos - secs * NS_PER_SECOND`:
// that product overflows for the bottom second of the int64 range, so the
// split meant to escape the nanosecond limit was itself aborting inside it.
func from_unix_nanos_at(nanos int, offset int) DateTime {
    return from_unix_seconds_at(nanos ~/ NS_PER_SECOND,
                                nanos % NS_PER_SECOND, offset)
}

// from_unix_seconds_at is the one decomposition every other constructor goes
// through: an epoch SECOND, the nanoseconds above it, and an offset; out
// comes the calendar reading.
//
// `~/` is FLOOR division and `%` is floor modulus (§4.4), which is exactly
// what a date before 1970 needs — the remainder stays non-negative, so -1s
// lands on 1969-12-31T23:59:59Z rather than on some truncated-toward-zero
// nonsense a day out.
func from_unix_seconds_at(secs int, nanosecond int, offset int) DateTime {
    let local = secs + offset
    let days = local ~/ SECONDS_PER_DAY
    let sod = local - days * SECONDS_PER_DAY         // second of the day
    let y, m, d = civil_from_days(days)
    return DateTime{year: y, month: m, day: d,
                    hour: sod ~/ 3600, minute: (sod ~/ 60) % 60,
                    second: sod % 60, nanosecond: nanosecond, offset: offset}
}

// from_instant reads an `instant` — what time.now() returns — in UTC.
func from_instant(i instant) DateTime {
    return from_unix_nanos_at(i.unix_nanos(), 0)
}

// from_instant_at reads an instant at a fixed offset.
func from_instant_at(i instant, offset int) DateTime {
    return from_unix_nanos_at(i.unix_nanos(), offset)
}

// local reads an instant at the offset the process was at THEN, not now.
func local(i instant) DateTime {
    return from_unix_nanos_at(i.unix_nanos(), time._local_offset(i.unix()))
}

// ------------------------------------------------------------ the calendar

// is_leap_year applies the full Gregorian rule: every fourth year, except
// centuries, except every fourth century. 1900 is not a leap year; 2000 is.
func is_leap_year(y int) bool {
    if y % 4 != 0 { return false }
    if y % 100 != 0 { return true }
    return y % 400 == 0
}

// days_in_month is the length of one month, February included.
func days_in_month(y int, m int) int {
    if m == 2 {
        if is_leap_year(y) { return 29 }
        return 28
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { return 30 }
    return 31
}

// days_from_civil is the day number of a proleptic Gregorian date, counted
// from 1970-01-01 (day 0), and civil_from_days is its exact inverse. They are
// Howard Hinnant's algorithms, which are the standard closed forms: no loops,
// no tables, no year-by-year accumulation, and correct for every year an
// int64 can hold, negative ones included.
//
// The trick both rest on is shifting the year to start in MARCH, which puts
// the leap day at the END of the year where it perturbs nothing, and then
// working in 400-year "eras" of exactly 146097 days — the Gregorian cycle.
// Inside an era every quantity is non-negative, so `~/` (floor division) and
// C's truncating division would agree there; the two places the sign can
// actually go negative, the era number itself, want the floor and get it.
func days_from_civil(y0 int, m int, d int) int {
    var y = y0
    if m <= 2 { y -= 1 }                       // March-based year
    let era = y ~/ 400
    let yoe = y - era * 400                    // year of era, 0..399
    var mp = m - 3                             // March is month 0
    if m <= 2 { mp = m + 9 }
    let doy = (153 * mp + 2) ~/ 5 + d - 1      // day of March-based year
    let doe = yoe * 365 + yoe ~/ 4 - yoe ~/ 100 + doy
    return era * 146097 + doe - 719468         // 719468 = days 0000-03-01..1970-01-01
}

func civil_from_days(z0 int) (int, int, int) {
    let z = z0 + 719468
    let era = z ~/ 146097
    let doe = z - era * 146097                 // day of era, 0..146096
    let yoe = (doe - doe ~/ 1460 + doe ~/ 36524 - doe ~/ 146096) ~/ 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe ~/ 4 - yoe ~/ 100)
    let mp = (5 * doy + 2) ~/ 153              // March-based month, 0..11
    let d = doy - (153 * mp + 2) ~/ 5 + 1
    var m = mp + 3
    if mp >= 10 { m = mp - 9 }                 // January and February
    if m <= 2 { return y + 1, m, d }
    return y, m, d
}

// ------------------------------------------------------------------ methods

impl DateTime {
    // unix is the Unix timestamp in whole seconds, FLOORED — one second
    // before the epoch is -1, not 0. This is the primitive every other
    // conversion here is built on, and it is seconds rather than nanoseconds
    // on purpose: nanoseconds run out in 2262 and seconds do not.
    func unix(self) int {
        let days = days_from_civil(self.year, self.month, self.day)
        return days * SECONDS_PER_DAY + self.hour * 3600 + self.minute * 60 +
               self.second - self.offset
    }

    // unix_millis is the Unix timestamp in whole milliseconds, floored. The
    // nanosecond field is the non-negative fraction ABOVE the floored second,
    // so this stays right on the negative side: -1s and 500ms is -500.
    func unix_millis(self) int {
        return self.unix() * 1_000 + self.nanosecond ~/ 1_000_000
    }

    // unix_nanos is the Unix timestamp in nanoseconds. It OVERFLOWS outside
    // 1677-09-21..2262-04-11, which is what an int64 nanosecond count holds;
    // an overflow aborts rather than wrapping (§3.2).
    func unix_nanos(self) int {
        return self.unix() * NS_PER_SECOND + self.nanosecond
    }

    // to_instant is the round trip back to the stopwatch half: the same
    // moment as an `instant`, which time.since and time.sleep understand.
    // The offset is subtracted, so a DateTime and its reading at any other
    // offset produce the SAME instant. Nanosecond range, as above.
    func to_instant(self) instant {
        return time._instant(self.unix_nanos())
    }

    // to_offset is the same moment read at a different offset from UTC:
    // unix() is unchanged, every field is not. Unlike `date` it does not
    // check the offset, because it cannot fail any other way and a `throws`
    // signature on a pure re-reading would infect every caller; an absurd
    // offset simply produces an absurd reading.
    func to_offset(self, offset int) DateTime {
        return from_unix_seconds_at(self.unix(), self.nanosecond, offset)
    }

    // to_utc is to_offset(0).
    func to_utc(self) DateTime {
        return self.to_offset(0)
    }

    // to_local is the same moment read at the process's offset FOR THAT
    // MOMENT — so a summer timestamp reads in summer time even in January.
    func to_local(self) DateTime {
        let s = self.unix()
        return from_unix_seconds_at(s, self.nanosecond, time._local_offset(s))
    }

    // add moves the moment by a duration, keeping the offset. It works in
    // elapsed time, so it never has to think about month lengths:
    //
    //     must time.utc(2024, 2, 28, 0, 0, 0).add(24 * time.Hour)   // 2024-02-29
    //
    // The duration is split into whole seconds and a remainder before it is
    // applied, so only the DURATION has to fit in int64 nanoseconds — the
    // date being moved does not.
    func add(self, d dur) DateTime {
        let n = d.nanos()
        // Floor division and floor modulus, so the remainder is in
        // [0, NS_PER_SECOND) whatever the sign of the duration — which is
        // what makes the carry below at most one second. Spelling the
        // remainder `n - ds * NS_PER_SECOND` would say the same thing and
        // overflow for a duration near the bottom of the int64 range.
        let ds = n ~/ NS_PER_SECOND
        var ns = self.nanosecond + n % NS_PER_SECOND
        var carry = 0
        if ns >= NS_PER_SECOND {
            carry = 1
            ns -= NS_PER_SECOND
        }
        return from_unix_seconds_at(self.unix() + ds + carry, ns, self.offset)
    }

    // before and after compare MOMENTS, not fields, so two readings of the
    // same instant at different offsets are neither before nor after each
    // other. The comparison is (second, nanosecond) rather than one
    // nanosecond count, so it holds for dates a nanosecond count cannot
    // reach.
    func before(self, other DateTime) bool {
        let a = self.unix()
        let b = other.unix()
        if a != b { return a < b }
        return self.nanosecond < other.nanosecond
    }

    func after(self, other DateTime) bool {
        return other.before(self)
    }

    // same_moment is the equality that goes with before and after. `==` on
    // two DateTimes compares FIELDS, which is a different and also useful
    // question — it is what tells you the two were read at the same offset.
    func same_moment(self, other DateTime) bool {
        return self.unix() == other.unix() and
               self.nanosecond == other.nanosecond
    }

    // weekday is 0 for Sunday through 6 for Saturday, matching C's tm_wday.
    // 1970-01-01 was a Thursday, hence the +4; `%` is floor modulus, so dates
    // before the epoch answer correctly instead of going negative.
    func weekday(self) int {
        return (days_from_civil(self.year, self.month, self.day) + 4) % 7
    }

    // weekday_name is the English name. It is English on every machine and in
    // every locale, deliberately — see the note on strftime in the header.
    func weekday_name(self) str {
        return weekday_names()[self.weekday()]
    }

    // month_name is the English month name, on the same terms.
    func month_name(self) str {
        return month_names()[self.month - 1]
    }

    // yearday is 1 for 1 January through 365 (366 in a leap year).
    func yearday(self) int {
        return days_from_civil(self.year, self.month, self.day) -
               days_from_civil(self.year, 1, 1) + 1
    }

    // ---------------------------------------------------------- formatting

    // rfc3339 renders the timestamp as RFC 3339 §5.6:
    //
    //     2026-08-25T13:04:05Z
    //     2026-08-25T13:04:05.5+02:00
    //
    // The fraction is omitted when the nanosecond is zero, and otherwise
    // printed to the shortest of 3, 6 or 9 digits that loses nothing — the
    // same rule Go's RFC3339Nano follows, and a deterministic one, which
    // matters because these bytes end up in goldens.
    //
    // UTC prints `Z`, never `+00:00`. See the header for the two ways this
    // can fall outside RFC 3339 proper: a year outside 0..9999, and an offset
    // that is not a whole number of minutes.
    func rfc3339(self) str {
        return fmt.sprintf("%04d-%02d-%02dT%02d:%02d:%02d", self.year,
                           self.month, self.day, self.hour, self.minute,
                           self.second) ||
               fraction_text(self.nanosecond) || offset_text(self.offset)
    }

    // date_string is just the date: "2026-08-25".
    func date_string(self) str {
        return fmt.sprintf("%04d-%02d-%02d", self.year, self.month, self.day)
    }

    // time_string is just the clock, to the second: "13:04:05".
    func time_string(self) str {
        return fmt.sprintf("%02d:%02d:%02d", self.hour, self.minute,
                           self.second)
    }
}

// A DateTime shows as its RFC 3339 form, so `say d` and "{d}" print something
// a person and a parser both understand.
impl Show for DateTime {
    func show(self) str { return self.rfc3339() }
}

// fraction_text is the "." and the digits after the seconds, or "" when there
// is nothing to print.
func fraction_text(ns int) str {
    if ns == 0 { return "" }
    if ns % 1_000_000 == 0 { return fmt.sprintf(".%03d", ns ~/ 1_000_000) }
    if ns % 1_000 == 0 { return fmt.sprintf(".%06d", ns ~/ 1_000) }
    return fmt.sprintf(".%09d", ns)
}

// offset_text is the zone suffix: "Z" for UTC, else "+HH:MM" or "-HH:MM".
//
// RFC 3339 has no place for offset seconds, so an offset that is not a whole
// number of minutes renders to its whole-minute part. Modern zones are all
// whole minutes; the ones that are not are pre-1900 local mean time, which
// `to_local` on an old enough instant really does hand back. One consequence
// is worth naming: an offset of -59..-1 seconds renders `-00:00`, to which
// RFC 3339 §4.3 gives the distinct meaning "offset unknown", and parses back
// as UTC.
func offset_text(off int) str {
    if off == 0 { return "Z" }
    var sign = "+"
    var a = off
    if a < 0 {
        sign = "-"
        a = 0 - a
    }
    return fmt.sprintf("%s%02d:%02d", sign, a ~/ 3600, (a % 3600) ~/ 60)
}

func weekday_names() []str {
    return ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday",
            "Saturday"]
}

func month_names() []str {
    return ["January", "February", "March", "April", "May", "June", "July",
            "August", "September", "October", "November", "December"]
}

// -------------------------------------------------------------- parsing

// parse_rfc3339 reads an RFC 3339 §5.6 timestamp back into a DateTime, with
// the offset it was written at — so a round trip through rfc3339() gives back
// an equal value, offset and all, and not merely an equal moment.
//
//     let d = must time.parse_rfc3339("2026-08-25T13:04:05.25+02:00")
//
// What is accepted, exactly:
//
//   - `T` between the date and the time; RFC 3339 §5.6's lower-case `t` and
//     the NOTE's space are accepted too.
//   - a fraction of any length after the seconds, truncated to nanoseconds.
//   - `Z`, `z`, or `+HH:MM` / `-HH:MM`. The offset is NOT optional: a
//     timestamp without one does not say what moment it means, and guessing
//     UTC is how timestamps drift by hours. `-00:00`, which RFC 3339 §4.3
//     gives the distinct meaning "offset unknown", is read as plain UTC and
//     writes back as `Z`: a DateTime has nowhere to record "unknown".
//
// Anything else — a missing field, a stray character, a date that does not
// exist, `24:00`, a leap second — is a FormatError naming what was wrong and
// where.
func parse_rfc3339(s str) DateTime throws FormatError {
    // The fixed part is exactly 19 characters: 4-2-2 T 2:2:2. The zone that
    // must follow it is checked further down, where the message can say that
    // the zone is what is missing rather than that the string is short.
    if len(s) < 19 {
        return errf("`{s}` is too short for an RFC 3339 timestamp " ||
                    "(want at least YYYY-MM-DDTHH:MM:SSZ)")
    }
    let year = try digits_at(s, 0, 4, "year")
    try literal_at(s, 4, '-', "-")
    let month = try digits_at(s, 5, 2, "month")
    try literal_at(s, 7, '-', "-")
    let day = try digits_at(s, 8, 2, "day")
    let sep = s[10]
    if sep != 'T' and sep != 't' and sep != ' ' {
        return errf("expected `T` between the date and the time at offset " ||
                    "10 of `{s}`")
    }
    let hour = try digits_at(s, 11, 2, "hour")
    try literal_at(s, 13, ':', ":")
    let minute = try digits_at(s, 14, 2, "minute")
    try literal_at(s, 16, ':', ":")
    let second = try digits_at(s, 17, 2, "second")

    var i = 19
    var nanosecond = 0
    if i < len(s) and s[i] == '.' {
        i += 1
        var scale = 100_000_000
        var seen = 0
        while i < len(s) and s[i] >= '0' and s[i] <= '9' {
            // Digits past the ninth are read and dropped: a nanosecond is as
            // fine as this type gets, and refusing a timestamp for being MORE
            // precise than we can store would reject valid RFC 3339.
            if scale > 0 {
                nanosecond += (s[i] - '0') * scale
                scale = scale ~/ 10
            }
            seen += 1
            i += 1
        }
        if seen == 0 {
            return errf("`.` at offset {i - 1} of `{s}` is not followed by a " ||
                        "fraction")
        }
    }

    var offset = 0
    if i >= len(s) {
        return errf("`{s}` has no time zone; RFC 3339 requires `Z` or " ||
                    "±HH:MM")
    }
    let z = s[i]
    if z == 'Z' or z == 'z' {
        i += 1
    } else if z == '+' or z == '-' {
        if i + 6 > len(s) {
            return errf("truncated time zone in `{s}` (want ±HH:MM)")
        }
        let oh = try digits_at(s, i + 1, 2, "offset hour")
        try literal_at(s, i + 3, ':', ":")
        let om = try digits_at(s, i + 4, 2, "offset minute")
        if oh > 23 {
            return errf("time zone hour {oh} out of range (0..23) in `{s}`")
        }
        if om > 59 {
            return errf("time zone minute {om} out of range (0..59) in `{s}`")
        }
        offset = oh * 3600 + om * 60
        if z == '-' { offset = 0 - offset }
        i += 6
    } else {
        return errf("expected `Z` or ±HH:MM at offset {i} of `{s}`")
    }
    if i != len(s) {
        return errf("trailing text `{s[i..len(s)]}` after the timestamp in " ||
                    "`{s}`")
    }

    // date() is what rejects 2023-02-29 and 25:00. Its message says which
    // field and what the legal range was, which is what the caller needs;
    // re-wording it here would only lose that.
    match date(year, month, day, hour, minute, second, nanosecond, offset) {
        Ok(d) => return d
        Err(e) => return errf("`{s}`: {e.message()}")
    }
}

// digits_at reads exactly `n` ASCII digits at `at`, or fails naming the field.
func digits_at(s str, at int, n int, what str) int throws FormatError {
    if at + n > len(s) {
        return errf("`{s}` ends before its {what}")
    }
    var v = 0
    var i = at
    while i < at + n {
        let c = s[i]
        if c < '0' or c > '9' {
            return errf("expected {n} digits for the {what} at offset {at} " ||
                        "of `{s}`")
        }
        v = v * 10 + (c - '0')
        i += 1
    }
    return v
}

// literal_at asserts one exact character. `shown` is how it is spelled in the
// message, because a rune renders as a number.
//
// The result is `unit!` rather than nothing: the failure is an error VALUE,
// so the function does return one thing — unit, or the error. (Bare `unit` is
// the empty type, and a function with no result cannot return one; std/net's
// write_all documents the same distinction.)
func literal_at(s str, at int, c rune, shown str) unit! {
    if at >= len(s) or s[at] != c {
        return errf("expected `{shown}` at offset {at} of `{s}`")
    }
    return ()
}
