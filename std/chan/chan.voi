// std/chan — channel plumbing: sources, fan-in, fan-out, pipeline stages and
// a rate limiter (§13.4).
//
// Every function that returns a channel starts the task that feeds it, with
// `spawn`, and returns at once. Those tasks are ordinary structured tasks
// (§9.1): they belong to the group the CALLER is running in — the enclosing
// `group { … }`, or the program's root group — so that group does not finish
// until they have, and a failure in one cancels its siblings exactly as for a
// task the caller spawned by hand. The rule that keeps this from hanging is
// the usual one for channels: a stage finishes when its INPUT is closed, so
// close the channels you feed.
//
//     group {
//         let nums = chan.from([1, 2, 3, 4])
//         let sq = chan.map(nums, fn(n int) int { return n * n })
//         say chan.collect(sq)                     // [1, 4, 9, 16]
//     }
//
// Every output channel is unbuffered unless the function says otherwise, so
// a slow consumer slows the stage that feeds it — back-pressure, not an
// unbounded queue.
//
// AN ABANDONED PIPELINE NEVER FINISHES. A stage blocks sending a value
// nobody receives, and because it is a task of the caller's group, that
// group — the program, at the top level — waits for it forever:
// `let c = chan.from([1, 2, 3]); say <-c` takes one value and then hangs at
// the end of main. Drain what you start (`collect`, or `each` to the end).
//
// Every task here is spawned in CALL form (`spawn feed(xs, out)`), never as
// a `spawn { … }` block: a block captures the frame of the function that
// spawned it, and these functions return while their tasks run on.
package chan

use "std/time"

// from is a channel that yields the elements of xs in order, then closes.
func from[T](xs []T) chan[T] {
    let out = chan[T](0)
    spawn feed(xs, out)
    return out
}

func feed[T](xs []T, out chan[T]) {
    each x in xs { out <- x }
    close(out)
}

// collect drains a channel until it is closed and returns what it yielded.
func collect[T](src chan[T]) []T {
    var out = []
    each v in src { out.append(v) }
    return out
}

// map is a pipeline stage: every value of src, passed through f. The output
// closes when src does.
func map[T, U](src chan[T], f fn(T) U) chan[U] {
    let out = chan[U](0)
    spawn map_stage(src, f, out)
    return out
}

func map_stage[T, U](src chan[T], f fn(T) U, out chan[U]) {
    each v in src { out <- f(v) }
    close(out)
}

// filter is a pipeline stage that passes on only the values `keep` accepts.
func filter[T](src chan[T], keep fn(T) bool) chan[T] {
    let out = chan[T](0)
    spawn filter_stage(src, keep, out)
    return out
}

func filter_stage[T](src chan[T], keep fn(T) bool, out chan[T]) {
    each v in src {
        if keep(v) { out <- v }
    }
    close(out)
}

// merge is FAN-IN: one channel carrying every value of every input, in
// whatever order they arrive. It closes once ALL the inputs have closed —
// one forwarding task per input, and a last task that waits for them all.
func merge[T](srcs []chan[T]) chan[T] {
    let out = chan[T](0)
    // Each forwarder reports on `done` when its input is drained; the closer
    // counts the reports, so `out` is closed exactly once, after the last.
    let done = chan[int](len(srcs) + 1)
    each s in srcs {
        spawn forward(s, out, done)
    }
    spawn close_after(len(srcs), done, out)
    return out
}

// forward copies src to out, then reports on done.
func forward[T](src chan[T], out chan[T], done chan[int]) {
    each v in src { out <- v }
    done <- 1
}

// close_after waits for n reports on done, then closes out.
func close_after[T](n int, done chan[int], out chan[T]) {
    var left = n
    while left > 0 {
        let x = <-done
        left -= x
    }
    close(out)
}

// fan_out is FAN-OUT: n channels that share the values of src between them,
// each value going to exactly ONE of them — whichever worker is ready first,
// since every output is fed from one distributor that offers each value to
// all of them at once. All n close when src does.
func fan_out[T](src chan[T], n int) []chan[T] {
    if n < 1 {
        throw RangeError{msg: "chan.fan_out: {n} outputs; it needs at least 1"}
    }
    var outs = []
    var i = 0
    while i < n {
        outs.append(chan[T](0))
        i += 1
    }
    // One worker task per output pulls from src. A receive from a shared
    // channel hands each value to exactly one receiver, which is the
    // distribution fan-out wants, and whichever worker is free takes the
    // next value; each closes its own output when src is drained.
    each o in outs {
        spawn drain_into(src, o)
    }
    return outs
}

// drain_into copies src to dst until src closes, then closes dst.
func drain_into[T](src chan[T], dst chan[T]) {
    each v in src { dst <- v }
    close(dst)
}

// tee copies every value of src to BOTH outputs (a broadcast, where fan_out
// is a distribution). Each output has a queue of its own, without bound, so
// one consumer never waits for the other: the two may be read at different
// speeds — or one after the other, `collect(a)` then `collect(b)`, which a
// shared lock-step delivery would deadlock. The cost is memory: what the
// slower consumer has not read yet is held for it, and nothing longer — a
// delivered value leaves its queue. Each output is closed as soon as src is
// and that output's own queue has drained.
//
// Its cost is about twice a `chan.map` stage's. Most of that is the
// runtime's channel monitor, which is ONE lock and one condition variable
// for every channel: each operation wakes every task waiting on any
// channel, and a tee keeps three of them busy.
func tee[T](src chan[T]) (chan[T], chan[T]) {
    // The outputs are buffered: a value handed to a buffer costs no wait
    // for the consumer, so the stage runs in bursts instead of handing each
    // value over in a separate rendezvous.
    let a = chan[T](TEE_BUF)
    let b = chan[T](TEE_BUF)
    spawn tee_stage(src, a, b)
    return a, b
}

// TEE_BUF is each tee output's buffer, and the most values the stage takes
// from src in one burst.
const TEE_BUF = 256

// tee_stage is the whole of tee in ONE task: it reads src into two queues
// and feeds each output from its own, choosing with `select` among whichever
// of "receive more" and "deliver a's next" and "deliver b's next" can make
// progress. (A select's cases are fixed in the source, so each combination
// of open input and non-empty queues is its own branch.)
func tee_stage[T](src chan[T], a chan[T], b chan[T]) {
    var qa = []
    var ha = 0                   // qa[ha..] is still to be delivered to a
    var qb = []
    var hb = 0
    var open = true
    var doneA = false            // `a` has been closed
    var doneB = false
    while not (doneA and doneB) {
        let wa = ha < len(qa)
        let wb = hb < len(qb)
        // An output is closed the moment src is closed AND its own queue is
        // drained — not when both are: a reader that drains `a` completely
        // before it starts on `b` must see `a` end, or it waits forever for
        // the end of a channel the stage is still holding open for `b`.
        if not open and not wa and not doneA {
            close(a)
            doneA = true
        }
        if not open and not wb and not doneB {
            close(b)
            doneB = true
        }
        if doneA and doneB { break }
        var got = false          // a value arrived on src this turn
        if open and not wa and not wb {
            let v, ok = <-src
            if ok {
                qa.append(v)
                qb.append(v)
                got = true
            } else {
                open = false
            }
        } else if open and wa and not wb {
            let x = qa[ha]
            select {
            case v, ok := <-src:
                if ok {
                    qa.append(v)
                    qb.append(v)
                    got = true
                } else {
                    open = false
                }
            case a <- x:
                ha += 1
            }
        } else if open and wb and not wa {
            let y = qb[hb]
            select {
            case v, ok := <-src:
                if ok {
                    qa.append(v)
                    qb.append(v)
                    got = true
                } else {
                    open = false
                }
            case b <- y:
                hb += 1
            }
        } else if open {
            let x = qa[ha]
            let y = qb[hb]
            select {
            case v, ok := <-src:
                if ok {
                    qa.append(v)
                    qb.append(v)
                    got = true
                } else {
                    open = false
                }
            case a <- x:
                ha += 1
            case b <- y:
                hb += 1
            }
        } else if wa and wb {
            let x = qa[ha]
            let y = qb[hb]
            select {
            case a <- x:
                ha += 1
            case b <- y:
                hb += 1
            }
        } else if wa {
            a <- qa[ha]
            ha += 1
        } else {
            b <- qb[hb]
            hb += 1
        }
        // A burst: after one value, take what else is already waiting on
        // src without blocking, so a fast producer is drained in batches.
        var k = 0
        while got and k < TEE_BUF {
            select {
            case v, ok := <-src:
                if ok {
                    qa.append(v)
                    qb.append(v)
                } else {
                    open = false
                    got = false
                }
            default:
                got = false
            }
            k += 1
        }
        // Drop what has been delivered, once it is most of a queue, so the
        // memory goes back as the consumers catch up.
        if ha > TEE_BUF and ha * 2 > len(qa) {
            qa = qa[ha..len(qa)]
            ha = 0
        }
        if hb > TEE_BUF and hb * 2 > len(qb) {
            qb = qb[hb..len(qb)]
            hb = 0
        }
    }
}

// Limiter is a token-bucket rate limiter: `wait` blocks until the caller may
// proceed, so at most `burst` calls go through at once and, on average, one
// per `every` after that. It is not shared between tasks by itself — wrap it
// in a `cell` or give each task its own.
struct Limiter {
    every  dur
    burst  int
    tokens int
    last   int     // time.millis() of the last refill
}

// limiter is a Limiter that lets one call through per `every`, with up to
// `burst` calls allowed back to back after an idle spell. `burst` below 1 is
// taken as 1.
func limiter(every dur, burst int) Limiter {
    var b = burst
    if b < 1 { b = 1 }
    return Limiter{every: every, burst: b, tokens: b, last: now_ms()}
}

impl Limiter {
    // wait takes one token, sleeping until one is available.
    func wait(mut self) {
        while true {
            self.refill()
            if self.tokens > 0 {
                self.tokens -= 1
                return
            }
            time.sleep(self.every)
        }
    }

    // allow takes one token if one is available right now, and reports
    // whether it did. It never sleeps.
    func allow(mut self) bool {
        self.refill()
        if self.tokens > 0 {
            self.tokens -= 1
            return true
        }
        return false
    }

    // refill adds the tokens earned since the last refill: one per `every`
    // elapsed, capped at `burst`. The remainder of a partial interval is
    // kept by advancing `last` by whole intervals only.
    func refill(mut self) {
        let step = self.every.millis()
        if step <= 0 {
            self.tokens = self.burst
            return
        }
        let now = now_ms()
        let earned = (now - self.last) ~/ step
        if earned > 0 {
            self.tokens = min(self.burst, self.tokens + earned)
            self.last = self.last + earned * step
        }
    }
}

// throttle is a pipeline stage that passes src on at most one value per
// `every` — the limiter above applied to a channel.
func throttle[T](src chan[T], every dur) chan[T] {
    let out = chan[T](0)
    spawn throttle_stage(src, every, out)
    return out
}

func throttle_stage[T](src chan[T], every dur, out chan[T]) {
    var lim = limiter(every, 1)
    each v in src {
        lim.wait()
        out <- v
    }
    close(out)
}

// now_ms is the limiter's millisecond clock.
func now_ms() int {
    return time.now().unix_millis()
}
