// tools/build.voi — the Voilà toolchain's build, written in Voilà.
//
// The first compiler comes from one of two places, and a shell script picks
// which: `build.sh` uses a prebuilt Voilà binary (>= 0.4.1) — the self-hosted
// primary path — while `bootstrap.bash` compiles the checked-in C seed with
// `cc` for a machine that has no Voilà binary yet. Either way, that first
// compiler `run`s THIS program, which drives the rest of the build: compile
// the compiler, compile the compiler with the compiler, and assert that the
// two agree. (Both scripts hand it the compiler as $VOILA=build/voila-boot.)
//
//     voila run tools/build.voi              build and verify the fixpoint
//     voila run tools/build.voi reseed       …and rewrite bootstrap/voilac.c
//     voila run tools/build.voi seed         stop after the seed
//     voila run tools/build.voi blob         only regenerate the embedded runtime
//                                            (and the vendored extensions)
//     voila run tools/build.voi stdblob      only regenerate the embedded std source
package main

use "std/os"
use "std/fmt"
use "std/str"

const BUILD   = "build"
const OUT     = "bin/voila"
const BLOB    = "voilac/rt/blob.voi"
const RTDIR   = "runtime/src"
const STDDIR  = "std"
const STDBLOB = "voilac/std/blob.voi"
const VBLOB   = "voilac/rt/vendor.voi"
const EXTDIR  = "runtime/src/ext"
const VENDIR  = "runtime/src/vendor"

// The runtime EXTENSIONS: a std package built on a vendored C library is
// compiled from these files only when a program uses it (voilac/main.voi,
// vendor_lib). One row per extension, `unit|vendor directory|mode`:
//
//   include  the glue (runtime/src/ext/<unit>.c) #includes the library's one
//            .c file itself, so the glue is the only translation unit — the
//            single-file libraries, where the glue also sets their options;
//   compile  every .c of the library is a translation unit of its own, beside
//            the glue — BearSSL, whose files share static names.
const EXTENSIONS = ["compress|miniz|include", "sqlite|sqlite|include",
                    "tls|bearssl|compile"]

func main() {
    let args = os.args()
    var mode = "all"
    if len(args) > 0 { mode = args[0] }

    // The compiler that is running this program is our bootstrap: whoever
    // invoked us already has a working toolchain (build.sh's prebuilt binary,
    // or bootstrap.bash's cc-compiled seed — both exported as $VOILA).
    let voila = tool()

    // (os.mkdir_all exists now; see emit_c for why this still shells out.)
    sh("mkdir", ["-p", BUILD, "bin", "voilac/std"])

    // ---- 0. the runtime the compiler carries
    //
    // voilac/rt/blob.voi is libvoila's source, embedded in the compiler (the
    // Voilà equivalent of Go's //go:embed). If runtime/src has moved on, a
    // compiled program would be linked against a stale runtime — so regenerate
    // it and say so when it had drifted.
    // `stdblob` regenerates ONLY the std source below; every other mode
    // refreshes the runtime blob here (and `blob` stops after it).
    if mode != "stdblob" {
        head("0. the embedded runtime")
        let before = read_or(BLOB, "")
        let after = make_blob()
        if before != after {
            write_or_die(BLOB, after)
            warn("voilac/rt/blob.voi was stale; regenerated from runtime/src")
        } else {
            ok("voilac/rt/blob.voi is current")
        }
        // The vendored extensions ride in a blob of their own: they are
        // megabytes, and the core runtime's Data() is decoded on every
        // build, while these are decoded only on a cache miss.
        let vbefore = read_or(VBLOB, "")
        let vafter = make_vendor_blob()
        if vbefore != vafter {
            write_or_die(VBLOB, vafter)
            warn("voilac/rt/vendor.voi was stale; regenerated from " ||
                 "runtime/src/ext and runtime/src/vendor")
        } else {
            ok("voilac/rt/vendor.voi is current")
        }
        if mode == "blob" { return }
    }

    // ---- 0b. the Voilà-source standard library the compiler carries
    //
    // std/ holds standard-library packages written in Voilà (std/net first).
    // Like the runtime, they are embedded in the compiler — voilac/std/blob.voi
    // carries their source so `use "std/net"` in a user program can graft them
    // in with nothing on disk. Regenerate when std/ has drifted.
    head("0b. the embedded std-library source")
    let stdBefore = read_or(STDBLOB, "")
    let stdAfter = make_std_blob()
    if stdBefore != stdAfter {
        write_or_die(STDBLOB, stdAfter)
        warn("voilac/std/blob.voi was stale; regenerated from std/")
    } else {
        ok("voilac/std/blob.voi is current")
    }
    if mode == "stdblob" { return }

    if mode == "seed" {
        install_versioned(voila)
        return
    }

    // ---- 1. the compiler compiles the compiler
    // The shipped compiler is built at -O3: the optimizer changes the
    // compiler's SPEED, never its output, so the fixpoint below still
    // compares DEFAULT emission — and step 2b proves the optimized binary
    // emits the very same bytes.
    head("1. the compiler compiles itself (-O3)  →  voilac-1")
    let one = BUILD || "/voilac-1"
    must_run(voila, ["build", "-O3", "voilac/main.voi", "-o", one])
    ok(one)

    // ---- 2. …and the result compiles it again
    head("2. voilac-1 compiles itself  →  voilac-2, and the C must match")
    let c1 = BUILD || "/gen1.c"
    let c2 = BUILD || "/gen2.c"
    let two = BUILD || "/voilac-2"
    emit_c(one, c1)
    must_run(one, ["build", "-O3", "voilac/main.voi", "-o", two])
    emit_c(two, c2)

    let g1 = read_or(c1, "")
    let g2 = read_or(c2, "")
    if g1 != g2 {
        fail("NO FIXPOINT — generation 1 and 2 emit different C")
    }
    ok("fixpoint: C(voilac-1) == C(voilac-2)")

    // ---- 2b. the optimizer must not change WHAT the compiler emits, only
    // how fast it emits it: voilac-2 (built -O3 by an -O3 binary) must
    // produce byte-identical -O3 C for the compiler itself.
    let c3 = BUILD || "/gen1-O3.c"
    let c4 = BUILD || "/gen2-O3.c"
    emit_c_at(one, "-O3", c3)
    emit_c_at(two, "-O3", c4)
    if read_or(c3, "1") != read_or(c4, "2") {
        fail("NO OPTIMIZED FIXPOINT — -O3 emission differs between generations")
    }
    ok("optimized fixpoint: C(-O3, gen1) == C(-O3, gen2)")

    // The seed must be what the compiler actually emits for itself. When it has
    // drifted, the checked-in C is stale — which is not an error (the seed is
    // still a valid bootstrap), but it must be said out loud.
    let seed = read_or("bootstrap/voilac.c", "")
    if seed == g1 {
        ok("the checked-in seed is current")
    } else if mode == "reseed" {
        write_or_die("bootstrap/voilac.c", g1)
        ok("reseeded bootstrap/voilac.c")
    } else {
        warn("bootstrap/voilac.c is stale — run: voila run tools/build.voi reseed")
    }

    install_versioned(two)
    sh("rm", ["-rf", BUILD])
    head("done — ./voila is ready")
}

// tool finds the compiler to build with: $VOILA, else bin/voila, else the
// `voila` on PATH.
func tool() str {
    let env = os.env("VOILA")
    if env != nil {
        let s = str(env)
        if s != "" { return s }
    }
    if os.exists(OUT) { return OUT }
    return "voila"
}

// make_blob renders libvoila's source as a Voilà source file — the compiler
// carries the runtime inside itself, so a produced binary needs nothing on disk.
//
// The payload is base64, not escaped C: a C file is full of backslashes,
// quotes, braces and backticks, every one of which means something inside a
// Voilà string literal. Base64 is plain ASCII, the lexer scans each file as one
// flat token, and `unb64` gives the bytes back untouched.
func make_blob() str {
    var names = []
    // Headers first: the .c files include them.
    each n in listing(RTDIR) {
        if str.ends_with(n, ".h") { names.append(n) }
    }
    each n in listing(RTDIR) {
        if str.ends_with(n, ".c") { names.append(n) }
    }

    var b = str.Builder{}
    b.write("// Package rt — libvoila's source, carried inside the compiler.\n")
    b.write("//\n")
    b.write("// GENERATED by tools/build.voi. Do not edit: change runtime/src/\n")
    b.write("// and rebuild.\n")
    b.write("//\n")
    b.write("// `voila build` writes these files next to the C it emits and\n")
    b.write("// compiles the whole set with the system cc, so a produced binary\n")
    b.write("// depends on nothing but libc. The payload is base64 because C\n")
    b.write("// source is not a legal Voilà string literal.\n")
    b.write("package rt\n\n")
    b.write("use \"std/os\"\n")
    b.write("use \"std/str\"\n\n")
    b.write("// Names lists the runtime's files, headers first.\n")
    b.write("func Names() []str \{\n    return [\n")
    each n in names {
        b.write("        \"" || n || "\",\n")
    }
    b.write("    ]\n\}\n\n")
    b.write("// Data returns each file's contents, in the order Names gives.\n")
    b.write("func Data() []str \{\n    var out = []\n")
    each n in names {
        let text = read_or(RTDIR || "/" || n, "")
        b.write("    out.append(unb64(\"" || b64(text) || "\"))\n")
    }
    b.write("    return out\n\}\n\n")
    b.write("// WriteTo writes libvoila's source into a directory and returns\n")
    b.write("// the paths of the .c files, which are what `cc` must be handed.\n")
    b.write("func WriteTo(dir str) []str throws IOError \{\n")
    b.write("    var cfiles = []\n")
    b.write("    let names = Names()\n")
    b.write("    let data = Data()\n")
    b.write("    each i, n in names \{\n")
    b.write("        let p = dir || \"/\" || n\n")
    b.write("        try os.write(p, data[i])\n")
    b.write("        if str.ends_with(n, \".c\") \{ cfiles.append(p) \}\n")
    b.write("    \}\n")
    b.write("    return cfiles\n\}\n")
    return b.done()
}

// make_std_blob renders the Voilà-source standard-library packages under std/
// as a single Voilà module the compiler carries inside itself, exactly as
// make_blob does for the C runtime. `use "std/net"` in a user program pulls
// this embedded source in and grafts it into the program (see load.voi).
//
// Unlike the runtime blob (C source written to disk for cc), these are Voilà
// packages the loader parses and grafts, so the shape is Packages() /
// Files(pkg) / Source(pkg, file) rather than WriteTo. os.listdir sorts its
// result, so both the package order and the file order are deterministic —
// which the self-hosting fixpoint requires.
func make_std_blob() str {
    var pkgs = []
    each n in listing(STDDIR) {
        if os.isdir(STDDIR || "/" || n) { pkgs.append(n) }
    }

    var b = str.Builder{}
    b.write("// Package std — the Voilà-source standard library, carried\n")
    b.write("// inside the compiler.\n")
    b.write("//\n")
    b.write("// GENERATED by tools/build.voi. Do not edit: change std/ and\n")
    b.write("// rebuild. `use \"std/net\"` grafts these packages into a user\n")
    b.write("// program (see voilac/load/load.voi). The payload is base64\n")
    b.write("// because Voilà source is not a legal Voilà string literal.\n")
    b.write("package std\n\n")
    b.write("// Packages lists the std packages that have Voilà source.\n")
    b.write("func Packages() []str \{\n    return [\n")
    each p in pkgs {
        b.write("        \"" || p || "\",\n")
    }
    b.write("    ]\n\}\n\n")
    b.write("// Files lists a package's source files, in load order.\n")
    b.write("func Files(pkg str) []str \{\n")
    each p in pkgs {
        b.write("    if pkg == \"" || p || "\" \{\n        return [\n")
        each f in listing(STDDIR || "/" || p) {
            if str.ends_with(f, ".voi") {
                b.write("            \"" || f || "\",\n")
            }
        }
        b.write("        ]\n    \}\n")
    }
    b.write("    return []\n\}\n\n")
    b.write("// Source returns one file's text.\n")
    b.write("func Source(pkg str, file str) str \{\n")
    each p in pkgs {
        each f in listing(STDDIR || "/" || p) {
            if str.ends_with(f, ".voi") {
                let text = read_or(STDDIR || "/" || p || "/" || f, "")
                b.write("    if pkg == \"" || p || "\" and file == \"" ||
                        f || "\" \{ return unb64(\"" || b64(text) || "\") \}\n")
            }
        }
    }
    b.write("    return \"\"\n\}\n")
    return b.done()
}

// make_vendor_blob renders the runtime extensions (EXTENSIONS) as a Voilà
// source file of package rt, beside make_blob's. Each extension's files are
// FLATTENED into one directory — the glue as vl_ext_<unit>.c, the library's
// files under their base names — so the driver writes them side by side and
// compiles them with one -I. A base-name collision would silently drop a
// file, so it stops the build instead.
//
// Key(unit) is an FNV-1a digest of the unit's names and contents, computed
// HERE so the driver can look its cache up without decoding megabytes of
// base64 on every build. It is a content hash, not a version string: any
// edit to the glue or the library changes it.
func make_vendor_blob() str {
    var units = []
    var vdirs = make(map[str]str)
    var modes = make(map[str]str)
    each row in EXTENSIONS {
        let f = str.split(row, "|")
        units.append(f[0])
        vdirs[f[0]] = f[1]
        modes[f[0]] = f[2]
    }
    var names = make(map[str][]str)
    var texts = make(map[str][]str)
    var comp = make(map[str][]str)
    each u in units {
        var ns = ["vl_ext_" || u || ".c"]
        var ts = [read_or(EXTDIR || "/" || u || ".c", "")]
        var cs = ["vl_ext_" || u || ".c"]
        var seen = set(["vl_ext_" || u || ".c"])
        each rel in walk_files(VENDIR || "/" || vdirs[u]) {
            let base = last_part(rel)
            if not keep_vendor_file(base) { continue }
            if base in seen {
                fail("vendor file name collides when flattened: " || rel)
            }
            seen.add(base)
            ns.append(base)
            ts.append(read_or(VENDIR || "/" || vdirs[u] || "/" || rel, ""))
            if modes[u] == "compile" and str.ends_with(base, ".c") {
                cs.append(base)
            }
        }
        names[u] = ns
        texts[u] = ts
        comp[u] = cs
    }

    var b = str.Builder{}
    b.write("// Package rt — the runtime EXTENSIONS: the vendored C libraries\n")
    b.write("// (and their glue) behind std/tls, std/compress and std/sqlite.\n")
    b.write("//\n")
    b.write("// GENERATED by tools/build.voi. Do not edit: change runtime/src/ext\n")
    b.write("// or runtime/src/vendor and rebuild. voilac/main.voi compiles a\n")
    b.write("// unit into a cached archive the first time a program uses it.\n")
    b.write("package rt\n\n")
    b.write("use \"std/os\"\n\n")
    b.write("// VendorUnits lists the extensions.\n")
    b.write("func VendorUnits() []str \{\n    return [\n")
    each u in units { b.write("        \"" || u || "\",\n") }
    b.write("    ]\n\}\n\n")
    b.write("// VendorKey is a digest of a unit's file names and contents.\n")
    b.write("func VendorKey(unit str) str \{\n")
    each u in units {
        var h = -3750763034362895579
        each i, n in names[u] {
            h = fnv_into(h, "\u{0}" || n || "\u{0}")
            h = fnv_into(h, texts[u][i])
        }
        b.write("    if unit == \"" || u || "\" \{ return \"" ||
                fmt.sprintf("%016x", h) || "\" \}\n")
    }
    b.write("    return \"\"\n\}\n\n")
    b.write("// VendorNames lists a unit's files, flattened.\n")
    b.write("func VendorNames(unit str) []str \{\n")
    each u in units {
        b.write("    if unit == \"" || u || "\" \{\n        return [\n")
        each n in names[u] { b.write("            \"" || n || "\",\n") }
        b.write("        ]\n    \}\n")
    }
    b.write("    return []\n\}\n\n")
    b.write("// VendorCompile lists the files of a unit cc compiles.\n")
    b.write("func VendorCompile(unit str) []str \{\n")
    each u in units {
        b.write("    if unit == \"" || u || "\" \{\n        return [\n")
        each n in comp[u] { b.write("            \"" || n || "\",\n") }
        b.write("        ]\n    \}\n")
    }
    b.write("    return []\n\}\n\n")
    b.write("// VendorData returns each file's contents, in VendorNames order.\n")
    b.write("func VendorData(unit str) []str \{\n    var out = []\n")
    each u in units {
        b.write("    if unit == \"" || u || "\" \{\n")
        each t in texts[u] {
            b.write("        out.append(unb64(\"" || b64(t) || "\"))\n")
        }
        b.write("    \}\n")
    }
    b.write("    return out\n\}\n\n")
    b.write("// VendorWriteTo writes a unit's files into a directory and\n")
    b.write("// returns the paths of those cc must compile.\n")
    b.write("func VendorWriteTo(unit str, dir str) []str throws IOError \{\n")
    b.write("    let names = VendorNames(unit)\n")
    b.write("    let data = VendorData(unit)\n")
    b.write("    each i, n in names \{\n")
    b.write("        try os.write(dir || \"/\" || n, data[i])\n")
    b.write("    \}\n")
    b.write("    var out = []\n")
    b.write("    each n in VendorCompile(unit) \{ out.append(dir || \"/\" || n) \}\n")
    b.write("    return out\n\}\n")
    return b.done()
}

// keep_vendor_file says which of a vendored library's files the compiler
// carries: the C sources and headers, and the license.
func keep_vendor_file(base str) bool {
    return str.ends_with(base, ".c") or str.ends_with(base, ".h") or
           str.starts_with(base, "LICENSE")
}

// walk_files lists every regular file under dir, recursively, as paths
// relative to it, in sorted order (os.listdir sorts). os.walk would do it in
// one call, but this program runs on a bootstrap as old as MIN_BOOTSTRAP,
// whose runtime has no os.walk.
func walk_files(dir str) []str {
    var out = []
    each n in listing(dir) {
        let p = dir || "/" || n
        if os.isdir(p) {
            each sub in walk_files(p) { out.append(n || "/" || sub) }
        } else {
            out.append(n)
        }
    }
    return out
}

func last_part(p str) str {
    let i = str.last_index(p, "/")
    if i < 0 { return p }
    return p[i + 1..len(p)]
}

// fnv_into folds s into a 64-bit FNV-1a hash, 64 KiB at a time so that a
// multi-megabyte file never becomes one multi-megabyte []byte.
func fnv_into(h0 int, s str) int {
    var h = h0
    var at = 0
    let n = len(s)
    while at < n {
        var end = at + 65536
        if end > n { end = n }
        each c in bytes(s[at..end]) {
            h = h ^ c
            h = wrap_mul(h, 1099511628211)
        }
        at = end
    }
    return h
}

func listing(dir str) []str {
    match os.listdir(dir) {
        Ok(fs)  => return fs
        Err(e)  => fail("cannot read " || dir)
    }
    return []
}

// emit_c captures a compiler's C output for the compiler's own source. os.run
// inherits stdout, so the redirection goes through the shell.
//
// os.run_capture and os.mkdir_all now exist and would retire every shell-out
// in this file — but build.sh runs THIS program with a bootstrap compiler as
// old as MIN_BOOTSTRAP, whose runtime does not have them. The migration waits
// until that floor rises past the release that added them.
func emit_c(compiler str, out str) {
    let rc = os.run("bash", ["-c", compiler || " --emit=c voilac/main.voi > " || out])
    if rc != 0 {
        fail("could not emit C with " || compiler)
    }
}

// emit_c_at is emit_c with an optimization level.
func emit_c_at(compiler str, level str, out str) {
    let rc = os.run("bash", ["-c", compiler || " build " || level ||
                             " --emit=c voilac/main.voi > " || out])
    if rc != 0 {
        fail("could not emit " || level || " C with " || compiler)
    }
}

func must_run(prog str, args []str) {
    let rc = os.run(prog, args)
    if rc != 0 {
        fail(prog || " failed (exit " || str(rc) || ")")
    }
}

func sh(prog str, args []str) {
    os.run(prog, args)
}

// install replaces a binary. The unlink is not paranoia: overwriting a Mach-O
// in place leaves the kernel holding a signature computed over the OLD bytes,
// and the next exec of it dies with SIGKILL. This MUST stay unlink-then-cp:
// `cp` over the live file (rather than onto a fresh inode) would reintroduce
// that SIGKILL — including on the very binary `build.sh` bootstrapped from,
// which is why build.sh execs a copy in build/, never the install target.
func install(src str, dst str) {
    os.remove(dst)
    if os.run("cp", [src, dst]) != 0 {
        fail("cannot install " || dst)
    }
}

// install_versioned puts the compiler at `bin/voila-<version>` — the version
// read from the binary itself, so the name can never disagree with what
// `voila version` reports — and points the stable names `bin/voila` and
// `./voila` at it. Aliases are symlinks, so there is exactly one real binary.
func install_versioned(bin str) {
    let ver = compiler_version(bin)
    let versioned = "bin/voila-" || ver
    install(bin, versioned)
    ok(versioned)
    symlink("voila-" || ver, OUT)          // bin/voila  -> voila-<ver>
    ok(OUT || "  ->  voila-" || ver)
    symlink(versioned, "voila")            // ./voila    -> bin/voila-<ver>
    ok("./voila  ->  " || versioned)
    // Warm the code signature. On macOS the FIRST exec of a freshly written
    // Mach-O can be transiently SIGKILLed while the kernel validates it; force
    // that here, in the build, rather than in whatever test runs it first.
    os.run("bash", ["-c", versioned || " version >/dev/null 2>&1"])
}

// compiler_version asks the freshly built binary for its version. os.run
// inherits stdout, so the answer is captured through a shell redirection.
func compiler_version(bin str) str {
    let tmp = BUILD || "/version.txt"
    os.run("bash", ["-c", bin || " version > " || tmp])
    let f = fields(read_or(tmp, ""))
    if len(f) >= 2 { return f[1] }         // "voila 0.3.0" -> "0.3.0"
    return "unknown"
}

// symlink points `link` at `target`, replacing any existing link. os.remove
// unlinks the symlink itself, never its target.
func symlink(target str, link str) {
    os.remove(link)
    if os.run("ln", ["-s", target, link]) != 0 {
        fail("cannot symlink " || link || "  ->  " || target)
    }
}

func read_or(p str, dflt str) str {
    match os.read(p) {
        Ok(s)  => return s
        Err(e) => return dflt
    }
    return dflt
}

func write_or_die(p str, text str) {
    match os.write(p, text) {
        Ok(u)  => u
        Err(e) => fail("cannot write " || p)
    }
}

func head(s str) { fmt.printf("\u{1b}[1m==> %s\u{1b}[0m\n", s) }
func ok(s str)   { fmt.printf("\u{1b}[32m  ✓ %s\u{1b}[0m\n", s) }
func warn(s str) { fmt.printf("\u{1b}[33m  ! %s\u{1b}[0m\n", s) }

func fail(s str) {
    fmt.eprintf("\u{1b}[1;31m  ✗ %s\u{1b}[0m\n", s)
    os.exit(1)
}
