// par/stmt.voi — statements.
package par

use "voilac/tok"
use "voilac/ast"
use "std/str"

impl Parser {
    func block(mut self) int {
        let t = self.expect(tok.LBRACE)
        // A block resets the bracket depth: inside it a composite literal is
        // once again ambiguous with the block brace (§15, and the Go parser).
        let saved = self.lev
        self.lev = 0
        // A comma ends a one-statement match arm, never a statement inside a
        // nested block (a closure written in such an arm, say).
        let savedArm = self.armComma
        self.armComma = 0
        // Inside braces a composite literal is unambiguous again even when
        // the block sits in a statement header (an `if` expression's
        // branch, a closure body): the header's restriction ends here.
        let savedLit = self.noLit
        self.noLit = 0
        var ss = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            ss.append(self.stmt())
        }
        self.expect(tok.RBRACE)
        self.lev = saved
        self.armComma = savedArm
        self.noLit = savedLit
        return self.add(ast.BLOCK, t, 0, 0, "", ss)
    }

    func stmt(mut self) int {
        let t = self.cur()
        let k = t.Kind

        if k == tok.LET or k == tok.CONST { return self.let_stmt() }
        if k == tok.VAR                   { return self.var_stmt() }
        if k == tok.IF                    { return self.if_stmt() }
        if k == tok.FOR or k == tok.EACH or k == tok.WHILE {
            return self.loop_stmt("")
        }
        if k == tok.IDENT {
            // A label: `outer: for …`.
            if self.peek(1).Kind == tok.COLON {
                let k2 = self.peek(2).Kind
                if k2 == tok.FOR or k2 == tok.EACH or k2 == tok.WHILE {
                    let label = self.next().Lit
                    self.next()
                    return self.loop_stmt(label)
                }
            }
            if t.Lit == "fallthrough" and (self.peek(1).Kind == tok.SEMI or
                                           self.peek(1).Kind == tok.RBRACE) {
                self.next()
                self.expect_semi()
                return self.add(ast.FALLTHROUGH, t, 0, 0, "", [])
            }
            return self.simple_stmt()
        }
        if k == tok.SWITCH { return self.switch_stmt() }
        if k == tok.MATCH  { return self.match_stmt() }
        if k == tok.SELECT { return self.select_stmt() }
        if k == tok.GROUP  { return self.group_stmt(0) }
        if k == tok.PARSE  { return self.parse_stmt() }
        if k == tok.SAY    { return self.say_stmt() }
        if k == tok.DEFER  { return self.defer_stmt() }

        if k == tok.DROP {
            self.next()
            let n = self.expect(tok.IDENT)
            self.expect_semi()
            return self.add(ast.DROP, t, 0, 0, n.Lit, [])
        }
        if k == tok.RETURN {
            self.next()
            var vs = []
            if not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
               not self.at(tok.EOF) {
                vs.append(self.expr())
                while self.list_comma() { vs.append(self.expr()) }
            }
            self.expect_semi()
            return self.add(ast.RETURN, t, 0, 0, "", vs)
        }
        if k == tok.BREAK or k == tok.CONTINUE {
            self.next()
            var label = ""
            if self.at(tok.IDENT) { label = self.next().Lit }
            self.expect_semi()
            var kind = ast.BREAK
            if k == tok.CONTINUE { kind = ast.CONTINUE }
            return self.add(kind, t, 0, 0, label, [])
        }
        if k == tok.NUMERIC {
            self.next()
            let w = self.expect(tok.IDENT)
            if w.Lit != "digits" { self.error("expected `digits` after `numeric`") }
            let n = self.expect(tok.INT)
            // A malformed or missing count is 0, as the Go parser's discarded
            // Atoi error leaves it — the checker rejects it, but the parser
            // must keep recovering rather than throw.
            let d = atoi(n.Lit)
            self.expect_semi()
            return self.add(ast.NUMERIC, t, d, 0, "", [])
        }
        if k == tok.THROW {
            self.next()
            var v = 0
            var from = 0
            if not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
               not self.at(tok.EOF) {
                v = self.expr()
                if self.at(tok.IDENT) and self.cur().Lit == "from" {
                    self.next()
                    from = self.expr()
                }
            }
            self.expect_semi()
            return self.add(ast.THROW, t, 0, 0, "", [v, from])
        }
        if k == tok.TRY {
            // Three-way: `try {` → try/catch, `try group` → try-group, else expr.
            let k1 = self.peek(1).Kind
            if k1 == tok.LBRACE { return self.trycatch_stmt() }
            if k1 == tok.GROUP {
                self.next()
                return self.group_stmt(1)
            }
            return self.simple_stmt()
        }
        if k == tok.LBRACE { return self.block() }
        return self.simple_stmt()
    }

    func let_stmt(mut self) int {
        let t = self.cur()
        var isConst = 0
        if t.Kind == tok.CONST { isConst = 1 }
        self.next()
        // `let (a, b) = t` is the parenthesised spelling of `let a, b = t`:
        // both destructure a tuple into one binding per name.
        if self.at(tok.LPAREN) {
            let names = self.paren_names()
            self.expect(tok.ASSIGN)
            let v = self.expr()
            self.expect_semi()
            return self.add(ast.LET, t, 0, isConst, str.join(names, ","), [v])
        }
        var names = [self.expect(tok.IDENT).Lit]
        while self.accept(tok.COMMA) {
            names.append(self.expect(tok.IDENT).Lit)
        }
        var ty = 0
        if not self.at(tok.ASSIGN) { ty = self.type_expr() }
        self.expect(tok.ASSIGN)
        let v = self.expr()
        self.expect_semi()
        return self.add(ast.LET, t, ty, isConst, str.join(names, ","), [v])
    }

    // list_comma consumes the comma between two values of a `say` or
    // `return` list — unless that statement is a one-statement match arm
    // and the comma is the one ENDING it: `1 => say "a", 2 => say "b"`.
    // The arm's comma is told apart by what follows it, another arm, i.e.
    // a `=>` before the next comma or the end of the statement, at bracket
    // depth 0. A value cannot contain a bare `=>`, so nothing that parsed
    // before is lost.
    func list_comma(mut self) bool {
        if not self.at(tok.COMMA) { return false }
        if self.armComma > 0 and self.arm_ahead() { return false }
        self.next()
        return true
    }

    func arm_ahead(self) bool {
        var j = self.i + 1
        var depth = 0
        while j < len(self.ts) {
            let k = self.ts[j].Kind
            if k == tok.LPAREN or k == tok.LBRACKET or k == tok.LBRACE {
                depth += 1
            } else if k == tok.RPAREN or k == tok.RBRACKET or
                      k == tok.RBRACE {
                if depth == 0 { return false }
                depth -= 1
            } else if depth == 0 {
                if k == tok.FATARROW { return true }
                // Another comma first: this one separates two values, and
                // the later comma is the one that may end the arm.
                if k == tok.COMMA or k == tok.SEMI or k == tok.EOF {
                    return false
                }
            }
            j += 1
        }
        return false
    }

    // paren_names reads `(a, b, …)` — the names of a destructuring binding.
    func paren_names(mut self) []str {
        self.expect(tok.LPAREN)
        var names = []
        while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
            names.append(self.expect(tok.IDENT).Lit)
            if not self.accept(tok.COMMA) { break }
        }
        self.expect(tok.RPAREN)
        if len(names) < 2 {
            self.error("a destructuring binding needs at least two names")
        }
        return names
    }

    func var_stmt(mut self) int {
        let t = self.expect(tok.VAR)
        if self.at(tok.LPAREN) {
            // `var (a, b) = f()`: a destructuring LET whose names are
            // MUTABLE (Ival2 = 2), so it shares the LET lowering and every
            // checker that already splits a LET's comma-joined names.
            let names = self.paren_names()
            self.expect(tok.ASSIGN)
            let v = self.expr()
            self.expect_semi()
            return self.add(ast.LET, t, 0, 2, str.join(names, ","), [v])
        }
        let n = self.expect(tok.IDENT)
        var ty = 0
        if not self.at(tok.ASSIGN) and not self.at(tok.SEMI) and
           not self.at(tok.RBRACE) and not self.at(tok.EOF) {
            ty = self.type_expr()
        }
        var v = 0
        if self.accept(tok.ASSIGN) { v = self.expr() }
        self.expect_semi()
        return self.add(ast.VAR, t, ty, 0, n.Lit, [v])
    }

    func simple_stmt(mut self) int {
        let t = self.cur()
        var x = self.expr()
        if self.at(tok.COMMA) and (self.armComma == 0 or not self.arm_ahead()) {
            // Parallel assignment, `a, b = b, a`: the targets become one
            // TUPLE, and so do several values. The lowerer evaluates every
            // value before it writes any target. (Inside a one-statement
            // match arm a comma followed by the next arm ends the arm
            // instead; see list_comma.)
            var targets = [x]
            while self.accept(tok.COMMA) { targets.append(self.expr()) }
            let at = self.cur()
            self.expect(tok.ASSIGN)
            var vals = [self.expr()]
            while self.list_comma() { vals.append(self.expr()) }
            var rhs = vals[0]
            if len(vals) > 1 {
                rhs = self.add(ast.TUPLE, at, 0, 0, "", vals)
            }
            self.expect_semi()
            let lhs = self.add(ast.TUPLE, t, 0, 0, "", targets)
            return self.add(ast.ASSIGN, t, tok.ASSIGN, 0, "", [lhs, rhs])
        }
        let k = self.cur().Kind
        if k == tok.ASSIGN or k == tok.PLUSEQ or k == tok.MINUSEQ or
           k == tok.STAREQ or k == tok.SLASHEQ or k == tok.PERCENTEQ or
           k == tok.CONCATEQ {
            let op = self.next().Kind
            let rhs = self.expr()
            self.expect_semi()
            return self.add(ast.ASSIGN, t, op, 0, "", [x, rhs])
        }
        if k == tok.ARROW {
            // A channel send: `ch <- v`.
            self.next()
            let v = self.expr()
            self.expect_semi()
            let send = self.add(ast.BINARY, t, tok.ARROW, 0, "", [x, v])
            return self.add(ast.EXPRSTMT, t, 0, 0, "", [send])
        }
        self.expect_semi()
        return self.add(ast.EXPRSTMT, t, 0, 0, "", [x])
    }

    func if_stmt(mut self) int {
        let t = self.expect(tok.IF)
        var cond = 0
        var pat = 0
        if self.at(tok.LET) {
            self.next()
            pat = self.pattern()
            self.expect(tok.ASSIGN)
            cond = self.header_expr()
        } else {
            cond = self.header_expr()
        }
        let then = self.block()
        var els = 0
        if self.skip_semis_before(tok.ELSE) {
            self.next()
            if self.at(tok.IF) {
                els = self.if_stmt()
            } else {
                els = self.block()
            }
        }
        return self.add(ast.IF, t, pat, 0, "", [cond, then, els])
    }

    // header_expr parses a condition or iterable, where a composite literal
    // must be parenthesised (otherwise `if x > 10 {` is ambiguous).
    func header_expr(mut self) int {
        // The bracket depth is cleared as well: an `if` or `match` used as a
        // VALUE may sit inside `(…)`, `[…]` or a call, and its header is
        // still a header — `f(if ok { 1 } else { 2 })` must not read
        // `ok { 1 }` as a composite literal. Brackets opened inside the
        // header raise the depth again as usual.
        let saved = self.noLit
        let savedLev = self.lev
        self.noLit = 1
        self.lev = 0
        let e = self.expr()
        self.noLit = saved
        self.lev = savedLev
        return e
    }

    func loop_stmt(mut self, label str) int {
        let t = self.cur()
        let k = t.Kind
        if k == tok.FOR {
            self.next()
            var v = ""
            var iter = 0
            if not self.at(tok.LBRACE) {
                v = self.expect(tok.IDENT).Lit
                self.expect(tok.IN)
                iter = self.header_expr()
            }
            let body = self.block()
            return self.add(ast.FOR, t, 0, 0, v || "|" || label, [iter, body])
        }
        if k == tok.EACH {
            self.next()
            var a = self.expect(tok.IDENT).Lit
            var b = ""
            if self.accept(tok.COMMA) { b = self.expect(tok.IDENT).Lit }
            self.expect(tok.IN)
            let iter = self.header_expr()
            let body = self.block()
            return self.add(ast.EACH, t, 0, 0, a || "," || b || "|" || label,
                            [iter, body])
        }
        if k == tok.WHILE {
            self.next()
            let cond = self.header_expr()
            let body = self.block()
            return self.add(ast.WHILE, t, 0, 0, label, [cond, body])
        }
        self.error("expected loop after label")
        return self.add(ast.BLOCK, t, 0, 0, "", [])
    }

    func switch_stmt(mut self) int {
        let t = self.expect(tok.SWITCH)
        let subj = self.header_expr()
        self.expect(tok.LBRACE)
        var cases = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            let ct = self.cur()
            var vals = []
            if self.accept(tok.CASE) {
                vals.append(self.expr())
                while self.accept(tok.COMMA) { vals.append(self.expr()) }
                self.expect(tok.COLON)
            } else if self.at(tok.IDENT) and self.cur().Lit == "default" {
                self.next()
                self.expect(tok.COLON)
            } else {
                self.error("expected `case` or `default` in switch")
                self.next()
                continue
            }
            var body = []
            while true {
                self.skip_semis()
                if self.at(tok.CASE) or self.at(tok.RBRACE) or self.at(tok.EOF) {
                    break
                }
                if self.at(tok.IDENT) and self.cur().Lit == "default" and
                   self.peek(1).Kind == tok.COLON {
                    break
                }
                body.append(self.stmt())
            }
            cases.append(self.add(ast.CASE, ct, 0, 0, "",
                                  [self.T.List(vals), self.T.List(body)]))
        }
        self.expect(tok.RBRACE)
        return self.add(ast.SWITCH, t, 0, 0, "", [subj, self.T.List(cases)])
    }

    func match_stmt(mut self) int {
        let t = self.expect(tok.MATCH)
        let subj = self.header_expr()
        self.expect(tok.LBRACE)
        // The arms are a fresh context, like a block's statements: neither
        // the brackets around a match EXPRESSION nor the header it may sit
        // in reach into them.
        let savedLev = self.lev
        let savedLit = self.noLit
        self.lev = 0
        self.noLit = 0
        var arms = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            let at2 = self.cur()
            let pat = self.pattern()
            var guard = 0
            if self.at(tok.IF) {
                self.next()
                let saved = self.noLit
                self.noLit = 1
                guard = self.expr()
                self.noLit = saved
            }
            self.expect(tok.FATARROW)
            var body = []
            if self.at(tok.LBRACE) {
                let b = self.block()
                // COPY the block's kids — never alias them. Two nodes sharing
                // one Kids slice breaks the arena invariant Graft relies on
                // (it relocates kids in place; a shared slice would be
                // relocated once per owner).
                each s in self.T.Get(b).Kids {
                    body.append(s)
                }
                self.accept(tok.COMMA)
            } else {
                // A one-statement arm may end in a comma as well as a
                // newline or `;` (`A => 1, B => 2`); armComma lets
                // expect_semi take it, for this one statement only.
                let savedArm = self.armComma
                self.armComma = 1
                body.append(self.stmt())
                self.armComma = savedArm
                // A statement that ends in a block (`if`, `match`, `each`)
                // never reaches expect_semi, so its comma is taken here.
                self.accept(tok.COMMA)
            }
            arms.append(self.add(ast.ARM, at2, pat, 0, "",
                                 [guard, self.T.List(body)]))
        }
        self.lev = savedLev
        self.noLit = savedLit
        self.expect(tok.RBRACE)
        return self.add(ast.MATCH, t, 0, 0, "", [subj, self.T.List(arms)])
    }

    // pattern parses one arm pattern: alternatives separated by `|` (POR),
    // each of which is a single pattern_one.
    func pattern(mut self) int {
        let t = self.cur()
        let first = self.pattern_one()
        if not self.at(tok.PIPE) { return first }
        var alts = [first]
        while self.accept(tok.PIPE) {
            alts.append(self.pattern_one())
        }
        return self.add(ast.POR, t, 0, 0, "", alts)
    }

    // pattern_lit parses a literal pattern operand: a basic literal, or a
    // negated number.
    func pattern_lit(mut self) int {
        if self.at(tok.MINUS) { return self.unary() }
        return self.primary()
    }

    func pattern_one(mut self) int {
        let t = self.cur()
        let k = t.Kind
        if k == tok.NIL {
            self.next()
            return self.add(ast.PNIL, t, 0, 0, "", [])
        }
        if k == tok.TRUE or k == tok.FALSE or k == tok.INT or k == tok.FLOAT or
           k == tok.DEC or k == tok.STR or k == tok.RUNE or k == tok.MINUS {
            let lo = self.pattern_lit()
            if self.at(tok.RANGE) or self.at(tok.RANGEEQ) {
                // `0..=9`, `'a'..='z'`: a RANGE pattern, both bounds literal.
                var inc = 0
                if self.next().Kind == tok.RANGEEQ { inc = 1 }
                let hi = self.pattern_lit()
                return self.add(ast.PRANGE, t, 0, inc, "", [lo, hi])
            }
            return self.add(ast.PLIT, t, 0, 0, "", [lo])
        }
        if k == tok.LPAREN {
            // `(0, y)`: a TUPLE pattern. One pattern in parentheses with no
            // trailing comma is just grouping — `(1 | 2)`.
            self.next()
            var subs = []
            var comma = false
            while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
                subs.append(self.pattern())
                if not self.accept(tok.COMMA) { break }
                comma = true
            }
            self.expect(tok.RPAREN)
            if len(subs) == 1 and not comma { return subs[0] }
            return self.add(ast.PTUPLE, t, 0, 0, "", subs)
        }
        if k == tok.IDENT {
            var name = self.next().Lit
            if name == "_" { return self.add(ast.PWILD, t, 0, 0, "", []) }
            // A DOTTED name is a package-qualified variant — `geom.Circle`.
            // Variant names are qualified like every other declaration, so a
            // pattern must be able to spell the qualifier; a name that got
            // here with a dot in it can only be a variant, never a binding.
            var dotted = false
            while self.at(tok.DOT) {
                self.next()
                name = name || "." || self.expect(tok.IDENT).Lit
                dotted = true
            }
            if self.at(tok.LPAREN) {
                self.next()
                var subs = []
                while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
                    subs.append(self.pattern())
                    if not self.accept(tok.COMMA) { break }
                }
                self.expect(tok.RPAREN)
                return self.add(ast.PVARIANT, t, 0, 0, name, subs)
            }
            if self.at(tok.LBRACE) {
                // `Self{x: 0}` in an impl block names the target type.
                if name == "Self" and self.selfName != "" {
                    name = self.selfName
                }
                return self.struct_pattern(t, name)
            }
            // A capitalised bare name is a payload-less variant; lowercase
            // binds. A dotted name is a variant whatever its case: a binding
            // has no qualifier to spell.
            if dotted or is_upper_first(name) {
                return self.add(ast.PVARIANT, t, 0, 0, name, [])
            }
            return self.add(ast.PBIND, t, 0, 0, name, [])
        }
        self.error("expected pattern, found {self.show()}")
        self.next()
        return self.add(ast.PWILD, t, 0, 0, "", [])
    }

    // struct_pattern parses `P{x: 0, y}` after the type name: each field
    // is `name: pattern`, or a bare `name`, which binds the field to a
    // variable of the same name. A trailing `..` is accepted and means what
    // leaving the field out means anyway: the rest are not examined.
    func struct_pattern(mut self, t tok.Token, name str) int {
        self.expect(tok.LBRACE)
        var fs = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            if self.accept(tok.RANGE) {
                self.skip_semis()
                break
            }
            let ft = self.expect(tok.IDENT)
            var sub = 0
            if self.accept(tok.COLON) {
                sub = self.pattern()
            } else {
                sub = self.add(ast.PBIND, ft, 0, 0, ft.Lit, [])
            }
            fs.append(self.add(ast.PFIELD, ft, 0, 0, ft.Lit, [sub]))
            if not self.accept(tok.COMMA) {
                self.skip_semis()
                break
            }
        }
        self.expect(tok.RBRACE)
        return self.add(ast.PSTRUCT, t, 0, 0, name, fs)
    }

    func select_stmt(mut self) int {
        let t = self.expect(tok.SELECT)
        self.expect(tok.LBRACE)
        var cases = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            let ct = self.cur()
            var kind = 0
            var ch = 0
            var send = 0
            var bind = ""
            var bindok = ""
            if self.accept(tok.CASE) {
                if self.at(tok.LET) {
                    self.next()
                    bind = self.expect(tok.IDENT).Lit
                    if self.accept(tok.COMMA) {
                        bindok = self.expect(tok.IDENT).Lit
                    }
                    self.expect(tok.ASSIGN)
                    self.expect(tok.ARROW)
                    ch = self.expr()
                } else if self.at(tok.IDENT) and self.peek(1).Kind == tok.DEFINE {
                    bind = self.next().Lit
                    self.next()
                    self.expect(tok.ARROW)
                    ch = self.expr()
                } else if self.at(tok.IDENT) and self.peek(1).Kind == tok.COMMA and
                          self.peek(2).Kind == tok.IDENT and
                          self.peek(3).Kind == tok.DEFINE {
                    bind = self.next().Lit
                    self.next()
                    bindok = self.next().Lit
                    self.next()
                    self.expect(tok.ARROW)
                    ch = self.expr()
                } else if self.at(tok.ARROW) {
                    self.next()
                    ch = self.expr()
                } else {
                    kind = 1
                    ch = self.expr()
                    self.expect(tok.ARROW)
                    send = self.expr()
                }
                self.expect(tok.COLON)
            } else if self.at(tok.IDENT) and self.cur().Lit == "default" {
                self.next()
                self.expect(tok.COLON)
                kind = 2
            } else {
                self.error("expected `case` or `default` in select")
                self.next()
                continue
            }
            var body = []
            while true {
                self.skip_semis()
                if self.at(tok.CASE) or self.at(tok.RBRACE) or self.at(tok.EOF) {
                    break
                }
                if self.at(tok.IDENT) and self.cur().Lit == "default" and
                   self.peek(1).Kind == tok.COLON {
                    break
                }
                body.append(self.stmt())
            }
            cases.append(self.add(ast.SELCASE, ct, kind, 0,
                                  bind || "," || bindok,
                                  [ch, send, self.T.List(body)]))
        }
        self.expect(tok.RBRACE)
        return self.add(ast.SELECTSTMT, t, 0, 0, "", [self.T.List(cases)])
    }

    func group_stmt(mut self, isTry int) int {
        let t = self.expect(tok.GROUP)
        var timeout = 0
        if self.at(tok.IDENT) and self.cur().Lit == "timeout" {
            self.next()
            timeout = self.header_expr()
        }
        let body = self.block()
        return self.add(ast.GROUP, t, 0, isTry, "", [timeout, body])
    }

    func parse_stmt(mut self) int {
        let t = self.expect(tok.PARSE)
        var fold = ""
        if self.at(tok.IDENT) and (self.cur().Lit == "upper" or
                                   self.cur().Lit == "lower") {
            fold = self.next().Lit
        }
        self.accept(tok.VAR)
        let src = self.parse_source()
        var terms = []
        while not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
              not self.at(tok.EOF) {
            let tt = self.cur()
            if self.at(tok.IDENT) {
                let n = self.next()
                terms.append(self.add(ast.PARSETERM, tt, 0, 0, n.Lit, []))
            } else if self.at(tok.DOT) {
                self.next()
                terms.append(self.add(ast.PARSETERM, tt, 1, 0, "", []))
            } else if self.at(tok.STR) {
                let s = self.next()
                terms.append(self.add(ast.PARSETERM, tt, 2, 0, s.Lit, []))
            } else if self.at(tok.INT) {
                let n = self.next()
                terms.append(self.add(ast.PARSETERM, tt, 3, atoi(n.Lit), "",
                                      []))
            } else {
                self.error("unexpected token in parse template")
                self.next()
            }
        }
        self.expect_semi()
        return self.add(ast.PARSESTMT, t, 0, 0, fold, [src, self.T.List(terms)])
    }

    // parse_source: postfix chains limited to calls and indexing, so the
    // template terms that follow are not swallowed.
    func parse_source(mut self) int {
        var x = self.primary()
        while true {
            if self.at(tok.LPAREN) {
                x = self.call_tail(x)
            } else if self.at(tok.LBRACKET) {
                x = self.index_tail(x)
            } else {
                return x
            }
        }
        return x
    }

    func say_stmt(mut self) int {
        let t = self.expect(tok.SAY)
        var args = []
        if not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
           not self.at(tok.EOF) {
            args.append(self.expr())
            while self.list_comma() { args.append(self.expr()) }
        }
        self.expect_semi()
        return self.add(ast.SAY, t, 0, 0, "", args)
    }

    func defer_stmt(mut self) int {
        let t = self.expect(tok.DEFER)
        if self.at(tok.LBRACE) {
            return self.add(ast.DEFERSTMT, t, 0, 1, "", [self.block()])
        }
        if self.at(tok.SAY) {
            // The grammar says call|block, but `defer say "…"` is too natural
            // to reject; it becomes a one-statement block.
            let s = self.say_stmt()
            let b = self.add(ast.BLOCK, t, 0, 0, "", [s])
            return self.add(ast.DEFERSTMT, t, 0, 1, "", [b])
        }
        let c = self.expr()
        self.expect_semi()
        return self.add(ast.DEFERSTMT, t, 0, 0, "", [c])
    }

    func trycatch_stmt(mut self) int {
        let t = self.expect(tok.TRY)
        let body = self.block()
        var catches = []
        while self.skip_semis_before(tok.CATCH) {
            let ct = self.next()
            var name = ""
            var types = []
            if self.at(tok.IDENT) {
                name = self.next().Lit
                if self.accept(tok.COLON) {
                    types.append(self.type_expr())
                    while self.accept(tok.COMMA) {
                        types.append(self.type_expr())
                    }
                }
            }
            let cb = self.block()
            catches.append(self.add(ast.CATCH, ct, 0, 0, name,
                                    [cb, self.T.List(types)]))
        }
        var fin = 0
        if self.skip_semis_before(tok.FINALLY) {
            self.next()
            fin = self.block()
        }
        self.expect_semi()
        return self.add(ast.TRYCATCH, t, 0, 0, "",
                        [body, self.T.List(catches), fin])
    }
}

// atoi parses a decimal count, yielding 0 on anything it cannot read. The
// throwing `int(s)` would kill the parser on `numeric digits` with no operand.
func atoi(s str) int {
    let v = to_int(s)
    if v == nil { return 0 }
    return v
}

func is_upper_first(s str) bool {
    if len(s) == 0 { return false }
    let c = s[0]
    return c >= 65 and c <= 90
}
