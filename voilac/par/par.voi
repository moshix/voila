// Package par — the Voilà parser, in Voilà.
//
// A faithful port of the stage-0 parser: recursive descent for declarations
// and statements (§15), precedence climbing for expressions (§5.1). It builds
// into the node arena of package ast. A differential test diffs its tree dump
// against the Go parser's over every source in the repository.
package par

use "voilac/tok"
use "voilac/ast"
use "voilac/lex"
use "std/str"

// Precedence levels (§5.1, scaled; `else` and ranges wedged in as the
// stage-0 parser does).
const P_ELSE   = 10
const P_OR     = 20
const P_AND    = 30
const P_CMP    = 40
const P_RANGE  = 45
const P_CONCAT = 50
const P_BITS   = 60
const P_ADD    = 70
const P_MUL    = 80
const P_POW    = 90

struct Parser {
    ts    []tok.Token
    ip    []tok.IstrParts   // interpolated-string payloads (Token.Ref - 1)
    i     int
    file  str
    T     ast.Tree
    Errs  []str
    noLit int   // >0 inside a statement header: a composite literal needs parens
    lev   int   // >0 inside brackets, where a composite literal is fine again
    selfFlags int // set by params() when the receiver is `self`
    armComma  int // >0 while a one-statement match arm is parsed: a `,`
                  // may end it (see match_stmt)
    // `Self` inside an impl block is the implementing type (§3.6). While
    // the block's methods are parsed, selfTy is its TARGET type node and
    // selfName that type's name as written (`Point`, `geom.Point`); both are
    // empty elsewhere — in a trait, `Self` stays `Self`, a placeholder the
    // checker and lowerer understand.
    selfTy    int
    selfName  str
}

func New(file str, src str) Parser { return NewAt(file, src, 1, 1) }

// NewAt parses a fragment that begins at a known position — an interpolated
// string's embedded expression, whose diagnostics must name the real column.
func NewAt(file str, src str, line int, col int) Parser {
    var lx = lex.NewAt(file, src, line, col)
    let ts = lx.Tokens()
    var p = Parser{ts: ts, ip: lx.IParts, i: 0, file: file,
                   T: ast.NewTree(), Errs: lx.Errs,
                   noLit: 0, lev: 0, selfFlags: 0, armComma: 0,
                   selfTy: 0, selfName: ""}
    return p
}

impl Parser {
    // ------------------------------------------------------------ plumbing

    func cur(self) tok.Token { return self.ts[self.i] }

    func peek(self, n int) tok.Token {
        if self.i + n >= len(self.ts) { return self.ts[len(self.ts) - 1] }
        return self.ts[self.i + n]
    }

    func at(self, k int) bool { return self.cur().Kind == k }

    func next(mut self) tok.Token {
        let t = self.ts[self.i]
        if self.i < len(self.ts) - 1 { self.i += 1 }
        return t
    }

    func accept(mut self, k int) bool {
        if self.at(k) {
            self.next()
            return true
        }
        return false
    }

    func error(mut self, msg str) {
        let t = self.cur()
        self.Errs.append("{self.file}:{t.Line}:{t.Col}: {msg}")
    }

    func expect(mut self, k int) tok.Token {
        if self.at(k) { return self.next() }
        self.error("expected {tok.Spelling(k)}, found {self.show()}")
        return tok.Token{Kind: k, Lit: "", Line: self.cur().Line,
                         Col: self.cur().Col, Ref: 0, Virtual: false}
    }

    func show(self) str {
        let t = self.cur()
        let n = tok.Name(t.Kind)
        if n == "IDENT" or n == "KW" or n == "INT" { return "{n}({t.Lit})" }
        if n == "OP" { return tok.Spelling(t.Kind) }
        return n
    }

    func skip_semis(mut self) {
        while self.at(tok.SEMI) { self.next() }
    }

    // skip_semis_before consumes virtual semicolons when the given keyword
    // follows — `else`, `catch` and `finally` on the next line (§2.3).
    func skip_semis_before(mut self, k int) bool {
        var j = self.i
        while self.ts[j].Kind == tok.SEMI { j += 1 }
        if self.ts[j].Kind == k {
            self.i = j
            return true
        }
        return false
    }

    func expect_semi(mut self) {
        if self.at(tok.SEMI) {
            self.skip_semis()
            return
        }
        if self.armComma > 0 and self.at(tok.COMMA) {
            self.next()
            self.skip_semis()
            return
        }
        if self.at(tok.RBRACE) or self.at(tok.EOF) { return }
        self.error("expected end of statement, found {self.show()}")
        while not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
              not self.at(tok.EOF) {
            self.next()
        }
        self.skip_semis()
    }

    func add(mut self, kind int, t tok.Token, ival int, ival2 int, sval str,
             kids []int) int {
        return self.T.Add(kind, t.Line, t.Col, ival, ival2, sval, kids)
    }

    // ------------------------------------------------------------ file

    func File(mut self) int {
        let start = self.cur()
        var uses = []
        var decls = []
        var script = []

        var pkg = ""
        self.skip_semis()
        if self.at(tok.PACKAGE) {
            self.next()
            pkg = self.expect(tok.IDENT).Lit
            self.expect_semi()
        }
        self.skip_semis()
        while not self.at(tok.EOF) {
            self.skip_semis()
            if self.at(tok.EOF) { break }
            if self.at(tok.USE) {
                uses.append(self.use_decl())
            } else if self.at(tok.IDENT) and self.cur().Lit == "ffi" and
                      self.peek(1).Kind == tok.STR {
                // `ffi "C" { … }` (§12): `ffi` is contextual, a block only
                // when a string follows it at the top level of a file.
                each d in self.ffi_block() { decls.append(d) }
            } else if self.decl_start() {
                decls.append(self.decl())
            } else if self.at(tok.CONST) or self.at(tok.LET) or self.at(tok.VAR) {
                let here = self.cur()
                let s = self.stmt()
                decls.append(self.add(ast.GLOBAL, here, 0, 0, "", [s]))
            } else {
                script.append(self.stmt())
            }
            self.skip_semis()
        }
        // An ffi block's pointer type is std/ffi's Ptr, so the block needs
        // the package; saying so here names the cause instead of leaving an
        // unknown type `ffi.Ptr` for the reader to decode.
        var ffiAt = 0
        each d in decls {
            if ffiAt == 0 and self.T.Kind(d) == ast.FFIDEC { ffiAt = d }
        }
        if ffiAt != 0 {
            var have = false
            each u in uses {
                if str.split(self.T.Get(u).Sval, "|")[0] == "std/ffi" {
                    have = true
                }
            }
            if not have {
                let fd = self.T.Get(ffiAt)
                self.Errs.append("{self.file}:{fd.Line}:{fd.Col}: an `ffi` " ||
                                 "block needs `use \"std/ffi\"` (§12)")
            }
        }
        let lu = self.T.List(uses)
        let ld = self.T.List(decls)
        let ls = self.T.List(script)
        return self.add(ast.FILE, start, 0, 0, pkg, [lu, ld, ls])
    }

    func decl_start(self) bool {
        let k = self.cur().Kind
        return k == tok.FUNC or k == tok.STRUCT or k == tok.ENUM or
               k == tok.TRAIT or k == tok.IMPL or k == tok.EXCEPTION or
               k == tok.TYPE
    }

    func use_decl(mut self) int {
        let t = self.expect(tok.USE)
        let path = self.expect(tok.STR)
        var alias = ""
        var flags = 0
        var names = []
        if self.accept(tok.AS) {
            alias = self.expect(tok.IDENT).Lit
        } else if self.at(tok.LBRACE) {
            self.next()
            while not self.at(tok.RBRACE) and not self.at(tok.EOF) {
                let n = self.expect(tok.IDENT)
                names.append(self.add(ast.IDENT, n, 0, 0, n.Lit, []))
                if not self.accept(tok.COMMA) { break }
            }
            self.expect(tok.RBRACE)
            if len(names) > 0 { flags = 1 }
        } else if self.at(tok.STAR) {
            self.next()
            flags = 2
        }
        self.expect_semi()
        return self.add(ast.USE, t, 0, flags, path.Lit || "|" || alias, names)
    }

    // ------------------------------------------------------------ declarations

    func decl(mut self) int {
        let k = self.cur().Kind
        if k == tok.FUNC      { return self.func_decl() }
        if k == tok.STRUCT    { return self.struct_decl() }
        if k == tok.ENUM      { return self.enum_decl() }
        if k == tok.TRAIT     { return self.trait_decl() }
        if k == tok.IMPL      { return self.impl_decl() }
        if k == tok.EXCEPTION { return self.exception_decl() }
        if k == tok.TYPE      { return self.type_decl() }
        self.error("expected declaration, found {self.show()}")
        self.next()
        return 0
    }

    func generics(mut self) int {
        var gs = []
        if not self.at(tok.LBRACKET) { return self.T.List(gs) }
        self.next()
        while not self.at(tok.RBRACKET) and not self.at(tok.EOF) {
            let n = self.expect(tok.IDENT)
            var bounds = []
            if self.accept(tok.COLON) { bounds = self.bound_list() }
            gs.append(self.add(ast.GENERIC, n, 0, 0,
                               n.Lit || "|" || self.bound_names(bounds),
                               bounds))
            if not self.accept(tok.COMMA) { break }
        }
        self.expect(tok.RBRACKET)
        return self.T.List(gs)
    }

    // bound_list parses the bounds after `T:` — one trait or several joined
    // by `+` (`Show + Into[str]`). Each is read by the TYPE grammar, so a
    // qualified `geom.Named` and a generic trait's arguments both parse, and
    // each must come out as a plain TNAMED: a bound names a trait, never a
    // slice or an option. The nodes become the GENERIC's Kids; the loader
    // flattens their names exactly as it does any other type's.
    func bound_list(mut self) []int {
        var bs = []
        while true {
            let b = self.type_expr()
            if self.T.Kind(b) != ast.TNAMED {
                self.error("a bound names a trait, such as `Show` or " ||
                           "`Into[str]` (§3.7)")
            }
            bs.append(b)
            if not self.accept(tok.PLUS) { break }
        }
        return bs
    }

    // bound_names spells a bound list the way GENERIC.Sval carries it after
    // the `|`: the trait NAMES joined by `+`, type arguments left in the
    // Kids. Every consumer that only asks "which traits" reads this string.
    func bound_names(self, bounds []int) str {
        var ns = []
        each b in bounds {
            ns.append(self.T.Get(b).Sval)
        }
        return str.join(ns, "+")
    }

    // at_where reports whether a `where` clause starts here. `where` is
    // reserved by §2.5 but has always lexed as an identifier, and the corpus
    // (the compiler included) uses it as one, so it is CONTEXTUAL: it opens a
    // clause only where a declaration's body or end is expected and only as
    // `where NAME :`. A clause may begin on the next line, so virtual
    // semicolons in front of it are looked through.
    func at_where(self) bool {
        var j = self.i
        while j < len(self.ts) - 1 and self.ts[j].Kind == tok.SEMI { j += 1 }
        if j + 2 >= len(self.ts) { return false }
        return self.ts[j].Kind == tok.IDENT and self.ts[j].Lit == "where" and
               self.ts[j + 1].Kind == tok.IDENT and
               self.ts[j + 2].Kind == tok.COLON
    }

    // where_clause folds `where T: A + B, U: C` into the generic list `gens`
    // that the declaration already parsed, so nothing downstream can tell a
    // where-bound from an inline one: `[T: A] … where T: B` is `[T: A + B]`.
    // A name that is not one of the list's own parameters is refused — there
    // would be nothing for the bound to constrain.
    func where_clause(mut self, gens int) {
        if not self.at_where() { return }
        self.skip_semis()
        self.next()                               // `where`
        while true {
            let n = self.expect(tok.IDENT)
            self.expect(tok.COLON)
            let bounds = self.bound_list()
            var found = 0
            each g in self.T.Get(gens).Kids {
                if str.split(self.T.Get(g).Sval, "|")[0] == n.Lit { found = g }
            }
            if found == 0 {
                self.Errs.append("{self.file}:{n.Line}:{n.Col}: `where` " ||
                                 "names `{n.Lit}`, which is not a type " ||
                                 "parameter of this declaration (§3.7)")
            } else {
                each b in bounds {
                    self.T.AddKid(found, b)
                }
                let nm = str.split(self.T.Get(found).Sval, "|")[0]
                self.T.Nodes[found].Sval = nm || "|" ||
                    self.bound_names(self.T.Get(found).Kids)
            }
            if not self.accept(tok.COMMA) { break }
        }
    }

    // FLAG bits on a FUNC node's Ival2.
    // 1 = has self, 2 = self is mut, 4 = self is own, 8 = nothrow
    func func_decl(mut self) int {
        let t = self.expect(tok.FUNC)
        let name = self.expect(tok.IDENT)
        let gens = self.generics()
        var flags = 0
        let params = self.params()
        flags = flags | self.selfFlags
        self.selfFlags = 0

        var results = []
        if not self.at(tok.LBRACE) and not self.at(tok.SEMI) and
           not self.at(tok.THROWS) and not self.at(tok.NOTHROW) and
           not self.at(tok.ASSIGN) and not self.at(tok.EOF) and
           not self.at_where() {
            if self.at(tok.LPAREN) {
                self.next()
                while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
                    results.append(self.type_expr())
                    if not self.accept(tok.COMMA) { break }
                }
                self.expect(tok.RPAREN)
            } else {
                results.append(self.type_expr())
            }
        }
        var thr = []
        if self.accept(tok.THROWS) {
            while true {
                thr.append(self.type_expr())
                if not self.accept(tok.COMMA) { break }
            }
        } else if self.accept(tok.NOTHROW) {
            flags = flags | 8
        }
        self.where_clause(gens)
        var body = 0
        var dflt = 0
        if self.at(tok.LBRACE) {
            body = self.block()
        } else if self.accept(tok.ASSIGN) {
            dflt = self.expr()          // a trait default impl, e.g. `= nil`
        }
        let lr = self.T.List(results)
        let lt = self.T.List(thr)
        return self.add(ast.FUNC, t, 0, flags, name.Lit,
                        [body, params, lr, gens, lt, dflt])
    }

    // ------------------------------------------------------------ ffi

    // ffi_block parses `ffi "C" { … }` (§12) into a FFIDEC node, which
    // carries the `link` libraries, followed by one FUNC per declared C
    // function. The FUNCs are ordinary top-level declarations from here on —
    // called, typed and checked like any other — except that they have no
    // body: the lowerer gives each a single FFI instruction instead.
    //
    //     ffi "C" {
    //         link "z"                                  // -lz
    //         func strlen(s *char) usize
    //         func snprintf(buf *u8, n usize, fmt *char, args ...) int
    //     }
    func ffi_block(mut self) []int {
        let t = self.next()                           // `ffi`
        let abi = self.expect(tok.STR)
        if abi.Lit != "C" {
            self.error("the only foreign ABI is \"C\" (§12)")
        }
        self.expect(tok.LBRACE)
        var links = []
        var fns = []
        self.skip_semis()
        while not self.at(tok.RBRACE) and not self.at(tok.EOF) {
            if self.at(tok.IDENT) and self.cur().Lit == "link" {
                self.next()
                let lib = self.expect(tok.STR)
                if not link_name_ok(lib.Lit) {
                    self.Errs.append("{self.file}:{lib.Line}:{lib.Col}: " ||
                                     "`link \"{lib.Lit}\"` must name a " ||
                                     "library — letters, digits, `_`, `.`, " ||
                                     "`+` and `-` — as cc's -l takes it")
                }
                links.append(self.add(ast.STR, lib, 0, 0, lib.Lit, []))
            } else if self.at(tok.FUNC) {
                fns.append(self.ffi_func())
            } else {
                self.error("expected `func` or `link` in an ffi block, " ||
                           "found {self.show()}")
                self.next()
            }
            self.expect_semi()
            self.skip_semis()
        }
        self.expect(tok.RBRACE)
        let ll = self.T.List(links)
        var out = [self.add(ast.FFIDEC, t, 0, 0, abi.Lit, [ll])]
        each f in fns { out.append(f) }
        return out
    }

    // ffi_func parses one C prototype. Its parameter and result types are C
    // types (ffi_ctype); each PARAM also gets the VOILÀ type a caller must
    // pass (ffi_vtype), and the C signature itself rides in Kids[6].
    func ffi_func(mut self) int {
        let t = self.expect(tok.FUNC)
        let name = self.expect(tok.IDENT)
        self.expect(tok.LPAREN)
        var ps = []
        var ctys = []
        var variadic = "0"
        while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
            if self.at(tok.ELLIPSIS) {                // a bare `...`
                let e = self.next()
                ps.append(self.add(ast.PARAM, e, 0, 16, "args", [0]))
                variadic = "1"
                break
            }
            let pn = self.expect(tok.IDENT)
            if self.accept(tok.ELLIPSIS) {            // `args ...`
                ps.append(self.add(ast.PARAM, pn, 0, 16, pn.Lit, [0]))
                variadic = "1"
                break
            }
            let ct = self.ffi_ctype()
            if ct == "void" {
                self.error("`void` is not a parameter type; a C function " ||
                           "with no parameters is written `()`")
            }
            ctys.append(ct)
            ps.append(self.add(ast.PARAM, pn, self.ffi_vtype(pn, ct, false),
                               0, pn.Lit, [0]))
            if not self.accept(tok.COMMA) { break }
        }
        self.expect(tok.RPAREN)
        var ret = "void"
        var results = []
        if not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
           not self.at(tok.EOF) {
            ret = self.ffi_ctype()
            if ret != "void" { results.append(self.ffi_vtype(t, ret, true)) }
        }
        let sig = self.add(ast.STR, name, 0, 0,
                           "@" || name.Lit || "|" || ret || "|" ||
                           str.join(ctys, ",") || "|" || variadic, [])
        return self.add(ast.FUNC, t, 0, ast.FUNC_FFI, name.Lit,
                        [0, self.T.List(ps), self.T.List(results),
                         self.T.List([]), self.T.List([]), 0, sig])
    }

    // ffi_ctype reads a C type — `int`, `usize`, `*char`, `**void` — and
    // returns its CODE, the spelling the backend's FFI lowering and the
    // runtime's converters agree on:
    //
    //   i8 u8 i16 u16 i32 u32 i64 u64   the integer widths
    //   f32 f64 bool void               as named
    //   cstr                            `*char`: a NUL-terminated string
    //   ptr                             any other pointer: a raw address
    func ffi_ctype(mut self) str {
        var stars = 0
        while self.at(tok.STAR) or self.at(tok.POWER) {
            if self.at(tok.POWER) { stars += 2 } else { stars += 1 }
            self.next()
        }
        let n = self.expect(tok.IDENT)
        let base = ffi_base(n.Lit)
        if base == "" {
            self.Errs.append("{self.file}:{n.Line}:{n.Col}: `{n.Lit}` is not " ||
                             "a C type an ffi block knows (§12): use int, " ||
                             "long, usize, i32, u8, double, bool, *char, " ||
                             "*void and the like")
            return "i64"
        }
        if stars == 0 { return base }
        if stars == 1 and n.Lit == "char" { return "cstr" }
        return "ptr"
    }

    // ffi_vtype is the Voilà type of a C type code: a sized integer type for
    // a narrow integer PARAMETER (so the value is range-checked on the way
    // in, §3.2) and `int` for every integer RESULT; `str` for a `*char`
    // parameter and `?str` for a `*char` result (NULL is nil); std/ffi's
    // `Ptr` for any other pointer.
    func ffi_vtype(mut self, at tok.Token, ct str, result bool) int {
        var name = "int"
        if not result and (ct == "i8" or ct == "u8" or ct == "i16" or
                           ct == "u16" or ct == "i32" or ct == "u32" or
                           ct == "u64") {
            name = ct
        }
        if ct == "f32" or ct == "f64" { name = "float" }
        if ct == "bool" { name = "bool" }
        if ct == "ptr" { name = "ffi.Ptr" }
        if ct == "cstr" {
            let s = self.add(ast.TNAMED, at, 0, 0, "str", [])
            if result { return self.add(ast.TOPTION, at, 0, 0, "", [s]) }
            return s
        }
        return self.add(ast.TNAMED, at, 0, 0, name, [])
    }

    // params returns a LIST of PARAM; self's flags land in self.selfFlags.
    func params(mut self) int {
        self.expect(tok.LPAREN)
        self.lev += 1
        var ps = []
        var untyped = []
        while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
            var mode = ast.MODE_BORROW
            if self.accept(tok.OWN) {
                mode = ast.MODE_OWN
            } else if self.accept(tok.MUT) {
                mode = ast.MODE_MUT
            }
            if self.at(tok.SELF) {
                self.next()
                var f = 1
                if mode == ast.MODE_MUT { f = f | 2 }
                if mode == ast.MODE_OWN { f = f | 4 }
                self.selfFlags = self.selfFlags | f
                if not self.accept(tok.COMMA) { break }
                continue
            }
            if self.at(tok.ELLIPSIS) {
                let e = self.next()
                ps.append(self.add(ast.PARAM, e, 0, 16, "args", [0]))
                break
            }
            let nt = self.expect(tok.IDENT)
            // The spec also writes the mode AFTER the name: `buf mut []byte`.
            if self.accept(tok.MUT) {
                mode = ast.MODE_MUT
            } else if self.accept(tok.OWN) {
                mode = ast.MODE_OWN
            }
            var ty = 0
            var dflt = 0
            var variadic = 0
            if self.accept(tok.ELLIPSIS) {
                variadic = 16
                ty = self.type_expr()
            } else if self.at(tok.COMMA) or self.at(tok.RPAREN) {
                untyped.append(len(ps))       // type comes from a later member
            } else if self.at(tok.ASSIGN) {
                self.next()
                dflt = self.expr()
                untyped.append(len(ps))
            } else {
                ty = self.type_expr()
                if self.accept(tok.ASSIGN) { dflt = self.expr() }
            }
            ps.append(self.add(ast.PARAM, nt, ty, mode | variadic, nt.Lit, [dflt]))
            if not self.accept(tok.COMMA) { break }
        }
        self.lev -= 1
        self.expect(tok.RPAREN)

        // `a, b int` gives both the type of the last member of the group.
        var lastType = 0
        var k = len(ps) - 1
        while k >= 0 {
            let id = ps[k]
            if self.T.Get(id).Ival != 0 {
                lastType = self.T.Get(id).Ival
            } else {
                self.T.Nodes[id].Ival = lastType
            }
            k -= 1
        }
        return self.T.List(ps)
    }

    func field_list(mut self, term int) []int {
        var fs = []
        while not self.at(term) and not self.at(tok.EOF) {
            self.skip_semis()
            if self.at(term) { break }
            let n = self.expect(tok.IDENT)
            let ty = self.type_expr()
            var dflt = 0
            if self.accept(tok.ASSIGN) { dflt = self.expr() }
            fs.append(self.add(ast.FIELDDECL, n, ty, 0, n.Lit, [dflt]))
            // Separators: a newline, a `;`, or a `,` — the spec uses all three.
            if not self.accept(tok.COMMA) {
                if not self.at(term) { self.expect_semi() }
            }
            self.skip_semis()
        }
        return fs
    }

    func struct_decl(mut self) int {
        let t = self.expect(tok.STRUCT)
        let n = self.expect(tok.IDENT)
        let gens = self.generics()
        self.expect(tok.LBRACE)
        let fs = self.field_list(tok.RBRACE)
        self.expect(tok.RBRACE)
        return self.add(ast.STRUCTDEC, t, 0, 0, n.Lit,
                        [self.T.List(fs), gens])
    }

    func enum_decl(mut self) int {
        let t = self.expect(tok.ENUM)
        let n = self.expect(tok.IDENT)
        let gens = self.generics()
        self.expect(tok.LBRACE)
        var vs = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            let vn = self.expect(tok.IDENT)
            var fs = []
            if self.accept(tok.LPAREN) {
                self.lev += 1
                var idx = 0
                while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
                    // `radius float` (named) or a bare type.
                    if self.at(tok.IDENT) and (self.peek(1).Kind == tok.IDENT or
                                               type_start(self.peek(1).Kind)) {
                        let fn2 = self.next()
                        let ty = self.type_expr()
                        fs.append(self.add(ast.FIELDDECL, fn2, ty, 0, fn2.Lit, [0]))
                    } else {
                        let here = self.cur()
                        let ty = self.type_expr()
                        fs.append(self.add(ast.FIELDDECL, here, ty, 0,
                                           "_" || str(idx), [0]))
                    }
                    idx += 1
                    if not self.accept(tok.COMMA) { break }
                }
                self.lev -= 1
                self.expect(tok.RPAREN)
            }
            vs.append(self.add(ast.VARIANTDEC, vn, 0, 0, vn.Lit,
                               [self.T.List(fs)]))
            if not self.accept(tok.COMMA) {
                if not self.at(tok.RBRACE) { self.expect_semi() }
            }
        }
        self.expect(tok.RBRACE)
        return self.add(ast.ENUMDEC, t, 0, 0, n.Lit, [self.T.List(vs), gens])
    }

    // trait_decl parses `trait Name[T, …] { … }`. A trait may be GENERIC
    // (§3.6): its parameters are in scope in every method signature and
    // default body, and an `impl` names the arguments (`impl Into[str] for
    // Cel`). Inside the braces `Self` is the implementing type, left as the
    // name `Self` — only an impl block knows which type that is.
    func trait_decl(mut self) int {
        let t = self.expect(tok.TRAIT)
        let n = self.expect(tok.IDENT)
        let gens = self.generics()
        self.where_clause(gens)
        self.expect(tok.LBRACE)
        var ms = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            if self.at(tok.TYPE) {
                // An associated type (`type Item`). Not in the language: a
                // generic trait says the same thing — see §3.6.
                self.error("a trait has no associated types; make the " ||
                           "trait generic instead, as in `trait " ||
                           "Iterator[T] \{ func next(mut self) ?T \}` (§3.6)")
                while not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
                      not self.at(tok.EOF) {
                    self.next()
                }
                continue
            }
            ms.append(self.func_decl())
            self.skip_semis()
        }
        self.expect(tok.RBRACE)
        return self.add(ast.TRAITDEC, t, 0, 0, n.Lit,
                        [self.T.List(ms), gens])
    }

    func impl_decl(mut self) int {
        let t = self.expect(tok.IMPL)
        let gens = self.generics()
        let first = self.type_expr()
        var trait_name = ""
        var trait_ty = 0
        var ty = first
        if self.accept(tok.FOR) {
            let fn2 = self.T.Get(first)
            if fn2.Kind != ast.TNAMED {
                self.error("trait name expected before `for`")
            }
            // The trait name is recorded EXACTLY as written, qualifier and
            // all: trait names are package-qualified like every other
            // declaration (§11.2.1), so `impl pkg.Show for T` names a
            // different trait than a local `Show`, and the loader is the
            // stage that resolves either one to its flat name. The whole
            // TNAMED is kept as well (Kids[2]), because a GENERIC trait's
            // arguments — the `str` of `impl Into[str] for Cel` — live in
            // its Kids.
            trait_name = fn2.Sval
            trait_ty = first
            ty = self.type_expr()
        }
        self.where_clause(gens)
        self.expect(tok.LBRACE)
        // `Self` is the target from here to the closing brace. Only a NAMED
        // target has a name to stand in for it.
        let savedTy = self.selfTy
        let savedName = self.selfName
        if self.T.Kind(ty) == ast.TNAMED {
            self.selfTy = ty
            self.selfName = self.T.Get(ty).Sval
        }
        var ms = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            ms.append(self.func_decl())
            self.skip_semis()
        }
        self.selfTy = savedTy
        self.selfName = savedName
        self.expect(tok.RBRACE)
        return self.add(ast.IMPLDEC, t, ty, 0, trait_name,
                        [self.T.List(ms), gens, trait_ty])
    }

    // copy_tree deep-copies a subtree. `Self` in an impl block's TYPE
    // positions becomes the target type, and the arena invariant (ast.voi:
    // every node owns its Kids slice) forbids two parents sharing one node,
    // so each `Self` gets a copy of its own. A ref-kind node's Ival is a node
    // id too, and is copied the same way.
    func copy_tree(mut self, id int) int {
        if id == 0 { return 0 }
        let n = self.T.Get(id)
        var kids = []
        each k in n.Kids {
            kids.append(self.copy_tree(k))
        }
        var iv = n.Ival
        if ast.IsRefKind(n.Kind) and iv != 0 { iv = self.copy_tree(iv) }
        return self.T.Add(n.Kind, n.Line, n.Col, iv, n.Ival2, n.Sval, kids)
    }

    // self_expr is `Self` in EXPRESSION position inside an impl block — the
    // `Self` of `Self.default()`, `Self{x: 0}` and `Self(5)` — spelled as
    // the target's name would have been written: a bare IDENT, or `pkg.Name`
    // as a FIELD for a target that another package declares.
    func self_expr(mut self, t tok.Token) int {
        let nm = self.selfName
        let dot = str.index(nm, ".")
        if dot < 0 { return self.add(ast.IDENT, t, 0, 0, nm, []) }
        let q = self.add(ast.IDENT, t, 0, 0, nm[0..dot], [])
        return self.add(ast.FIELD, t, 0, 0, nm[dot + 1..len(nm)], [q])
    }

    func exception_decl(mut self) int {
        let t = self.expect(tok.EXCEPTION)
        let n = self.expect(tok.IDENT)
        self.expect(tok.LBRACE)
        var fs = []
        var ms = []
        while true {
            self.skip_semis()
            if self.at(tok.RBRACE) or self.at(tok.EOF) { break }
            if self.at(tok.FUNC) {
                ms.append(self.func_decl())
            } else {
                let fn2 = self.expect(tok.IDENT)
                let ty = self.type_expr()
                var dflt = 0
                if self.accept(tok.ASSIGN) { dflt = self.expr() }
                fs.append(self.add(ast.FIELDDECL, fn2, ty, 0, fn2.Lit, [dflt]))
                self.accept(tok.COMMA)
            }
            self.skip_semis()
        }
        self.expect(tok.RBRACE)
        return self.add(ast.EXCDEC, t, 0, 0, n.Lit,
                        [self.T.List(fs), self.T.List(ms)])
    }

    func type_decl(mut self) int {
        let t = self.expect(tok.TYPE)
        let n = self.expect(tok.IDENT)
        var target = 0
        var strct = 0
        var alias = 0
        if self.accept(tok.ASSIGN) {
            alias = 1
            target = self.type_expr()
        } else if self.at(tok.STRUCT) {
            self.next()
            self.expect(tok.LBRACE)
            let fs = self.field_list(tok.RBRACE)
            self.expect(tok.RBRACE)
            strct = self.add(ast.STRUCTDEC, n, 0, 0, n.Lit,
                             [self.T.List(fs), self.T.List([])])
        } else {
            target = self.type_expr()
        }
        self.expect_semi()
        return self.add(ast.TYPEDEC, t, target, alias, n.Lit, [strct])
    }

    // ------------------------------------------------------------ types

    func type_expr(mut self) int {
        var t = self.type_inner()
        while self.at(tok.BANG) {
            let b = self.next()
            t = self.add(ast.TRESULT, b, 0, 0, "", [t])
        }
        return t
    }

    func type_inner(mut self) int {
        let t = self.cur()
        let k = t.Kind
        if k == tok.QUESTION {
            self.next()
            return self.add(ast.TOPTION, t, 0, 0, "", [self.type_expr()])
        }
        if k == tok.AMP {
            self.next()
            return self.add(ast.TBORROW, t, 0, 0, "", [self.type_expr()])
        }
        if k == tok.LBRACKET {
            self.next()
            if self.accept(tok.RBRACKET) {
                return self.add(ast.TSLICE, t, 0, 0, "", [self.type_expr(), 0])
            }
            self.lev += 1
            let n = self.expr()
            self.lev -= 1
            self.expect(tok.RBRACKET)
            return self.add(ast.TSLICE, t, 0, 0, "", [self.type_expr(), n])
        }
        if k == tok.CHAN {
            self.next()
            self.expect(tok.LBRACKET)
            let e = self.type_expr()
            self.expect(tok.RBRACKET)
            return self.add(ast.TCHAN, t, 0, 0, "", [e])
        }
        if k == tok.SHARED or k == tok.WEAK {
            self.next()
            self.expect(tok.LBRACKET)
            let e = self.type_expr()
            self.expect(tok.RBRACKET)
            var bk = 0
            if k == tok.WEAK { bk = 2 }
            return self.add(ast.TBOX, t, 0, bk, "", [e])
        }
        if k == tok.LPAREN {
            self.next()
            var es = []
            while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
                es.append(self.type_expr())
                if not self.accept(tok.COMMA) { break }
            }
            self.expect(tok.RPAREN)
            return self.add(ast.TTUPLE, t, 0, 0, "", es)
        }
        if k == tok.FUNC {
            // `fn` is not a keyword, so a function TYPE should never begin with
            // `func` — but the Go parser accepts it, so this one must too.
            self.next()
            return self.fn_type(t)
        }
        if k == tok.IDENT {
            let name = self.next().Lit
            if name == "map" {
                self.expect(tok.LBRACKET)
                let kk = self.type_expr()
                self.expect(tok.RBRACKET)
                let vv = self.type_expr()
                return self.add(ast.TMAP, t, 0, 0, "", [kk, vv])
            }
            if name == "set" {
                self.expect(tok.LBRACKET)
                let e = self.type_expr()
                self.expect(tok.RBRACKET)
                return self.add(ast.TSET, t, 0, 0, "", [e])
            }
            if name == "cell" and self.at(tok.LBRACKET) {
                self.next()
                let e = self.type_expr()
                self.expect(tok.RBRACKET)
                return self.add(ast.TBOX, t, 0, 1, "", [e])
            }
            if name == "fn" {
                return self.fn_type(t)
            }
            if name == "Self" and self.selfTy != 0 and not self.at(tok.DOT) {
                return self.copy_tree(self.selfTy)
            }
            if name == "Self" and self.selfName != "" and
               not self.at(tok.DOT) {
                // An interpolated string's sub-parser knows the name only.
                return self.add(ast.TNAMED, t, 0, 0, self.selfName, [])
            }
            var full = name
            if self.accept(tok.DOT) {
                full = full || "." || self.expect(tok.IDENT).Lit
            }
            var args = []
            if self.at(tok.LBRACKET) {
                self.next()
                while not self.at(tok.RBRACKET) and not self.at(tok.EOF) {
                    args.append(self.type_expr())
                    if not self.accept(tok.COMMA) { break }
                }
                self.expect(tok.RBRACKET)
            }
            return self.add(ast.TNAMED, t, 0, 0, full, args)
        }
        self.error("expected type, found {self.show()}")
        self.next()
        return self.add(ast.TNAMED, t, 0, 0, "unit", [])
    }

    func fn_type(mut self, t tok.Token) int {
        self.expect(tok.LPAREN)
        var ps = []
        while not self.at(tok.RPAREN) and not self.at(tok.EOF) {
            ps.append(self.type_expr())
            if not self.accept(tok.COMMA) { break }
        }
        self.expect(tok.RPAREN)
        var res = 0
        if not self.at(tok.LBRACE) and not self.at(tok.RPAREN) and
           not self.at(tok.RBRACKET) and not self.at(tok.COMMA) and
           not self.at(tok.SEMI) and not self.at(tok.RBRACE) and
           not self.at(tok.EOF) and not self.at(tok.ASSIGN) {
            res = self.type_expr()
        }
        return self.add(ast.TFN, t, res, 0, "", [self.T.List(ps)])
    }
}

// ffi_base maps a C type NAME (the part after any `*`) to its code. The
// integer names cover C's own (`int`, `long`, `size_t`, …), <stdint.h>'s
// and Voilà's sized spellings; `long` is 64 bits, as on every LP64 system
// this runtime supports.
func ffi_base(n str) str {
    if n == "char" or n == "i8" or n == "schar" or n == "int8_t" { return "i8" }
    if n == "uchar" or n == "u8" or n == "byte" or n == "uint8_t" { return "u8" }
    if n == "short" or n == "i16" or n == "int16_t" { return "i16" }
    if n == "ushort" or n == "u16" or n == "uint16_t" { return "u16" }
    if n == "int" or n == "i32" or n == "int32_t" { return "i32" }
    if n == "uint" or n == "u32" or n == "unsigned" or n == "uint32_t" {
        return "u32"
    }
    if n == "long" or n == "i64" or n == "int64_t" or n == "isize" or
       n == "ssize_t" or n == "longlong" or n == "off_t" or
       n == "intptr_t" or n == "ptrdiff_t" {
        return "i64"
    }
    if n == "ulong" or n == "u64" or n == "uint64_t" or n == "usize" or
       n == "size_t" or n == "ulonglong" or n == "uintptr_t" {
        return "u64"
    }
    if n == "float" or n == "f32" { return "f32" }
    if n == "double" or n == "f64" { return "f64" }
    if n == "bool" or n == "_Bool" { return "bool" }
    if n == "void" { return "void" }
    return ""
}

// link_name_ok accepts what cc's `-l` takes as a library name.
func link_name_ok(s str) bool {
    if len(s) == 0 { return false }
    each c in s {
        let ok = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or
                 (c >= '0' and c <= '9') or c == '_' or c == '.' or
                 c == '+' or c == '-'
        if not ok { return false }
    }
    return s[0] != '-'
}

func type_start(k int) bool {
    return k == tok.LBRACKET or k == tok.QUESTION or k == tok.CHAN or
           k == tok.SHARED or k == tok.WEAK or k == tok.LPAREN or k == tok.AMP
}
