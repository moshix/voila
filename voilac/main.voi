// voilac — the Voilà compiler, written in Voilà.
//
//     voilac run    x.voi [args…]    compile (cached) and execute
//     voilac build  x.voi [-o exe]   compile to a native binary (via cc)
//     voilac -S     x.voi            emit the VM assembly listing
//     voilac --emit=c x.voi          emit the C translation unit
//     voilac check  x.voi            parse and load only
//     voilac load   x.voi            dump the flattened program
//     voilac ast    x.voi            dump the parse tree
//     voilac tokens x.voi            dump the token stream
//
// The pipeline is lex → par → load → low → cg → cc.
//
// `run` COMPILES AND EXECUTES rather than interpreting. The Equivalence
// Guarantee (§12) says a program must behave identically however it is run —
// and the surest way to keep that promise is to have only one engine. `run`
// caches the binary under ~/.cache/voila keyed by a hash of every source that
// took part, so the second run of a script costs nothing. (A bytecode VM would
// buy faster cold starts at the price of a second semantics to keep in step;
// it stays a future optimisation, not a second source of truth.)
package main

use "voilac/lex"
use "voilac/par"
use "voilac/load"
use "voilac/chk"
use "voilac/diag"
use "voilac/low"
use "voilac/opt"
use "voilac/cg"
use "voilac/ir"
use "voilac/rt"
use "voilac/path"
use "std/os"
use "std/fmt"
use "std/str"

// MIN_BOOTSTRAP (build.sh) is 0.4.1 — the oldest voila that can build this
// source; 0.5.0 is built by any voila >= 0.4.1. See BOOTSTRAP.md.
const VERSION = "0.5.0"

// CFLAGS is the single home of the C compilation flags. The runtime-archive
// cache key hashes it; the program compile and the archive build use it.
// If these ever diverged, a cached archive built with old flags would be
// linked into builds claiming new ones.
// gNative: `voila build --native` tunes the PROGRAM translation unit for
// the build machine's CPU (never the default — binaries stay portable, and
// the shared runtime archive stays generic). The spelling differs between
// toolchains (-march=native vs -mcpu=native on some arm64 compilers), so
// compile_c_in probes which one the cc accepts.
var gNative = false

// NEVER add -flto here: the -O2 frame-elision macro (VL_FRAME_ON_STACK)
// and setjmp-crossing stack frames are only conforming because the runtime
// archive is a separate translation unit the C optimizer cannot see into.
const CFLAGS = "-std=c11 -O2"

func main() {
    let args = os.args()

    // `voila version` takes no file, so it is answered before the usage guard.
    if len(args) >= 1 and (args[0] == "version" or args[0] == "--version" or
                           args[0] == "-v") {
        say "voila " || VERSION
        return
    }
    // `voila get` and `voila mod` work on the MODULE, not on a file, so they
    // are answered before the "a verb needs a file" guard.
    if len(args) >= 1 and args[0] == "get" {
        if len(args) != 2 {
            fmt.eprintf("voila: usage: voila get <module>@<version>\n")
            os.exit(2)
        }
        mod_get(args[1])
        return
    }
    if len(args) >= 1 and args[0] == "mod" {
        var sub = ""
        if len(args) >= 2 { sub = args[1] }
        var rest = ""
        if len(args) >= 3 { rest = args[2] }
        mod_verb(sub, rest)
        return
    }
    if len(args) < 2 {
        usage()
        os.exit(2)
    }
    var verb = args[0]
    var src = args[1]
    var optLevel = 0
    // The -W state, resolved from the command line by warn_option below. It
    // decides which warnings are printed and which of them are fatal; it can
    // never change the code that is emitted.
    var pol = diag.NewPolicy()

    // `voila build -S x.voi` and `voila build --emit=c x.voi` are the forms the
    // manual documents: -S and --emit=c are options of BUILD, not verbs of
    // their own. They are accepted bare too, because that is what the compiler
    // itself has always been driven with.
    // `-O` levels are honored by every whole-program verb — build, run,
    // check, -S, --emit=c — because they all see the same optimized module.
    // A level on a verb that cannot apply it (tokens, ast, load) is an
    // ERROR, not a shrug: a silently ignored flag lets a user believe an
    // optimization was applied when nothing happened.
    var seenO = false
    if verb == "build" or verb == "check" or verb == "-S" or
       verb == "--emit=c" or verb == "-c" {
        var i = 1
        while i < len(args) {
            let a = args[i]
            var lv = 0 - 1
            if a == "-S" or a == "--emit=c" or a == "-c" {
                verb = a
            } else if a == "-O0" {
                lv = 0                        // an explicit no-op
            } else if a == "-O1" {
                lv = 1
            } else if a == "-O2" {
                lv = 2
            } else if a == "-O3" {
                lv = 3
            } else if a == "-o" or a == "--keep-c" {
                i += 1                       // the option's value
            } else if a == "--native" {
                gNative = true
            } else if not str.starts_with(a, "-") {
                src = a
            } else if not warn_option(a, pol) {
                fmt.eprintf("voila: unknown build option %s\n", a)
                usage()
                os.exit(2)
            }
            if lv >= 0 {
                if seenO {
                    fmt.eprintf("voila: more than one -O level given\n")
                    os.exit(2)
                }
                seenO = true
                optLevel = lv
            }
            i += 1
        }
    }
    // `voila run [-O2] [-Wall …] x.voi args…`: the options sit between the
    // verb and the FILE, and everything after the file is forwarded to the
    // program untouched — a script may legitimately take `--strict` itself,
    // so the scan stops at the first argument that is not a flag.
    var runShift = 0
    if verb == "run" {
        var i = 1
        while i < len(args) and str.starts_with(args[i], "-") {
            let a = args[i]
            var lv = 0 - 1
            if a == "-O0" {
                lv = 0
            } else if a == "-O1" {
                lv = 1
            } else if a == "-O2" {
                lv = 2
            } else if a == "-O3" {
                lv = 3
            } else if not warn_option(a, pol) {
                fmt.eprintf("voila: unknown run option %s\n", a)
                usage()
                os.exit(2)
            }
            if lv >= 0 {
                if seenO {
                    fmt.eprintf("voila: more than one -O level given\n")
                    os.exit(2)
                }
                seenO = true
                optLevel = lv
            }
            i += 1
        }
        if i < len(args) { src = args[i] }
        runShift = i - 1
    }
    if src == "" or str.starts_with(src, "-") {
        usage()
        os.exit(2)
    }

    // The front-end-only verbs take no options; a stray flag (say, an -O
    // level on `tokens`) is rejected rather than silently ignored.
    if verb == "tokens" or verb == "ast" or verb == "load" {
        var i = 2
        while i < len(args) {
            if str.starts_with(args[i], "-") {
                fmt.eprintf("voila: %s takes no options: %s\n", verb, args[i])
                os.exit(2)
            }
            i += 1
        }
    }

    // The two front-end-only verbs work on ONE file: no packages, no loader.
    if verb == "tokens" {
        run_tokens(src)
        return
    }
    if verb == "ast" {
        run_ast(src)
        return
    }

    // Everything else compiles a whole program.
    var prog = load.Load(src, VERSION)
    // A load ERROR means the tree cannot be trusted, so the checker must not
    // walk it: report what the loader found and stop right here. WARNINGS
    // stop nothing — they are merged into the checker's bag below and
    // rendered WITH it, so one run shows every diagnostic of both stages in
    // one list sorted by position rather than by which stage found it.
    if prog.Diags.NErrors() > 0 {
        report_bag(prog.Diags, pol, src)
    }

    if verb == "load" {
        // A tree DUMP, not a verdict. `load` takes no options (the guard
        // above rejects every flag), so a warning printed here could not be
        // switched off — the one state diag's Code field exists to prevent.
        // Its errors were reported just above; its advice belongs to the
        // verbs that can be told what to do with it.
        each line in prog.T.Dump(prog.File) {
            say line
        }
        return
    }

    // Nothing is lowered until the program is verified: the acyclicity rule,
    // the widening lattice, match exhaustiveness, use-after-move and the printf
    // checks all run here (§6, §3.2, §3.5, §13.1).
    var bag = diag.New()
    bag.merge(prog.Diags)
    bag.merge(chk.Check(prog.T, prog.File))
    report_bag(bag, pol, src)

    // `check` runs the LOWERER too, then stops: the lowerer catches its own
    // class of errors (unknown identifiers, loop-variable capture,
    // unresolved upvalues), and "check said ok, build refused" is exactly
    // the inconsistency the verb exists to prevent.
    var lo = low.New(prog.T, prog.File, src)
    try {
        lo.LowerModule()
    } catch e: low.LowerError {
        fmt.eprintf("%s:%d:%d: %s\n", src, e.Line, e.Col, e.Msg)
        os.exit(1)
    }

    if verb == "check" {
        say "ok"
        return
    }

    // The optimizer runs here — before -S, --emit=c and build alike — so
    // every verb sees the same module and `-S -O2` is the review artifact.
    if optLevel > 0 {
        opt.Run(lo.M, optLevel)
    }

    if verb == "-S" {
        fmt.printf("%s", ir.Listing(lo.M, str.lines(prog.Src)))
        return
    }

    var csrc = ""
    try {
        csrc = cg.Compile(prog.T, prog.File, lo.M)
    } catch e: cg.CGenError {
        fmt.eprintf("%s\n", e.Msg)
        os.exit(1)
    }

    if verb == "--emit=c" or verb == "-c" {
        fmt.printf("%s", csrc)
        return
    }
    if verb == "build" {
        build(src, csrc, args, optLevel)
        return
    }
    if verb == "run" {
        run(prog, csrc, args, optLevel, runShift, pol.Key())
        return
    }

    fmt.eprintf("voila: unknown verb %s\n", verb)
    os.exit(2)
}

// run compiles the program (once) and executes it, forwarding the remaining
// arguments. The binary is cached under ~/.cache/voila, keyed by a hash of
// every source that took part — so editing any file in any package invalidates
// it, and an unchanged script starts instantly.
func run(prog load.Program, csrc str, args []str, optLevel int,
         runShift int, wkey str) {
    // The level is part of the key: `run -O2 x` after `run x` must not
    // execute the cached unoptimized binary.
    //
    // So is the -W state (diag.Policy.Key). Today nothing could go wrong
    // without it — main() reports and exits BEFORE this function is reached,
    // so `--strict` refuses long before the cache is consulted — but the
    // invariant belongs where the key is built. A future fast path that
    // looked the cache up first would otherwise hand a `--strict` run the
    // lenient binary its previous run left behind, and say nothing.
    var kh = source_key(prog)
    kh = fnv_into(kh, "\u{0}")
    kh = fnv_into(kh, str(optLevel))
    kh = fnv_into(kh, "\u{0}")
    kh = fnv_into(kh, wkey)
    let key = fmt.sprintf("%016x", kh)
    let dir = cache_dir()
    ensure_dir(dir)
    let exe = path.Join(dir, key)

    if not os.exists(exe) {
        // The temporary name is per PROCESS, not per cache key: two concurrent
        // first-runs of the same program would otherwise `cc -o` the SAME file
        // and race to rename it, and a truncated binary would be cached
        // forever. The rename itself is atomic, so the loser simply replaces an
        // identical file.
        let tmp = exe || ".tmp" || host_tag() || "-" || str(os.pid())
        compile_c(csrc, tmp, optLevel)
        if os.run("mv", ["-f", tmp, exe]) != 0 {
            fmt.eprintf("voila: cannot install %s\n", exe)
            os.exit(1)
        }
    }

    var rest = []
    var i = 2 + runShift
    while i < len(args) {
        rest.append(args[i])
        i += 1
    }
    os.exit(os.run(exe, rest))
}

// source_key hashes the CONTENT of every source file that took part (FNV-1a,
// 64-bit), so that editing any file of any imported package invalidates the
// entry — and so that two different programs cannot collide on one key.
//
// It hashes prog.Paths, not prog.Sources: a source's DISPLAY name is relative
// to the module root and cannot be reopened from another working directory. A
// participating file that cannot be read is a hard error; folding a constant
// into the hash in its place would silently drop that file's content from the
// key, which is how a stale binary gets run forever.
//
// The COMPILER's identity is part of the key too — its size and modification
// time. A new compiler emits different code, so every cached binary the old one
// produced is stale the moment the toolchain is rebuilt. Without this, `voila
// run` would go on executing binaries built by a compiler that no longer
// exists, and a bug fix would appear not to work.
func source_key(prog load.Program) int {
    var h = -3750763034362895579          // the FNV-1a 64-bit offset basis
    let exe = os.exe()
    h = fnv_into(h, exe)
    h = fnv_into(h, "\u{0}")             // field separators: without them
    h = fnv_into(h, str(os.size(exe)))    // adjacent fields could collide
    h = fnv_into(h, "\u{0}")
    h = fnv_into(h, str(os.mtime(exe)))
    // The C toolchain is part of the key too: a binary linked against a
    // stale or different runtime archive must not outlive the archive fix.
    let cc = find_cc()
    h = fnv_into(h, "\u{0}")
    h = fnv_into(h, cc)
    h = fnv_into(h, "\u{0}")
    h = fnv_into(h, cc_identity(cc))
    h = fnv_into(h, "\u{0}")
    h = fnv_into(h, CFLAGS)
    each i, p in prog.Paths {
        h = fnv_into(h, "\u{0}")
        h = fnv_into(h, prog.Sources[i])
        h = fnv_into(h, "\u{0}")
        match os.read(p) {
            Ok(text) => h = fnv_into(h, text)
            Err(e)   => {
                fmt.eprintf("voila: cannot re-read %s for the run cache\n", p)
                os.exit(1)
            }
        }
    }
    return h
}

func fnv_into(h0 int, s str) int {
    var h = h0
    each b in bytes(s) {
        h = h ^ b
        h = wrap_mul(h, 1099511628211)
    }
    return h
}

func cache_dir() str {
    let home = os.env("HOME")
    if home == nil {
        // Per-user, never world-shared: a common /tmp cache would let any
        // local user pre-plant an archive that gets linked into binaries.
        return "/tmp/voila-cache-" || host_tag()
    }
    return path.Join(str(home), ".cache/voila")
}

// host_tag is a short stable token distinguishing hosts (NFS homes share
// pids across machines) and users (the HOME-less cache path).
func host_tag() str {
    match os.hostname() {
        Ok(hn) => {
            var t = 0
            t = fnv_into(t, hn)
            return fmt.sprintf("%08x", t & 0xffffffff)
        }
        Err(e) => return "h0"
    }
    return "h0"
}

func usage() {
    fmt.eprintf("voila %s — the Voilà compiler\n\n", VERSION)
    fmt.eprintf("  voila run    <file.voi> [args…]   compile (cached) and run\n")
    fmt.eprintf("  voila build  <file.voi> [-o exe]  compile to a binary\n")
    fmt.eprintf("  voila build -S      <file.voi>    emit the assembly listing\n")
    fmt.eprintf("  voila build --emit=c <file.voi>   emit the C\n")
    fmt.eprintf("  voila check  <file.voi>           verify only\n")
    fmt.eprintf("  voila build -O1|-O2|-O3 <file>    optimize (also for run)\n")
    fmt.eprintf("  voila version                     print the version\n")
    fmt.eprintf("\n  voila get <module>@<version>      fetch a dependency " ||
                "(shells out to git)\n")
    fmt.eprintf("  voila mod init [modpath]          write a voila.mod\n")
    fmt.eprintf("  voila mod verify                  re-hash the cached " ||
                "dependencies against voila.sum\n")
    fmt.eprintf("\n  ast | tokens | load              dump a front-end stage\n")
    fmt.eprintf("\n  warnings: -W<code> -Wno-<code> -Wall -Werror " ||
                "-Werror=<code>\n")
    fmt.eprintf("            --strict (= -Wall -Werror);  codes: %s\n",
                str.join(diag.Codes(), ", "))
}

// ------------------------------------------------------------------ modules

// mod_get fetches one dependency into the module cache.
//
// THERE IS NO NETWORK CODE IN THE COMPILER, and there never will be: `git`
// does the fetching, over a channel the user already trusts and already has
// credentials for. The compiler's part is the four things git cannot do — pick
// the cache path, check that the clone IS the module it claims to be, hash it,
// and record the hash in voila.sum.
//
// The install is claim-then-move, exactly as the run cache and the runtime
// archive are: the clone lands in a per-process temporary directory and is
// renamed into place, so two concurrent fetches cannot leave a half-cloned
// tree in the cache forever.
func mod_get(spec str) {
    let at = str.last_index(spec, "@")
    if at <= 0 or at == len(spec) - 1 {
        fmt.eprintf("voila: usage: voila get <module>@<version>\n")
        os.exit(2)
    }
    let mp = spec[0..at]
    let ver = spec[at + 1..len(spec)]
    // Both halves land in a PATH under the cache root and in a voila.sum
    // LINE, so both are checked before either is used. `..` is the one that
    // matters: `voila get x/../../../etc@v1` would otherwise name a directory
    // outside the cache, and that directory is the target of an `rm -rf`.
    // Whitespace matters for the other reason — voila.sum is three
    // whitespace-separated fields per line, and a fourth would be silently
    // dropped on the next read and appended again on the next fetch.
    if not mod_word_ok(mp) or not mod_word_ok(ver) {
        fmt.eprintf("voila: `%s` is not a module@version: a module path and " ||
                    "a version may not contain whitespace or a `..` " ||
                    "segment\n", spec)
        os.exit(2)
    }
    let dest = load.ModCacheDir(mp, ver)

    if os.isdir(dest) {
        fmt.eprintf("voila: %s %s is already in the module cache\n", mp, ver)
    } else {
        ensure_dir(path.Dir(dest))
        let tmp = dest || ".tmp-" || host_tag() || "-" || str(os.pid())
        os.run("rm", ["-rf", tmp])
        let url = "https://" || mp
        if os.run("git", ["clone", "--depth", "1", "--branch", ver,
                          url, tmp]) != 0 {
            os.run("rm", ["-rf", tmp])
            fmt.eprintf("voila: git clone failed: %s at %s\n", url, ver)
            os.exit(1)
        }
        // The clone must BE the module it is being filed as, or an import
        // path would mean one thing to the program and another on disk.
        let sub = load.ReadMod(tmp)
        if not sub.Found {
            os.run("rm", ["-rf", tmp])
            fmt.eprintf("voila: %s at %s has no voila.mod\n", url, ver)
            os.exit(1)
        }
        if sub.Module != mp {
            os.run("rm", ["-rf", tmp])
            fmt.eprintf("voila: %s at %s declares module `%s`, not `%s`\n",
                        url, ver, sub.Module, mp)
            os.exit(1)
        }
        // The cache holds SOURCE, not a working copy; .git would be the
        // largest part of it and the only mutable part of it.
        os.run("rm", ["-rf", path.Join(tmp, ".git")])
        // `mv tmp dest` is NOT the primitive here, for exactly the reason
        // link_runtime spells out: when dest already exists — a concurrent
        // `voila get` won the race that the isdir check above cannot close,
        // because a clone sits between them — mv NESTS tmp inside it and
        // SUCCEEDS, leaving a whole second copy of the module inside the
        // winner's cache entry. ModHash walks it, so the hash recorded in
        // voila.sum would then cover the junk and every later verification of
        // the clean entry would mismatch for good. The portable atomic claim
        // is mkdir, which fails if the directory exists; the loser deletes
        // its clone and uses what the winner installed.
        // The CONTENTS move into the claimed directory rather than the
        // directory being renamed onto it: renaming would need the claim
        // released first, and that reopens the very window mkdir closed. A
        // failed move tears the claim down again, or an empty entry would
        // block this module@version forever.
        let claim = "if mkdir " || shq(dest) || " 2>/dev/null; then " ||
                    "shopt -s dotglob; mv " || shq(tmp) || "/* " ||
                    shq(dest) || "/ || rm -rf " || shq(dest) || "; fi; " ||
                    "rm -rf " || shq(tmp)
        os.run("bash", ["-c", claim])
        if not os.isdir(dest) {
            fmt.eprintf("voila: cannot install %s\n", dest)
            os.exit(1)
        }
        fmt.eprintf("voila: fetched %s %s into %s\n", mp, ver, dest)
    }

    // Record it in the CURRENT module's voila.sum, if the user is standing in
    // a module at all.
    let root = module_here()
    if root == "" { return }
    let h = load.ModHash(dest)
    let sums, present = load.ReadSum(root)
    let want = load.FindSum(sums, mp, ver)
    if want != "" {
        if want != h {
            fmt.eprintf("voila: checksum mismatch for %s %s: voila.sum " ||
                        "records %s, the fetched tree hashes to %s\n",
                        mp, ver, want, h)
            os.exit(1)
        }
        return
    }
    var text = ""
    if present {
        match os.read(load.SumPath(root)) {
            Ok(t)  => text = t
            Err(e) => text = ""
        }
        if text != "" and not str.ends_with(text, "\n") { text = text || "\n" }
    }
    text = text || mp || " " || ver || " " || h || "\n"
    // os.write returns a value-carrying IOError, never a bool: a failed
    // write must not be mistaken for a successful one.
    match os.write(load.SumPath(root), text) {
        Ok(u)  => u
        Err(e) => {
            fmt.eprintf("voila: cannot write %s: %s\n", load.SumPath(root),
                        e.message())
            os.exit(1)
        }
    }
    fmt.eprintf("voila: recorded %s %s in voila.sum\n", mp, ver)
}

// mod_verb is `voila mod …`. `init` and `verify` are here because they are a
// dozen lines each; `tidy` is NOT implemented — rewriting a require list means
// deciding a VERSION for a path the program mentions and nothing pins, which
// is a fetch policy and not a text edit.
func mod_verb(sub str, arg str) {
    if sub == "init" {
        let dir = cwd_or_dot()
        let file = path.Join(dir, "voila.mod")
        if os.exists(file) {
            fmt.eprintf("voila: %s already exists\n", file)
            os.exit(1)
        }
        var name = arg
        if name == "" { name = path.Base(dir) }
        match os.write(file, "module " || name || "\nvoila " || VERSION ||
                             "\n") {
            Ok(u)  => u
            Err(e) => {
                fmt.eprintf("voila: cannot write %s: %s\n", file,
                            e.message())
                os.exit(1)
            }
        }
        say "voila: wrote " || file
        return
    }
    if sub == "verify" {
        let root = module_here()
        if root == "" {
            fmt.eprintf("voila: no voila.mod here or in any parent " ||
                        "directory\n")
            os.exit(1)
        }
        let mi = load.Modules(root)
        var bad = 0
        each e in mi.Mod.Errs {
            fmt.eprintf("%s:%d: %s\n", mi.Mod.File, e.Line, e.Msg)
            bad += 1
        }
        each d in mi.Deep {
            fmt.eprintf("%s\n", d)
            bad += 1
        }
        let sums, present = load.ReadSum(root)
        each p in mi.Paths {
            let ver = mi.Ver[p]
            if load.IsLocal(mi, p) {
                say p || " " || ver || "  replaced by " || mi.Dir[p]
                continue
            }
            let dir = mi.Dir[p]
            if dir == "" or not os.isdir(dir) {
                fmt.eprintf("%s %s: not in the module cache — run: " ||
                            "voila get %s@%s\n", p, ver, p, ver)
                bad += 1
                continue
            }
            let got = load.ModHash(dir)
            if not present {
                say p || " " || ver || "  " || got || "  (no voila.sum)"
                continue
            }
            let want = load.FindSum(sums, p, ver)
            if want == "" {
                fmt.eprintf("%s %s: no voila.sum entry — run: " ||
                            "voila get %s@%s\n", p, ver, p, ver)
                bad += 1
            } else if want != got {
                fmt.eprintf("%s %s: checksum mismatch: voila.sum records " ||
                            "%s, %s hashes to %s\n", p, ver, want, dir, got)
                bad += 1
            } else {
                say p || " " || ver || "  ok"
            }
        }
        if bad > 0 { os.exit(1) }
        say "voila: " || str(len(mi.Paths)) || " module(s) verified"
        return
    }
    fmt.eprintf("voila: unknown `voila mod` subcommand `%s`: " ||
                "init, verify\n", sub)
    os.exit(2)
}

// mod_word_ok accepts a module path or a version: no whitespace, no `..`
// segment, not empty, and not absolute.
func mod_word_ok(w str) bool {
    if w == "" { return false }
    if str.starts_with(w, "/") { return false }
    each b in bytes(w) {
        if b <= 32 or b == 127 { return false }
    }
    if w == ".." or str.starts_with(w, "../") or str.ends_with(w, "/..") or
       str.contains(w, "/../") { return false }
    return true
}

func cwd_or_dot() str {
    match os.cwd() {
        Ok(d)  => return d
        Err(e) => return "."
    }
    return "."
}

// module_here is the module the user is standing in, or "" when there is
// none. load.ModuleRoot falls back to the directory it was given, so the
// voila.mod is checked for explicitly.
func module_here() str {
    let root = load.ModuleRoot(cwd_or_dot())
    if not os.exists(path.Join(root, "voila.mod")) { return "" }
    return root
}

// warn_option applies one -W… option to the policy and reports whether the
// argument WAS one, so each verb's option loop can fall through to its own
// handling. Every verb that compiles a program routes through here, which is
// what keeps the spelling of these flags in one place.
//
// `-Werror=<code>` also ENABLES the code, as gcc's does: asking for a warning
// to be fatal and then not being shown it would be a strange thing to mean.
func warn_option(a str, pol mut diag.Policy) bool {
    if a == "-Wall" {
        pol.EnableAll()
        return true
    }
    if a == "--strict" {
        pol.EnableAll()             // spelled once: --strict IS -Wall -Werror
        pol.Werror()
        return true
    }
    if a == "-Werror" {
        pol.Werror()
        return true
    }
    if str.starts_with(a, "-Werror=") {
        let c = warn_code(a, a[8..len(a)])
        pol.Enable(c)
        pol.WerrorCode(c)
        return true
    }
    if str.starts_with(a, "-Wno-") {
        pol.Disable(warn_code(a, a[5..len(a)]))
        return true
    }
    if str.starts_with(a, "-W") and len(a) > 2 {
        pol.Enable(warn_code(a, a[2..len(a)]))
        return true
    }
    return false
}

// warn_code validates one warning code and returns it. A misspelt code is
// FATAL, not ignored: `-Wno-unusd-import` that silently does nothing is
// exactly how a warning gets switched off for a whole release without anyone
// noticing — the same reasoning that makes an -O level on `tokens` an error
// rather than a shrug.
func warn_code(flag str, code str) str {
    if diag.Known(code) { return code }
    fmt.eprintf("voila: unknown warning `%s` in %s; the warnings are %s\n",
                code, flag, str.join(diag.Codes(), ", "))
    os.exit(2)
    return code
}

func run_tokens(p str) {
    var lx = lex.New(p, read(p))
    let ts = lx.Tokens()
    // The tokens print even when the scan complained, so that the differential
    // test can compare error recovery too.
    each line in lex.Dump(ts) {
        say line
    }
    report(lx.Errs)
}

func run_ast(p str) {
    var ps = par.New(p, read(p))
    let root = ps.File()
    report(ps.Errs)
    each line in ps.T.Dump(root) {
        say line
    }
}

// build writes the C and libvoila's source into a scratch directory and hands
// the lot to the system cc. The binary that comes out links libc and nothing
// else.
func build(src str, csrc str, args []str, level int) {
    var out = default_out(src)
    var keep = ""
    // From 1, not 2. args[0] is the verb; starting at 2 assumed the SOURCE
    // FILE was args[1], so `voila build -o name x.voi` — the flag before the
    // file, which is how most people write it — skipped straight past the
    // `-o` and wrote the default name while reporting success. The loop only
    // reacts to `-o` and `--keep-c`, so passing the source filename through
    // it costs nothing.
    var i = 1
    while i < len(args) {
        if args[i] == "-o" and i + 1 < len(args) {
            out = args[i + 1]
            i += 1
        } else if args[i] == "--keep-c" and i + 1 < len(args) {
            keep = args[i + 1]
            i += 1
        }
        i += 1
    }

    compile_c_in(csrc, out, keep, level)
    fmt.printf("voila: built %s\n", out)
}

// compile_c writes the C and libvoila's source into a scratch directory and
// hands the lot to the system cc. The binary that comes out links libc and
// nothing else.
func compile_c(csrc str, out str, level int) {
    compile_c_in(csrc, out, "", level)
}

// native_flag finds the spelling this cc accepts for "tune for this CPU",
// by compiling an empty program in the scratch directory.
func native_flag(cc str, dir str) str {
    let probe = path.Join(dir, "native_probe.c")
    match os.write(probe, "int main(void) \{ return 0; \}\n") {
        Ok(u) => u
        Err(e) => return ""
    }
    let out = path.Join(dir, "native_probe.bin")
    each f in ["-march=native", "-mcpu=native"] {
        let rc = os.run("bash", ["-c",
            shq(cc) || " " || f || " -o " || shq(out) || " " || shq(probe) ||
            " >/dev/null 2>&1"])
        if rc == 0 {
            return f
        }
    }
    return ""
}

func compile_c_in(csrc str, out str, keep str, level int) {
    // The scratch directory is per PROCESS. A fixed name would let two
    // concurrent builds — `make -j`, or a test harness — write the runtime into
    // the same place and delete it from under each other's cc.
    var dir = keep
    if dir == "" { dir = "/tmp/voilac-" || str(os.pid()) }
    ensure_dir(dir)

    let cpath = path.Join(dir, "program.c")
    match os.write(cpath, csrc) {
        Ok(u) => u
        Err(e) => {
            fmt.eprintf("voila: cannot write %s\n", cpath)
            os.exit(1)
        }
    }

    let cc = find_cc()

    // The runtime never changes between builds of the same compiler, yet it
    // used to be recompiled from source EVERY time — a fixed ~0.9 s that was
    // ~93 % of a small program's build. runtime_lib compiles it once into
    // ~/.cache/voila/rt-<key>/libvoila.a and reuses it; on any failure it
    // returns "" and this function falls back to compiling from source, so a
    // missing `ar` or an unwritable cache can never break a build.
    // `--keep-c` also takes the source path: its promise is a self-contained
    // directory holding everything cc consumed.
    var rtdir = ""
    if keep == "" { rtdir = runtime_lib(cc) }

    // Each whitespace-separated flag is its own argv element. `voila build
    // -O3` also raises the C optimizer to -O3 for the PROGRAM translation
    // unit; the runtime archive stays at CFLAGS so all levels share it.
    var pflags = CFLAGS
    if level >= 3 {
        pflags = str.replace(pflags, "-O2", "-O3")
    }
    if gNative {
        let nf = native_flag(cc, dir)
        if nf == "" {
            fmt.eprintf("voila: %s accepts neither -march=native nor " ||
                        "-mcpu=native\n", cc)
            os.exit(1)
        }
        pflags = pflags || " " || nf
    }
    var cargs = []
    each f in fields(pflags) {
        cargs.append(f)
    }
    if rtdir != "" {
        cargs.append("-I" || rtdir)
        cargs.append("-o")
        cargs.append(out)
        cargs.append(cpath)
        cargs.append(path.Join(rtdir, "libvoila.a"))
    } else {
        var cfiles = []
        match rt.WriteTo(dir) {
            Ok(fs) => cfiles = fs
            Err(e) => {
                fmt.eprintf("voila: cannot write the runtime into %s\n", dir)
                os.exit(1)
            }
        }
        cargs.append("-I" || dir)
        cargs.append("-o")
        cargs.append(out)
        cargs.append(cpath)
        each f in cfiles {
            cargs.append(f)
        }
    }
    cargs.append("-lm")
    cargs.append("-lpthread")

    var rc = os.run(cc, cargs)
    if rc != 0 and rtdir != "" {
        // A corrupt or incompatible archive must not wedge every future
        // build: discard it and retry the self-contained source path once.
        fmt.eprintf("voila: link against cached runtime failed; " ||
                    "rebuilding it from source\n")
        os.run("rm", ["-rf", rtdir])
        var cfiles = []
        match rt.WriteTo(dir) {
            Ok(fs) => cfiles = fs
            Err(e) => {
                fmt.eprintf("voila: cannot write the runtime into %s\n", dir)
                os.exit(1)
            }
        }
        var retry = []
        each f in fields(CFLAGS) {
            retry.append(f)
        }
        retry.append("-I" || dir)
        retry.append("-o")
        retry.append(out)
        retry.append(cpath)
        each f in cfiles {
            retry.append(f)
        }
        retry.append("-lm")
        retry.append("-lpthread")
        rc = os.run(cc, retry)
    }
    if rc != 0 {
        fmt.eprintf("voila: %s failed (exit %d); the C is in %s\n", cc, rc, dir)
        os.exit(1)
    }
    if keep == "" {
        os.run("rm", ["-rf", dir])
    }
}

// runtime_lib returns the directory holding libvoila.a and the runtime
// headers for this (runtime source, cc, flags) combination, building it on
// first use. Returns "" on any failure — the caller falls back to source.
//
// The key hashes what actually determines the object code: the CONTENT of
// every runtime file (straight from the embedded blob — never a proxy like a
// version string), the cc identity (name + the binary's size and mtime, so an
// in-place compiler upgrade misses), and the flags.
func runtime_lib(cc str) str {
    var h = -3750763034362895579           // FNV-1a offset basis
    let names = rt.Names()
    let data = rt.Data()
    each i, n in names {
        h = fnv_into(h, "\u{0}")
        h = fnv_into(h, n)
        h = fnv_into(h, "\u{0}")
        h = fnv_into(h, data[i])
    }
    h = fnv_into(h, cc)
    h = fnv_into(h, "\u{0}")
    // The cc identity is its VERSION+TARGET output, not the binary's stat:
    // on macOS `/usr/bin/cc` is a sealed xcrun shim whose size and mtime
    // never change when the actual compiler behind it is upgraded, and a
    // universal binary stats identically on two architectures sharing a
    // home directory. No identity means NO cache — a key that silently
    // omits the compiler would happily serve stale objects forever.
    let ccid = cc_identity(cc)
    if ccid == "" { return "" }
    h = fnv_into(h, ccid)
    h = fnv_into(h, "\u{0}")
    h = fnv_into(h, CFLAGS)

    let root = cache_dir()
    ensure_dir(root)
    let final = path.Join(root, "rt-" || fmt.sprintf("%016x", h))
    if os.exists(path.Join(final, "libvoila.a")) { return final }

    // Build in a per-pid directory, then rename into place. If a concurrent
    // build won the race, use its result and discard ours.
    let tmp = final || ".tmp" || host_tag() || "-" || str(os.pid())
    ensure_dir(tmp)
    match rt.WriteTo(tmp) {
        Ok(fs) => fs
        Err(e) => {
            os.run("rm", ["-rf", tmp])
            return ""
        }
    }
    // cc -c f1.c f2.c … drops one .o per file in the cwd; ar bundles them.
    let script = "cd " || shq(tmp) || " && " || shq(cc) ||
                 " " || CFLAGS || " -I. -c *.c && ar rcs libvoila.a *.o" ||
                 " && rm -f *.o *.c"
    if os.run("bash", ["-c", script]) != 0 {
        os.run("rm", ["-rf", tmp])
        return ""
    }
    // Install. `mv tmp final` is NOT the primitive here: when final already
    // exists (a concurrent build won), mv NESTS tmp inside it instead of
    // failing, leaving junk in the winner's directory. The portable atomic
    // claim is mkdir — it fails if the directory exists — and the .a moves
    // LAST, so a reader that gates on libvoila.a never sees a half-installed
    // cache entry. If the content move fails midway, the claim is torn down
    // too; a headers-only final would block this key forever.
    let install = "if mkdir " || shq(final) || " 2>/dev/null; then " ||
                  "mv " || shq(tmp) || "/*.h " || shq(final) || "/ && " ||
                  "mv " || shq(tmp) || "/libvoila.a " || shq(final) || "/ " ||
                  "|| rm -rf " || shq(final) || "; fi; " ||
                  "rm -rf " || shq(tmp)
    os.run("bash", ["-c", install])
    if os.exists(path.Join(final, "libvoila.a")) { return final }
    return ""
}

// cc_identity captures what the compiler IS: its version banner and target
// triple. This is what invalidates the archive when the compiler is
// upgraded in place or the architecture differs. "" when it cannot be
// determined.
func cc_identity(cc str) str {
    let tmp = path.Join(cache_dir(), "ccid-" || str(os.pid()))
    let rc = os.run("bash", ["-c",
        shq(cc) || " --version 2>&1 | head -3 > " || shq(tmp) || "; " ||
        shq(cc) || " -dumpmachine >> " || shq(tmp) || " 2>/dev/null; true"])
    var out = ""
    if rc == 0 {
        match os.read(tmp) {
            Ok(s)  => out = str.trim(s)
            Err(e) => out = ""
        }
    }
    os.remove(tmp)
    return out
}

// shq single-quotes a string for a shell command line.
func shq(s str) str {
    var b = str.Builder{}
    b.write("'")
    each c in s {
        if c == '\'' {
            b.write("'\\''")
        } else {
            b.write(str(c))
        }
    }
    b.write("'")
    return b.done()
}

// find_cc honours $CC, then falls back to the platform's `cc`.
func find_cc() str {
    let env = os.env("CC")
    if env != nil {
        let s = str(env)
        if s != "" { return s }
    }
    return "cc"
}

func ensure_dir(d str) {
    if os.isdir(d) { return }
    // os.mkdir_all EXISTS now, and this is exactly what it is for — but the
    // compiler must stay buildable by a bootstrap as old as MIN_BOOTSTRAP
    // (build.sh), and that binary's runtime has no such native. Calling it
    // here would make voilac uncompilable by the very compilers it must be
    // compilable by. The swap belongs one generation after this ships.
    os.run("mkdir", ["-p", d])
}

// default_out strips the extension: `voilac build hello.voi` gives `hello`.
func default_out(src str) str {
    let b = path.Base(src)
    let e = path.Ext(b)
    if e == "" { return b || ".out" }
    return b[0..len(b) - len(e)]
}

func read(p str) str {
    match os.read(p) {
        Ok(s) => return s
        Err(e) => {
            fmt.eprintf("voila: cannot read %s\n", p)
            os.exit(2)
        }
    }
    return ""
}

// report prints the pre-rendered diagnostics of the two front-end-only verbs
// (`tokens`, `ast`), which run the lexer or the parser alone and so never see
// a diag.Bag.
func report(errs []str) {
    if len(errs) == 0 { return }
    each e in errs {
        fmt.eprintf("%s\n", e)
    }
    os.exit(2)
}

// report_bag renders a bag under the resolved -W policy and prints it.
//
// Every line goes to STDERR and none to stdout. That is not tidiness: stdout
// is `--emit=c`'s and `-S`'s channel, and a warning printed there would land
// in the middle of a C translation unit and corrupt it.
//
// The exit is driven by the count Render hands back rather than by counting
// errors here, because -Werror is exactly what moves a diagnostic across that
// line and only Render has the policy in hand.
func report_bag(b diag.Bag, pol diag.Policy, srcName str) {
    let lines, nerr = b.Render(srcName, pol)
    each l in lines {
        fmt.eprintf("%s\n", l)
    }
    if nerr > 0 { os.exit(2) }
}
