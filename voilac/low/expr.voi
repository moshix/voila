// low/expr.voi — expressions, AST → IR (§12).
//
// A faithful port of internal/ir/lower_expr.go. Registers and labels are
// allocated in exactly the order the Go lowerer allocates them, because the
// oracle diffs the two assembly listings byte for byte: an extra `new_reg`,
// or one taken a line too early, renames every register after it.
package low

use "voilac/ast"
use "voilac/ir"
use "voilac/tok"
use "std/str"

// bin_op maps a binary operator token to its IR opcode; "" = not one.
func bin_op(k int) str {
    if k == tok.PLUS     { return "ADD" }
    if k == tok.MINUS    { return "SUB" }
    if k == tok.STAR     { return "MUL" }
    if k == tok.SLASH    { return "DIV" }
    if k == tok.FLOORDIV { return "IDIV" }
    if k == tok.PERCENT  { return "MOD" }
    if k == tok.POWER    { return "POW" }
    if k == tok.CONCAT   { return "CAT" }
    if k == tok.SHL      { return "SHL" }
    if k == tok.SHR      { return "SHR" }
    if k == tok.AMP      { return "BAND" }
    if k == tok.PIPE     { return "BOR" }
    if k == tok.CARET    { return "BXOR" }
    if k == tok.EQ       { return "CMPEQ" }
    if k == tok.NE       { return "CMPNE" }
    if k == tok.LT       { return "CMPLT" }
    if k == tok.LE       { return "CMPLE" }
    if k == tok.GT       { return "CMPGT" }
    if k == tok.GE       { return "CMPGE" }
    if k == tok.IN       { return "CMPIN" }
    return ""
}

// conv_type reports whether a name is callable as a checked conversion (§3.2).
func conv_type(n str) bool {
    return n == "int" or n == "i8" or n == "i16" or n == "i32" or
           n == "i64" or n == "u8" or n == "u16" or n == "u32" or
           n == "u64" or n == "byte" or n == "float" or n == "f32" or
           n == "dec" or n == "str" or n == "rune" or n == "bool"
}

// is_basic_lit reports whether a node kind is a basic literal — the kinds Go's
// *ast.BasicLit covers. Anything else is not a literal at all.
func is_basic_lit(k int) bool {
    return k == ast.INT or k == ast.FLOAT or k == ast.DEC or k == ast.STR or
           k == ast.RUNE or k == ast.BOOL or k == ast.NILLIT
}

// parse_int_lit reads an integer literal exactly as Go's
// strconv.ParseInt(text, 0, 64) does: base 0 takes the radix from the
// literal's own prefix (0x, 0o, 0b, a leading 0 = octal). ok is false when the
// text does not fit an int64 — the only way a lexed literal can fail.
func parse_int_lit(s str) (int, bool) {
    let n = attempt int(s, 0) else return 0, false
    return n, true
}

// parse_float_lit reads a float literal as Go's strconv.ParseFloat(text, 64).
// Rendering it back with str() is Go's FormatFloat(f, 'g', -1, 64), so the
// constant pool holds the same text on both sides.
func parse_float_lit(s str) (float, bool) {
    let f = attempt float(s) else return 0.0, false
    return f, true
}

impl Lowerer {
    // ------------------------------------------------------------ dispatch

    // lower_expr lowers an expression and returns the operand holding its
    // value.
    func lower_expr(mut self, e int) str throws LowerError {
        if e == 0 {
            throw LowerError{Msg: "internal: nil expression", File: "",
                             Line: self.curLine, Col: 0}
        }
        // An index a locked write computed before taking the lock
        // (stmt.voi, assign_to).
        if e in self.preIdx { return self.preIdx[e] }
        let n = self.T.Get(e)
        let k = n.Kind

        if is_basic_lit(k) {
            return self.lower_lit(e)
        }

        if k == ast.INTERP {
            var parts = []
            // A part is either literal text (a STR node) or an embedded
            // expression; the literal parts go straight to the constant pool.
            each p in n.Kids {
                if self.T.Kind(p) == ast.STR {
                    parts.append(self.M.Constant(ir.CSTR, self.T.Get(p).Sval))
                } else {
                    parts.append(self.lower_expr(p))
                }
            }
            let rd = self.new_reg()
            self.emit(n.Line, "INTERP",
                      [rd, "(" || str.join(parts, ",") || ")"])
            return rd
        }

        if k == ast.IDENT {
            return self.lower_ident_value(e)
        }

        if k == ast.SELF {
            let op = self.lookup("self")
            if op == "" {
                self.fail(e, "`self` used outside a method")
            }
            return op
        }

        if k == ast.UNARY {
            if n.Ival == tok.ARROW {
                let rch = self.lower_expr(self.T.Kid(e, 0))
                let rd = self.new_reg()
                self.emit(n.Line, "RECV", [rd, rch])
                return rd
            }
            let ra = self.lower_expr(self.T.Kid(e, 0))
            let rd = self.new_reg()
            var op = ""
            if n.Ival == tok.MINUS {
                op = "NEG"
            } else if n.Ival == tok.NOT {
                op = "NOT"
            } else if n.Ival == tok.TILDE {
                op = "BNOT"
            }
            let nsz = self.sized_of(e)
            if op == "NEG" and nsz != "" {
                self.emit(n.Line, op, [rd, ra, nsz])
            } else {
                self.emit(n.Line, op, [rd, ra])
            }
            return rd
        }

        if k == ast.BINARY {
            return self.lower_binary(e)
        }

        if k == ast.RANGE {
            if self.T.Kid(e, 0) == 0 or self.T.Kid(e, 1) == 0 {
                self.fail(e, "a range with an open bound (`a..`, `..b`) " ||
                             "is only allowed as a slice index")
            }
            let rlo = self.lower_expr(self.T.Kid(e, 0))
            let rhi = self.lower_expr(self.T.Kid(e, 1))
            var rby = "1"
            if self.T.Kid(e, 2) != 0 {
                rby = self.lower_expr(self.T.Kid(e, 2))
            }
            var mode = "excl"
            if n.Ival2 == 1 { mode = "incl" }
            let rd = self.new_reg()
            self.emit(n.Line, "NEWRANGE", [rd, rlo, rhi, rby, mode])
            return rd
        }

        if k == ast.CALL      { return self.lower_call(e) }
        if k == ast.INDEX {
            // An explicit copy, restored after: under the 0.4.1 bootstrap a
            // map is a reference, and plain assignment would share it.
            var saveSnap = make(map[str]str)
            each sk in keys(self.snapOver) { saveSnap[sk] = self.snapOver[sk] }
            let ri = self.lower_index(e)
            self.snapOver = saveSnap
            return ri
        }
        if k == ast.FIELD     { return self.lower_field(e) }
        if k == ast.COMPOSITE { return self.lower_composite(e) }

        if k == ast.SLICELIT {
            var regs = []
            each el in n.Kids {
                regs.append(self.lower_expr(el))
            }
            let rd = self.new_reg()
            self.emit(n.Line, "NEWSLICE",
                      [rd, "(" || str.join(regs, ",") || ")"])
            // `set[T]{a, b}` is `set([a, b])`: the elements are gathered in
            // a slice and handed to the prelude constructor, which is what
            // drops the duplicates. The element type is erased (§3.7). The
            // `prelude:` spelling names the NATIVE whatever the program
            // declares: a user `func set` must not hijack a literal.
            if n.Ival != 0 and self.T.Kind(n.Ival) == ast.TSET {
                let rs = self.new_reg()
                self.emit(n.Line, "CALL", [rs, "prelude:set", "(" || rd || ")"])
                return rs
            }
            return rd
        }

        if k == ast.MAPLIT {
            // `map[K]V{k: v, …}`: an empty map, then one store per pair, in
            // source order — so a repeated key keeps its LAST value, exactly
            // as the same stores written out by hand would.
            let rd = self.new_reg()
            self.emit(n.Line, "NEWMAP", [rd])
            var i = 0
            while i + 1 < len(n.Kids) {
                let rk = self.lower_expr(n.Kids[i])
                let rv = self.lower_expr(n.Kids[i + 1])
                self.emit(n.Line, "SETIDX", [rd, rk, rv])
                i += 2
            }
            return rd
        }

        if k == ast.IF    { return self.lower_if_expr(e) }
        if k == ast.MATCH { return self.lower_match_expr(e) }

        if k == ast.TUPLE {
            if len(n.Kids) == 0 {
                let ru = self.new_reg()
                self.emit(n.Line, "LOADK",
                          [ru, self.M.Constant(ir.CUNIT, "()")])
                return ru
            }
            var regs = []
            each el in n.Kids {
                regs.append(self.lower_expr(el))
            }
            let rd = self.new_reg()
            self.emit(n.Line, "TUPLE",
                      [rd, "(" || str.join(regs, ",") || ")"])
            return rd
        }

        if k == ast.CLOSURE {
            // A closure answers to its own result: one written as plain `T`
            // cannot carry a failure; none written (inferred) can.
            let cr = n.Ival
            let saveFail = self.canFail
            self.canFail = cr == 0 or self.T.Kind(cr) == ast.TRESULT or
                           self.T.Kind(cr) == ast.TOPTION
            let cnote = "closure" || self.closure_sig_text(e)
            let ps = self.T.Get(self.T.Kid(e, 1)).Kids
            // The closure's written result is what its `return`s store
            // into (a `fn(x int) u8` returns a u8); lower_closure reads it.
            self.pendResult = ""
            if cr != 0 { self.pendResult = self.decl_type(cr) }
            let name = self.lower_closure(e, ps, self.T.Kid(e, 0), cnote,
                                          n.Line)
            self.canFail = saveFail
            let rd = self.new_reg()
            let caps = self.T.Get(self.T.Kid(e, 2)).Kids
            if n.Ival2 == 1 and len(caps) > 0 {
                var cs = []
                each c in caps {
                    cs.append(self.T.Get(c).Sval)
                }
                var margs = self.mkclos_args(rd, name)
                margs.append("own(" || str.join(cs, ",") || ")")
                self.emit(n.Line, "MKCLOS", margs)
            } else {
                self.emit(n.Line, "MKCLOS", self.mkclos_args(rd, name))
                self.note("closure captures enclosing frame by reference")
            }
            // A literal that may escape its task marks its frame chain at
            // once, before the value goes anywhere (vl_closure_escapes).
            if not (e in self.inPlace) { self.emit(n.Line, "ESCAPE", [rd]) }
            return rd
        }

        if k == ast.TRYEXPR {
            let ra = self.lower_expr(self.T.Kid(e, 0))
            let rd = self.new_reg()
            if self.canFail and len(self.finLoops) == 0 {
                // err/nil propagates as the function's result.
                self.emit(n.Line, "TRYP", [rd, ra])
            } else {
                // The function cannot return a failure: it is raised as an
                // exception instead, exactly as `must` does (§8.1).
                //
                // Inside a finally it is raised too, even where the
                // function could return it: propagating would be a hidden
                // `return` out of the finally, discarding the exception or
                // the value in flight (escapes_finally); a raise is what a
                // `throw` there does (§8.2).
                self.emit(n.Line, "MUST", [rd, ra])
            }
            return rd
        }

        if k == ast.MUSTEXPR {
            let ra = self.lower_expr(self.T.Kid(e, 0))
            let rd = self.new_reg()
            self.emit(n.Line, "MUST", [rd, ra])
            return rd
        }

        if k == ast.ATTEMPT {
            // exception → error value (§8.5): a one-expression protected
            // region.
            let catchL = self.new_label()
            let endL = self.new_label()
            let rd = self.new_reg()
            self.emit(n.Line, "EHPUSH", [catchL])
            let ra = self.lower_expr(self.T.Kid(e, 0))
            self.emit(n.Line, "MOVE", [rd, ra])
            self.emit(0, "EHPOP", [])
            self.emit(0, "JUMP", [endL])
            self.mark(catchL)
            let re = self.new_reg()
            self.emit(n.Line, "CATCH", [re])
            self.emit(n.Line, "MOVE", [rd, re])
            self.mark(endL)
            return rd
        }

        if k == ast.ELSEEXPR  { return self.lower_else(e) }
        if k == ast.SPAWNEXPR { return self.lower_spawn(e) }

        self.fail(e, "cannot lower expression " || ast.KindName(k))
        return ""
    }

    // ------------------------------------------------------------ literals

    func lower_lit(mut self, e int) str throws LowerError {
        let n = self.T.Get(e)
        let k = n.Kind
        var kname = ""
        if k == ast.INT {
            let v, ok = parse_int_lit(n.Sval)
            if not ok {
                self.fail(e, "bad integer literal \"" || n.Sval || "\"")
            }
            kname = self.M.Constant(ir.CINT, str(v))
        } else if k == ast.FLOAT {
            let f, ok = parse_float_lit(n.Sval)
            if not ok {
                self.fail(e, "bad float literal \"" || n.Sval || "\"")
            }
            kname = self.M.Constant(ir.CFLOAT, str(f))
        } else if k == ast.DEC {
            kname = self.M.Constant(ir.CDEC, n.Sval)
        } else if k == ast.STR {
            kname = self.M.Constant(ir.CSTR, n.Sval)
        } else if k == ast.RUNE {
            kname = self.M.Constant(ir.CRUNE, n.Sval)
        } else if k == ast.BOOL {
            kname = self.M.Constant(ir.CBOOL, n.Sval)
        } else if k == ast.NILLIT {
            kname = self.M.Constant(ir.CNIL, "nil")
        }
        let rd = self.new_reg()
        self.emit(n.Line, "LOADK", [rd, kname])
        return rd
    }

    // lower_ident_value mirrors the interpreter's evalIdent resolution order
    // (frozen decision 2): locals, then globals, then variants, then the
    // callable names, then `ctx`.
    func lower_ident_value(mut self, e int) str throws LowerError {
        let n = self.T.Get(e)
        let name = n.Sval

        if name in self.snapOver { return self.snapOver[name] }
        let op = self.lookup(name)
        if op != "" {
            // A variable closures capture is read as an OWNED reference —
            // a snapshot — taken under its frame's lock once the frame is
            // concurrent (VARREAD, vl_varread): a writer then finds the
            // value held and copies it rather than write it in place, so
            // the index, length, iteration or native call that follows
            // works on a value nothing changes under it. Never a borrowed
            // load, at any optimisation level: another task may replace
            // the variable's value and release the old one.
            if self.captured_name(name, op) {
                let rs = self.new_reg()
                // A binding never written after it is made (written_in)
                // keeps its first value: no write can replace it, so a
                // plain reference needs no lock ("fixed").
                if name in self.wNames {
                    self.emit(n.Line, "VARREAD", [rs, op])
                } else {
                    self.emit(n.Line, "VARREAD", [rs, op, "fixed"])
                }
                self.lastSnap[name] = rs
                return rs
            }
            return op
        }

        if name in self.globals {
            let rg = self.new_reg()
            self.emit(n.Line, "GETGLB", [rg, name])
            return rg
        }

        if name in self.variants {
            let vi = self.variants[name]
            let rv = self.new_reg()
            if not vi.payload {
                self.emit(n.Line, "NEWENUM", [rv, vi.tag, "()"])
            } else {
                self.emit(n.Line, "LOADFN", [rv, vi.tag])
            }
            return rv
        }

        if name in self.funcs or name in self.prelude or conv_type(name) or
           name in self.structs or name in self.enums or
           name in self.exceptions or name in self.aliases or
           name in self.packages {
            self.refuse_desc_value(e, name)
            let rf = self.new_reg()
            self.emit(n.Line, "LOADFN", [rf, name])
            return rf
        }

        if name == "ctx" {
            let rc = self.new_reg()
            self.emit(n.Line, "GETCTX", [rc])
            return rc
        }

        self.fail(e, "unknown identifier `" || name || "`")
        return ""
    }

    // ------------------------------------------------------------ operators

    func lower_binary(mut self, e int) str throws LowerError {
        let n = self.T.Get(e)
        let opk = n.Ival

        if opk == tok.AND or opk == tok.OR {
            // Short-circuit lowering: the short path loads the constant that
            // the operator already knows the answer to be.
            let rd = self.new_reg()
            let shortL = self.new_label()
            let endL = self.new_label()
            let ra = self.lower_expr(self.T.Kid(e, 0))
            if opk == tok.AND {
                self.emit(n.Line, "JMPF", [ra, shortL])
            } else {
                self.emit(n.Line, "JMPT", [ra, shortL])
            }
            let rb = self.lower_expr(self.T.Kid(e, 1))
            self.emit(n.Line, "MOVE", [rd, rb])
            self.emit(0, "JUMP", [endL])
            self.mark(shortL)
            var val = "false"
            if opk == tok.OR { val = "true" }
            self.emit(n.Line, "LOADK",
                      [rd, self.M.Constant(ir.CBOOL, val)])
            self.mark(endL)
            return rd
        }

        if opk == tok.ARROW {
            // A send in expression position; the statement form is in
            // lower_stmt. Its value is unit.
            let rch = self.lower_expr(self.T.Kid(e, 0))
            let rv = self.lower_expr(self.T.Kid(e, 1))
            self.check_store(self.sized_elem(self.T.Kid(e, 0)),
                             self.T.Kid(e, 1), rv, n.Line)
            self.emit(n.Line, "SEND", [rch, rv])
            let rd = self.new_reg()
            self.emit(n.Line, "LOADK",
                      [rd, self.M.Constant(ir.CUNIT, "()")])
            return rd
        }

        let op = bin_op(opk)
        if op == "" {
            self.fail(e, "cannot lower operator " || tok.Spelling(opk))
        }
        let ra = self.lower_expr(self.T.Kid(e, 0))
        let rb = self.lower_expr(self.T.Kid(e, 1))
        let rd = self.new_reg()
        // Arithmetic whose static type is a SIZED integer carries the type
        // as a fourth operand, and traps outside its range (sized.voi).
        let sz = self.sized_of(e)
        if sz != "" and sized_op(op) {
            self.emit(n.Line, op, [rd, ra, rb, sz])
        } else {
            self.emit(n.Line, op, [rd, ra, rb])
        }
        return rd
    }

    // lower_else implements `expr else alt` (§9.2): failure (err/nil) selects
    // the alternative. A directly-guarded `try` is unwrapped — the failure is
    // handled locally, not propagated (mirrors evalMaybe; frozen decision 4).
    func lower_else(mut self, e int) str throws LowerError {
        let n = self.T.Get(e)
        var inner = self.T.Kid(e, 0)
        if self.T.Kind(inner) == ast.TRYEXPR {
            inner = self.T.Kid(inner, 0)
        }
        let ra = self.lower_expr(inner)
        let rd = self.new_reg()
        let rt = self.new_reg()
        let altL = self.new_label()
        let endL = self.new_label()
        self.emit(n.Line, "ISFAIL", [rt, ra])
        self.emit(n.Line, "JMPT", [rt, altL])
        self.emit(n.Line, "MOVE", [rd, ra])
        self.emit(0, "JUMP", [endL])
        self.mark(altL)
        if n.Ival2 == 1 {
            // The alternative diverges: rd is defined on the success path
            // only.
            self.lower_stmt(self.T.Kid(e, 1))
        } else if n.Ival2 == 2 {
            // A block alternative: its final expression is the value, or it
            // diverges and rd is again defined on the success path only.
            let rb = self.lower_value_block(self.T.Kid(e, 1),
                                            "an `else` block")
            if rb != "" { self.emit(n.Line, "MOVE", [rd, rb]) }
        } else {
            let rv = self.lower_expr(self.T.Kid(e, 1))
            self.emit(n.Line, "MOVE", [rd, rv])
        }
        self.mark(endL)
        return rd
    }

    // lower_else_stmt lowers `f() else { … }` whose value nobody reads: the
    // call runs, and on failure the block runs as a plain block.
    func lower_else_stmt(mut self, e int) throws LowerError {
        let n = self.T.Get(e)
        var inner = self.T.Kid(e, 0)
        if self.T.Kind(inner) == ast.TRYEXPR {
            inner = self.T.Kid(inner, 0)
        }
        let ra = self.lower_expr(inner)
        let rt = self.new_reg()
        let endL = self.new_label()
        self.emit(n.Line, "ISFAIL", [rt, ra])
        self.emit(n.Line, "JMPF", [rt, endL])
        self.lower_body(self.T.Kid(e, 1), false)
        self.mark(endL)
    }

    // ------------------------------------------------------------ calls

    func lower_call(mut self, x int) str throws LowerError {
        let n = self.T.Get(x)
        let line = n.Line
        let fun = self.T.Kid(x, 0)
        let fk = self.T.Kind(fun)
        let args0 = self.T.Get(self.T.Kid(x, 1)).Kids

        // The two constructors the parser leaves as plain calls.
        if fk == ast.IDENT {
            let nm = self.T.Get(fun).Sval
            if nm == "chan" {
                let rd = self.new_reg()
                if len(args0) > 0 {
                    let rc = self.lower_expr(self.T.Kid(args0[0], 0))
                    self.emit(line, "NEWCHAN", [rd, rc])
                } else {
                    self.emit(line, "NEWCHAN", [rd])
                }
                return rd
            }
            if nm == "make" {
                return self.lower_make(x)
            }
        }

        // Method-call path: recv.name(args).
        if fk == ast.FIELD {
            let mname = self.T.Get(fun).Sval
            let base = self.T.Kid(fun, 0)
            if self.T.Kind(base) == ast.IDENT {
                let bn = self.T.Get(base).Sval
                // A name bound in any enclosing scope — or at top level —
                // shadows the package and type tables, so it is a receiver,
                // not a qualifier (see is_pkg_qualifier).
                let bound = self.lookup(bn)
                if self.is_pkg_qualifier(bn) {
                    let pargs = self.desc_call_args(x, bn || "." || mname, 0)
                    let rp = self.new_reg()
                    self.emit(line, "CALL",
                              [rp, bn || "." || mname, pargs])
                    self.flush_mut_args(line)
                    return rp
                }
                // A static method through a TYPE PARAMETER — `T.default()`
                // — or through `Self` in a trait default (traitdesc.voi).
                if bound == "" and (bn in self.curGens or
                                    (bn == "Self" and self.traitSelf != 0)) {
                    return self.lower_static_param(x, bn, mname)
                }
                // An associated function on a type: `Point.origin()` (§10)
                // — a struct, an enum or an exception, a NEWTYPE (which takes
                // impls of its own, §3.8), or any type an impl block gave a
                // method of that name (`impl Default for int`).
                if bound == "" and (bn in self.structs or bn in self.enums or
                                    bn in self.exceptions or
                                    bn in self.newtypes or
                                    (bn || "." || mname) in self.funcParams) {
                    let targs2 = self.lower_args(x)
                    let rt = self.new_reg()
                    self.emit(line, "CALL",
                              [rt, bn || "." || mname, targs2])
                    return rt
                }
            }
            // `Wrap[int].make()`: a static method of an INSTANTIATED generic
            // type. Generics are erased (§3.7), so the type arguments say
            // nothing the call needs, and it is `Wrap.make()`.
            if self.T.Kind(base) == ast.INDEX {
                let ib = self.T.Kid(base, 0)
                if self.T.Kind(ib) == ast.IDENT {
                    let tn = self.T.Get(ib).Sval
                    if self.lookup(tn) == "" and not (tn in self.globals) and
                       (tn in self.structs or tn in self.enums or
                        tn in self.newtypes) {
                        let sargs = self.lower_args(x)
                        let rs = self.new_reg()
                        self.emit(line, "CALL", [rs, tn || "." || mname, sargs])
                        return rs
                    }
                }
            }
            // `xs.append(v)` on a `[]u8`: every appended value is a store
            // into a u8, checked like any other (sized.voi).
            if mname == "append" {
                let ra = self.lower_sized_append(x, base)
                if ra != "" { return ra }
            }
            // `L.set(v)`: a Box's set is copy-on-write (boxcow.voi).
            if mname == "set" {
                let rs = self.lower_box_set(x, base)
                if rs != "" { return rs }
            }
            // A method some declaration writes as `mut self` writes its
            // receiver in place, so an lvalue receiver is made unique first
            // (boxcow.voi): `var b = a; b.inc()` must not change `a`.
            var robj = ""
            var margs = ""
            var vlock = ""
            var copyBack = false
            var preAdded = []
            let pmark = len(self.pathTemps)
            // `p.run(f)` on a struct with a FIELD `run` calls the function
            // the field holds: no method, whatever another type declares.
            let rty = self.st(base)
            let fieldCall = rty != "" and (rty || "|" || mname) in self.fieldTy
            // `xs.map(fn …)` on a builtin collection runs the literal before
            // it returns, on this task: it does not escape.
            if coll_type(rty) and sync_builtin(mname) {
                each a in self.T.Get(self.T.Kid(x, 1)).Kids {
                    let av = self.T.Kid(a, 0)
                    if self.T.Kind(av) == ast.CLOSURE { self.inPlace.add(av) }
                }
            }
            if mname in self.mutMethods and not fieldCall {
                // The ARGUMENTS first, each holding its own reference, and
                // only then the receiver made unique — so `a.kids.append(a)`
                // counts `a` twice and appends a copy, never `a` into itself
                // (the order `L.set(v)` already uses, boxcow.voi).
                margs = self.lower_set_args(x)
                // A collection's own growing or reordering method, on a
                // variable closures capture, runs under the variable's frame
                // lock, like a store (boxcow.voi, var_root): a closure handed
                // to tasks that calls it must not copy the receiver on
                // another's temporaries and lose an append. Only these
                // runtime methods: user code never runs under a variable's
                // lock (it could wait on a task that wants another one).
                // (An unknown static type is taken for a collection: a
                // user method of one of these names is rare, and it is the
                // collections' growth that must never race.)
                if (rty == "" or coll_type(rty)) and lock_writer(mname) {
                    vlock = self.var_root(base)
                }
                // An index on the receiver's path that runs Voilà code is
                // computed before the lock (stmt.voi pre_index).
                if vlock != "" or self.var_root(base) != "" {
                    preAdded = self.pre_index(base)
                }
                if vlock != "" { self.emit(line, "VARLOCK", [vlock]) }
                // Any other writing method on a variable closures capture —
                // Voilà code, or sort_by's key, which run unlocked — works
                // on a PRIVATE copy of the receiver, taken under the
                // variable's lock and stored back under it when the call
                // returns (COPY-IN, COPY-OUT): it writes in place, and a
                // task reading the variable meanwhile holds a snapshot
                // nothing may write in place (vl_varread).
                let croot = self.var_root(base)
                // (pre_index has computed every index that calls code, so
                // the path can be walked again for the copy-out.)
                if vlock == "" and croot != "" {
                    copyBack = true
                    self.emit(line, "VARLOCK", [croot])
                    robj = self.private_copy(self.recv_path(base), croot, line)
                    self.emit(line, "VARUNLOCK", [croot])
                } else {
                    robj = self.recv_path(base)
                }
            } else {
                robj = self.lower_expr(base)
                margs = self.lower_args(x)
            }
            let rd = self.new_reg()
            // A receiver of a SIZED integer type is an `int` at run time;
            // its own impl (or inherited default) is tried first.
            let sz = self.sized_of(base)
            if sz != "" {
                self.emit(line, "CALLM", [rd, robj, mname, margs, sz])
            } else {
                self.emit(line, "CALLM", [rd, robj, mname, margs])
            }
            // The path's temporaries go first, so a copy-out walking the path
            // again counts only real holders and copies nothing in a frame
            // no closure has captured.
            self.kill_path(pmark, line)
            if copyBack {
                // Copy-out: the receiver as the method left it, stored back
                // where it came from (assign_to takes the variable's lock).
                // Without a copy-in it is the very value already there.
                self.assign_to(base, robj, tok.ASSIGN, line, 0)
            }
            if vlock != "" { self.emit(line, "VARUNLOCK", [vlock]) }
            self.drop_pre(preAdded)
            return rd
        }

        // Named callees.
        if fk == ast.IDENT {
            let name = self.T.Get(fun).Sval

            var op = self.lookup(name)
            if op != "" {
                // A captured closure is called through its snapshot: another
                // task may assign the variable and release the old closure.
                if self.captured_name(name, op) {
                    op = self.lower_ident_value(fun)
                }
                let cargs = self.lower_args(x)
                let rc = self.new_reg()
                self.emit(line, "CALLR", [rc, op, cargs])
                return rc
            }

            if conv_type(name) or name in self.aliases {
                // A checked conversion (§3.2): int(x), int(s, 16), dec("…").
                // A NEWTYPE converts by name — the runtime wraps the value
                // (§3.8) — while an ALIAS is its target: `UserID(5)` for
                // `type UserID = int` is `int(5)`, and an alias of a type
                // that is not a conversion target is the value unchanged.
                if len(args0) == 0 {
                    self.fail(x, name || "() needs an argument")
                }
                let target = self.alias_target(name)
                if not conv_type(target) and not (target in self.newtypes) {
                    return self.lower_expr(self.T.Kid(args0[0], 0))
                }
                let ra = self.lower_expr(self.T.Kid(args0[0], 0))
                let rd = self.new_reg()
                if len(args0) > 1 {
                    let rb = self.lower_expr(self.T.Kid(args0[1], 0))
                    self.emit(line, "CONV", [rd, target, ra, rb])
                } else {
                    self.emit(line, "CONV", [rd, target, ra])
                }
                return rd
            }

            if name in self.variants {
                let vi = self.variants[name]
                let vargs = self.lower_args(x)
                let rv = self.new_reg()
                self.emit(line, "NEWENUM", [rv, vi.tag, vargs])
                return rv
            }

            if name in self.structs or name in self.enums or
               name in self.exceptions {
                self.fail(x, "type `" || name ||
                             "` cannot be called; use a composite literal")
            }

            // The prelude's `append(xs, v…)` writes its first argument in
            // place, exactly as `xs.append(v…)` does: that slice is made
            // unique where it lives first (boxcow.voi).
            if name == "append" and not (name in self.funcs) and
               name in self.prelude and len(args0) > 0 {
                var plain = true
                each a in args0 {
                    let an = self.T.Get(a)
                    if an.Ival == 1 or an.Sval != "" { plain = false }
                }
                if plain {
                    // The values first, each owning a reference (see the
                    // method form), then the slice made unique.
                    let pmark = len(self.pathTemps)
                    var vals = []
                    var ai = 1
                    while ai < len(args0) {
                        let av = self.T.Kid(args0[ai], 0)
                        let rv = self.own_value(av, self.lower_expr(av), line)
                        self.mark_named(rv)
                        vals.append(rv)
                        ai += 1
                    }
                    var aregs = [self.recv_path(self.T.Kid(args0[0], 0))]
                    each rv in vals { aregs.append(rv) }
                    let ra = self.new_reg()
                    self.emit(line, "CALL", [ra, name,
                                             "(" || str.join(aregs, ",") || ")"])
                    self.kill_path(pmark, line)
                    return ra
                }
            }

            if name in self.funcs or name in self.prelude {
                let fargs = self.desc_call_args(x, name, 0)
                let rf = self.new_reg()
                self.emit(line, "CALL", [rf, name, fargs])
                self.flush_mut_args(line)
                return rf
            }

            self.fail(x, "unknown function `" || name || "`")
            return ""
        }

        // A generic instantiation called directly: cell[int](0),
        // json.decode[T](s).
        if fk == ast.INDEX {
            let fname, ok = self.generic_func_name(fun)
            if ok {
                // The callee's own name is the instantiation's base:
                // `make[Point]` calls `make`, `geom.make[P]` `geom.make`.
                let callee = fname[0..str.index(fname, "[")]
                let gargs = self.desc_call_args(x, callee, fun)
                let rg = self.new_reg()
                self.emit(line, "CALL", [rg, fname, gargs])
                self.flush_mut_args(line)
                return rg
            }
        }

        // Anything else: evaluate the callee, call indirectly. A closure
        // literal called at once runs in place (closure_escapes).
        if fk == ast.CLOSURE { self.inPlace.add(fun) }
        let rfn = self.lower_expr(fun)
        let args = self.lower_args(x)
        let rd = self.new_reg()
        self.emit(line, "CALLR", [rd, rfn, args])
        return rd
    }

    // lower_args renders a call's argument list. Named arguments are resolved
    // to their PARAMETER POSITION here, while the callee's signature is in
    // scope — downstream consumers then only ever see positional arguments.
    func lower_args(mut self, x int) str throws LowerError {
        return self.lower_args_for(x, "")
    }

    // newtype_arg converts an untyped literal or a closure literal passed to
    // a NEWTYPE parameter of a known top-level function, as a store into a
    // newtype location converts one (§3.8, sized.voi's store_value).
    func newtype_arg(mut self, callee str, i int, v int,
                     r str) str throws LowerError {
        if not (callee in self.funcDecl) { return r }
        let ps = self.T.Get(self.T.Kid(self.funcDecl[callee], 1)).Kids
        if i >= len(ps) { return r }
        let pn = self.T.Get(ps[i])
        if (pn.Ival2 & 16) != 0 or pn.Ival == 0 { return r }
        let want = self.decl_type(pn.Ival)
        // Only a newtype: a sized parameter is range-checked on entry to
        // the callee (sized.voi), and a second check here would move it.
        if not (want in self.newtypes) { return r }
        return self.store_value(want, v, r, pn.Line)
    }

    func lower_args_for(mut self, x int, callee str) str throws LowerError {
        var regs = []
        var names = []
        var spreads = []
        var hasNamed = false
        each a in self.T.Get(self.T.Kid(x, 1)).Kids {
            let an = self.T.Get(a)
            var r = self.lower_expr(self.T.Kid(a, 0))
            if an.Sval == "" and an.Ival != 1 and not hasNamed {
                r = self.newtype_arg(callee, len(regs), self.T.Kid(a, 0), r)
            }
            regs.append(r)
            names.append(an.Sval)
            spreads.append(an.Ival == 1)
            if an.Sval != "" { hasNamed = true }
        }

        if hasNamed {
            // A named argument to a callee we cannot see (a closure, a
            // builtin) has no defined position: reject rather than guess.
            if not (callee in self.funcParams) {
                self.fail(x,
                          "named arguments require a statically known callee")
            }
            let params = self.funcParams[callee]
            var slots = []
            each p in params { slots.append("") }
            var next = 0
            each i, r in regs {
                if spreads[i] {
                    self.fail(x, "cannot mix a spread with named arguments")
                }
                if names[i] == "" {
                    if next >= len(slots) {
                        self.fail(x, "too many positional arguments")
                    }
                    slots[next] = r
                    next += 1
                } else {
                    var at = -1
                    each j, p in params {
                        if p == names[i] { at = j }
                    }
                    if at < 0 {
                        self.fail(x, "no parameter named `" || names[i] || "`")
                    }
                    if slots[at] != "" {
                        self.fail(x, "parameter `" || names[i] ||
                                     "` supplied twice")
                    }
                    slots[at] = r
                }
            }
            // Trim the trailing empties (defaulted params); a HOLE is not
            // expressible, so a gap before a supplied one is an error.
            var end = len(slots)
            while end > 0 and slots[end - 1] == "" {
                end -= 1
            }
            for i in 0..end {
                if slots[i] == "" {
                    self.fail(x, "parameter `" || params[i] ||
                                 "` must be supplied when a later one is")
                }
            }
            return "(" || str.join(slots[0..end], ",") || ")"
        }

        var parts = []
        each i, r in regs {
            if spreads[i] {
                parts.append(r || "...")
            } else {
                parts.append(r)
            }
        }
        return "(" || str.join(parts, ",") || ")"
    }

    func lower_make(mut self, x int) str throws LowerError {
        let n = self.T.Get(x)
        let targs = self.T.Get(self.T.Kid(x, 2)).Kids
        if len(targs) == 0 {
            self.fail(x, "make requires a type argument")
        }
        let rd = self.new_reg()
        let line = n.Line
        let args0 = self.T.Get(self.T.Kid(x, 1)).Kids
        let ty = targs[0]
        let tk = self.T.Kind(ty)
        if tk == ast.TSLICE {
            if len(args0) > 0 {
                let rn = self.lower_expr(self.T.Kid(args0[0], 0))
                // The size form: zero-filled.
                self.emit(line, "NEWSLICE", [rd, "[" || rn || "]"])
            } else {
                self.emit(line, "NEWSLICE", [rd, "()"])
            }
        } else if tk == ast.TMAP {
            self.emit(line, "NEWMAP", [rd])
        } else if tk == ast.TSET {
            self.emit(line, "NEWSET", [rd])
        } else if tk == ast.TCHAN {
            if len(args0) > 0 {
                let rc = self.lower_expr(self.T.Kid(args0[0], 0))
                self.emit(line, "NEWCHAN", [rd, rc])
            } else {
                self.emit(line, "NEWCHAN", [rd])
            }
        } else {
            self.fail(x, "cannot make " || self.short_type(ty))
        }
        return rd
    }

    // generic_func_name recognizes an fn[T] instantiation (mirrors evalIndex):
    // the base resolves to a function-ish name and the index is a type name.
    func generic_func_name(mut self, ix int) (str, bool) {
        let idx = self.T.Kid(ix, 1)
        var iname = ""
        if self.T.Get(ix).Ival2 == 2 {
            // Type arguments read by the TYPE grammar (`f[[]int, ?str]`):
            // the kids are type nodes, rendered as written.
            var tas = []
            var i = 1
            while i < self.T.NKids(ix) {
                tas.append(self.short_type(self.T.Kid(ix, i)))
                i += 1
            }
            iname = str.join(tas, ",")
        } else if self.T.Kind(idx) != ast.IDENT {
            return "", false
        } else if self.T.NKids(ix) > 2 {
            // `mk[str, int]` — several type arguments. A subscript has
            // exactly one index, so this can only be an instantiation, and
            // every argument is taken as the type name it is written as
            // (generic parameters included). Types are erased (§3.7): the
            // name only has to be well-formed for cg to strip.
            var targs = []
            var i = 1
            while i < self.T.NKids(ix) {
                let a = self.T.Kid(ix, i)
                if self.T.Kind(a) != ast.IDENT { return "", false }
                targs.append(self.T.Get(a).Sval)
                i += 1
            }
            iname = str.join(targs, ",")
        } else {
            iname = self.T.Get(idx).Sval
            // The enclosing function's own type parameter is a type here
            // too: `make[T]()` forwards T (traitdesc.voi).
            if not (conv_type(iname) or iname in self.structs or
                    iname in self.enums or iname in self.aliases or
                    (iname in self.curGens and self.lookup(iname) == "")) {
                return "", false
            }
        }

        let base = self.T.Kid(ix, 0)
        let bk = self.T.Kind(base)
        if bk == ast.IDENT {
            let bn = self.T.Get(base).Sval
            if self.lookup(bn) != "" {
                return "", false
            }
            if bn in self.funcs or bn in self.prelude {
                return bn || "[" || iname || "]", true
            }
        } else if bk == ast.FIELD {
            let pkg = self.T.Kid(base, 0)
            if self.T.Kind(pkg) == ast.IDENT {
                let pn = self.T.Get(pkg).Sval
                if self.is_pkg_qualifier(pn) {
                    return pn || "." || self.T.Get(base).Sval || "[" ||
                           iname || "]", true
                }
            }
        }
        return "", false
    }

    func lower_index(mut self, x int) str throws LowerError {
        let n = self.T.Get(x)
        // A generic instantiation as a VALUE: `cell[int]`, not called here.
        let fname, ok = self.generic_func_name(x)
        if ok {
            self.refuse_desc_value(x, fname[0..str.index(fname, "[")])
            let rf = self.new_reg()
            self.emit(n.Line, "LOADFN", [rf, fname])
            return rf
        }
        // Not an instantiation the lowerer recognises, of a function that
        // needs its type arguments at run time: say so, rather than let the
        // base fall through to "cannot be used as a value".
        let b0 = self.T.Kid(x, 0)
        if self.T.Kind(b0) == ast.IDENT and self.T.Get(b0).Sval in self.descOf and
           self.lookup(self.T.Get(b0).Sval) == "" {
            let bn0 = self.T.Get(b0).Sval
            self.fail(x, "write `" || bn0 || "`'s type arguments as type " ||
                "names (`" || bn0 || "[Point]`); an instantiated type " ||
                "argument such as `W[int]` is not accepted here (§3.7)")
        }
        if self.T.NKids(x) > 2 or n.Ival2 == 2 {
            self.fail(x, "a subscript takes one index; several bracketed " ||
                         "arguments must name a generic function's types")
        }
        self.lastSnap = make(map[str]str)
        let rc = self.lower_expr(self.T.Kid(x, 0))
        let idx = self.T.Kid(x, 1)
        // `out[len(out) - 1]`, `bag.xs[len(bag.xs) - 1]` on a variable
        // closures capture: the index reads the SAME snapshot of the root
        // the subscript's path was read from, so another task's append in
        // between cannot put the index past the snapshot's end. Only when
        // nothing in the index runs Voilà code (`len` aside): otherwise it
        // may change the variable, and must see that.
        var b1 = self.T.Kid(x, 0)
        while self.T.Kind(b1) == ast.FIELD or
              (self.T.Kind(b1) == ast.INDEX and self.T.NKids(b1) == 2) {
            b1 = self.T.Kid(b1, 0)
        }
        if self.T.Kind(b1) == ast.IDENT {
            let bn = self.T.Get(b1).Sval
            if bn in self.lastSnap and len_only(self.T, idx) and
               mentions(self.T, idx, bn) {
                self.snapOver[bn] = self.lastSnap[bn]
            }
        }
        if self.T.Kind(idx) == ast.RANGE and
           (self.T.Kid(idx, 0) == 0 or self.T.Kid(idx, 1) == 0) {
            // An open-ended slice, `s[10..]` / `s[..3]` / `s[..]`: a missing
            // lower bound is 0 and a missing upper one is len(s), read off
            // the already-evaluated collection so it is evaluated once —
            // by the NATIVE len (`prelude:`), never a user `func len`.
            let rn = self.T.Get(idx)
            var rlo = ""
            if self.T.Kid(idx, 0) == 0 {
                rlo = self.new_reg()
                self.emit(n.Line, "LOADK", [rlo, self.M.Constant(ir.CINT, "0")])
            } else {
                rlo = self.lower_expr(self.T.Kid(idx, 0))
            }
            var rhi = ""
            var mode = "excl"
            if self.T.Kid(idx, 1) == 0 {
                rhi = self.new_reg()
                self.emit(n.Line, "CALL", [rhi, "prelude:len", "(" || rc || ")"])
            } else {
                rhi = self.lower_expr(self.T.Kid(idx, 1))
                if rn.Ival2 == 1 { mode = "incl" }
            }
            let rr = self.new_reg()
            self.emit(n.Line, "NEWRANGE", [rr, rlo, rhi, "1", mode])
            let ro = self.new_reg()
            self.emit(n.Line, "SLICE", [ro, rc, rr])
            return ro
        }
        if self.T.Kind(idx) == ast.RANGE {
            let rr = self.lower_expr(idx)
            let rs = self.new_reg()
            // A range slice THROWS RangeError…
            self.emit(n.Line, "SLICE", [rs, rc, rr])
            return rs
        }
        let ri = self.lower_expr(idx)
        let rd = self.new_reg()
        // …while a scalar index out of bounds ABORTS.
        self.emit(n.Line, "INDEX", [rd, rc, ri])
        return rd
    }

    // is_pkg_qualifier reports whether a bare identifier in the base position
    // of `X.name` is a PACKAGE qualifier rather than a value to take a field
    // or a method from.
    //
    // Both shadowing tests matter, and the second one is the one that bites.
    // A local binding shadowing a package name is obvious. A top-level GLOBAL
    // is not: `var path = "/etc"` followed by `path.upper()` is an ordinary
    // method call on a str, and it WAS one until `path` joined PackageNames —
    // after which it lowered to a package call and died in the backend, which
    // is a working program broken by a table entry. Globals are resolved
    // separately from the scope chain (lower_ident_value consults
    // self.globals AFTER lookup and BEFORE the package table), so `lookup`
    // does not see them and they have to be asked about here by name. This is
    // that same precedence applied to the qualified form.
    func is_pkg_qualifier(mut self, bn str) bool {
        if self.lookup(bn) != "" { return false }
        if bn in self.globals { return false }
        return bn in self.packages
    }

    func lower_field(mut self, x int) str throws LowerError {
        let n = self.T.Get(x)
        let base = self.T.Kid(x, 0)
        // A package member as a value: fmt.printf passed around.
        if self.T.Kind(base) == ast.IDENT {
            let bn = self.T.Get(base).Sval
            if self.is_pkg_qualifier(bn) {
                // A Voilà-SOURCE std package (std/csv, std/net, std/path,
                // std/sync, std/test) is grafted into the program, so its
                // declarations are ordinary globals carrying the dotted name.
                // A CONSTANT is reachable no other way: the call path already
                // resolves `path.base(…)` against the grafted function, but a
                // bare `path.SEP` would become a LOADFN of a native the
                // runtime has never heard of — a program that passed
                // `check` and died in cgen, which is the one inconsistency
                // the `check` verb exists to prevent.
                let dotted = bn || "." || n.Sval
                if dotted in self.globals {
                    let rg = self.new_reg()
                    self.emit(n.Line, "GETGLB", [rg, dotted])
                    return rg
                }
                let rp = self.new_reg()
                self.emit(n.Line, "LOADFN", [rp, dotted])
                return rp
            }
        }
        let ro = self.lower_expr(base)
        let rd = self.new_reg()
        self.emit(n.Line, "FIELD", [rd, ro, n.Sval])
        return rd
    }

    func lower_composite(mut self, x int) str throws LowerError {
        let n = self.T.Get(x)
        let tn = self.T.Get(n.Ival)      // the TNAMED type node
        var name = tn.Sval               // already "Pkg.Name" when qualified
        if len(tn.Kids) > 0 {
            var targs = []
            each a in tn.Kids {
                targs.append(self.short_type(a))
            }
            name = name || "[" || str.join(targs, ",") || "]"
        }

        var fields = []
        // A field of a sized type is checked as any other store is.
        let sname = tn.Sval
        var order = []
        if sname in self.fieldOrder { order = self.fieldOrder[sname] }
        each fi, f in n.Kids {
            let fn2 = self.T.Get(f)
            var r = self.lower_expr(self.T.Kid(f, 0))
            var fname = fn2.Sval
            if fname == "" and fi < len(order) { fname = order[fi] }
            let fkey = sname || "|" || fname
            if fkey in self.fieldTy {
                r = self.store_value(self.fieldTy[fkey], self.T.Kid(f, 0), r,
                                     n.Line)
            }
            if fn2.Sval != "" {
                fields.append(fn2.Sval || ":" || r)
            } else {
                fields.append(r)
            }
        }

        let rd = self.new_reg()
        // The exception table is keyed by the type's declared name — which, in
        // a flattened program, is the QUALIFIED one (`low.LowerError`). Keying
        // it by the bare name silently lowers every package-level exception as
        // a plain struct, and `throw` then aborts.
        var op = "NEWSTRUCT"
        if tn.Sval in self.exceptions { op = "NEWEXC" }
        self.emit(n.Line, op,
                  [rd, name, "(" || str.join(fields, ",") || ")"])
        return rd
    }

    // lower_spawn: three forms (frozen decision; mirrors evalSpawn).
    func lower_spawn(mut self, x int) str throws LowerError {
        let n = self.T.Get(x)
        let line = n.Line
        let payload = self.T.Kid(x, 0)
        let isBlock = n.Ival2 == 1

        // Form 1: spawn f(a, b) with a directly-named callee — the callee and
        // the arguments evaluate NOW, in the parent task.
        if not isBlock and self.T.Kind(payload) == ast.CALL {
            let fun = self.T.Kid(payload, 0)
            let fk = self.T.Kind(fun)
            if fk == ast.IDENT {
                let fname = self.T.Get(fun).Sval
                if self.lookup(fname) == "" and
                   (fname in self.funcs or fname in self.prelude) {
                    // With its type descriptors, if it takes any
                    // (traitdesc.voi).
                    let args = self.desc_call_args(payload, fname, 0)
                    let rd = self.new_reg()
                    self.emit(line, "SPAWN", [rd, fname, args])
                    self.drop_mut_args()
                    return rd
                }
            }
            if fk == ast.FIELD {
                let base = self.T.Kid(fun, 0)
                if self.T.Kind(base) == ast.IDENT {
                    let bn = self.T.Get(base).Sval
                    if self.is_pkg_qualifier(bn) {
                        let args = self.desc_call_args(payload, bn || "." ||
                                                       self.T.Get(fun).Sval,
                                                       0)
                        let rd = self.new_reg()
                        self.emit(line, "SPAWN",
                                  [rd, bn || "." || self.T.Get(fun).Sval,
                                   args])
                        self.drop_mut_args()
                        return rd
                    }
                }
            }
        }

        // Forms 2 and 3: a block body, or any other expression — a synthetic
        // closure run by the task. (Stage-0 listing note: for non-simple calls
        // the arguments evaluate at task start, inside the closure.)
        var body = 0
        if isBlock {
            body = payload
        } else {
            // Wrap the call in `{ call }` so the closure's trailing expression
            // becomes the task's value, exactly as the Go lowerer's synthetic
            // Block{ExprStmt{Call}} does.
            let es = self.T.Add(ast.EXPRSTMT, n.Line, n.Col, 0, 0, "",
                                [payload])
            body = self.T.Add(ast.BLOCK, n.Line, n.Col, 0, 0, "", [es])
            self.note("spawn args evaluate at task start in this form")
        }
        let saveFail = self.canFail
        self.canFail = true             // a task's body returns to the task
        let name = self.lower_closure(x, [], body, "spawn body", line)
        self.canFail = saveFail
        let rc = self.new_reg()
        self.emit(line, "MKCLOS", self.mkclos_args(rc, name))
        self.emit(line, "ESCAPE", [rc])          // a task's body escapes
        let rd = self.new_reg()
        self.emit(line, "SPAWNR", [rd, rc])
        return rd
    }

    // alias_target follows `type X = T` declarations to the type they name
    // (a chain of them, bounded so a cyclic declaration cannot hang the
    // lowerer); any other name is returned as it is.
    func alias_target(self, name str) str {
        var t = name
        var hops = 0
        while t in self.aliasTo and hops < 32 {
            t = self.aliasTo[t]
            hops += 1
        }
        return t
    }

    // ------------------------------------------------------------ rendering

    // short_type renders a type expression compactly for operands and DSECTs.
    func short_type(self, te int) str {
        if te == 0 { return "?" }
        let n = self.T.Get(te)
        let k = n.Kind

        if k == ast.TNAMED {
            var s = n.Sval
            if len(n.Kids) > 0 {
                var args = []
                each a in n.Kids {
                    args.append(self.short_type(a))
                }
                s = s || "[" || str.join(args, ",") || "]"
            }
            return s
        }
        if k == ast.TOPTION {
            return "?" || self.short_type(self.T.Kid(te, 0))
        }
        if k == ast.TRESULT {
            return self.short_type(self.T.Kid(te, 0)) || "!"
        }
        if k == ast.TSLICE {
            return "[]" || self.short_type(self.T.Kid(te, 0))
        }
        if k == ast.TMAP {
            return "map[" || self.short_type(self.T.Kid(te, 0)) || "]" ||
                   self.short_type(self.T.Kid(te, 1))
        }
        if k == ast.TSET {
            return "set[" || self.short_type(self.T.Kid(te, 0)) || "]"
        }
        if k == ast.TCHAN {
            return "chan[" || self.short_type(self.T.Kid(te, 0)) || "]"
        }
        if k == ast.TBOX {
            var kind = "shared"
            if n.Ival2 == 1 {
                kind = "cell"
            } else if n.Ival2 == 2 {
                kind = "weak"
            }
            return kind || "[" || self.short_type(self.T.Kid(te, 0)) || "]"
        }
        if k == ast.TFN {
            return "fn(...)"
        }
        if k == ast.TTUPLE {
            var es = []
            each el in n.Kids {
                es.append(self.short_type(el))
            }
            return "(" || str.join(es, ",") || ")"
        }
        if k == ast.TBORROW {
            return "&" || self.short_type(self.T.Kid(te, 0))
        }
        return "?"
    }

    // expr_text renders small expressions (literals, negations) as text for
    // pattern operands and DSECT default commentary.
    func expr_text(self, e int) str {
        if e == 0 { return "..." }
        let n = self.T.Get(e)
        let k = n.Kind
        if k == ast.STR  { return "\"" || n.Sval || "\"" }
        if k == ast.RUNE { return "'" || n.Sval || "'" }
        if k == ast.DEC  { return n.Sval || "d" }
        if is_basic_lit(k) { return n.Sval }
        if k == ast.UNARY {
            return "-" || self.expr_text(self.T.Kid(e, 0))
        }
        if k == ast.IDENT    { return n.Sval }
        if k == ast.SLICELIT { return "[...]" }
        if k == ast.CALL {
            return self.expr_text(self.T.Kid(e, 0)) || "(...)"
        }
        if k == ast.FIELD {
            return self.expr_text(self.T.Kid(e, 0)) || "." || n.Sval
        }
        return "..."
    }

    // func_sig renders a declaration signature for the CSECT header comment.
    func func_sig(self, d int) str {
        let n = self.T.Get(d)
        var ps = []
        if (n.Ival2 & 1) != 0 {
            if (n.Ival2 & 2) != 0 {
                ps.append("mut self")
            } else if (n.Ival2 & 4) != 0 {
                ps.append("own self")
            } else {
                ps.append("self")
            }
        }
        each p in self.T.Get(self.T.Kid(d, 1)).Kids {
            let pn = self.T.Get(p)
            var s = pn.Sval
            let mode = pn.Ival2 & 3
            if mode == ast.MODE_MUT {
                s = "mut " || s
            } else if mode == ast.MODE_OWN {
                s = "own " || s
            }
            if (pn.Ival2 & 16) != 0 { s = s || " ..." }
            if pn.Ival != 0 {
                s = s || " " || self.short_type(pn.Ival)
            }
            ps.append(s)
        }
        var sig = "func " || n.Sval || "(" || str.join(ps, ", ") || ")"

        let res = self.T.Get(self.T.Kid(d, 2)).Kids
        if len(res) == 1 {
            sig = sig || " " || self.short_type(res[0])
        } else if len(res) > 1 {
            var rs = []
            each r in res {
                rs.append(self.short_type(r))
            }
            sig = sig || " (" || str.join(rs, ", ") || ")"
        }
        if (n.Ival2 & 8) != 0 { sig = sig || " nothrow" }
        return sig
    }

    func closure_sig_text(self, x int) str {
        var ps = []
        each p in self.T.Get(self.T.Kid(x, 1)).Kids {
            ps.append(self.T.Get(p).Sval)
        }
        return "(" || str.join(ps, ", ") || ")"
    }

    // ------------------------------------------------------------ patterns

    // pat_str renders a structured pattern (an arena index) as a PMATCH
    // operand.
    func pat_str(self, p int) str {
        return "'" || self.pat_inner(p) || "'"
    }

    func pat_inner(self, p int) str {
        let pt = self.M.Pats[p]
        if pt.Kind == ir.PAT_WILD { return "_" }
        if pt.Kind == ir.PAT_NIL  { return "nil" }
        if pt.Kind == ir.PAT_LIT  { return pt.Text }
        if pt.Kind == ir.PAT_BIND { return pt.Name }
        if pt.Kind == ir.PAT_RANGE {
            var op = ".."
            if pt.Name == "=" { op = "..=" }
            return self.pat_inner(pt.Elems[0]) || op ||
                   self.pat_inner(pt.Elems[1])
        }
        if pt.Kind == ir.PAT_FIELD {
            return pt.Name || ":" || self.pat_inner(pt.Elems[0])
        }
        if pt.Kind == ir.PAT_OR or pt.Kind == ir.PAT_STRUCT or
           pt.Kind == ir.PAT_TUPLE {
            var subs = []
            each el in pt.Elems {
                subs.append(self.pat_inner(el))
            }
            if pt.Kind == ir.PAT_OR { return str.join(subs, "|") }
            if pt.Kind == ir.PAT_TUPLE {
                return "(" || str.join(subs, ",") || ")"
            }
            return pt.Name || "\{" || str.join(subs, ",") || "}"
        }
        if pt.Kind == ir.PAT_VARIANT {
            if len(pt.Elems) == 0 { return pt.Name }
            var subs = []
            each el in pt.Elems {
                subs.append(self.pat_inner(el))
            }
            return pt.Name || "(" || str.join(subs, ",") || ")"
        }
        return "?"
    }

    // literal_value normalizes a literal pattern's value: the kind, and the
    // exact text the constant pool should hold (decoded, never re-quoted, and
    // never re-parsed from the rendered form — `0xd` is not `13` once it has
    // been printed).
    func literal_value(self, e int) (int, str) {
        var lit = e
        var neg = false
        let n0 = self.T.Get(e)
        if n0.Kind == ast.UNARY and n0.Ival == tok.MINUS {
            neg = true
            lit = self.T.Kid(e, 0)
        }
        let n = self.T.Get(lit)
        let k = n.Kind
        if not is_basic_lit(k) { return ir.CNIL, "nil" }

        var sign = ""
        if neg { sign = "-" }

        if k == ast.INT {
            let v, ok = parse_int_lit(n.Sval)
            if not ok { return ir.CINT, "0" }
            var m = v
            if neg { m = -m }
            return ir.CINT, str(m)
        }
        if k == ast.FLOAT {
            let f, ok = parse_float_lit(n.Sval)
            if not ok { return ir.CFLOAT, "0" }
            var g = f
            if neg { g = -g }
            return ir.CFLOAT, str(g)
        }
        if k == ast.DEC  { return ir.CDEC, sign || n.Sval }
        if k == ast.STR  { return ir.CSTR, n.Sval }
        if k == ast.RUNE { return ir.CRUNE, n.Sval }
        if k == ast.BOOL { return ir.CBOOL, n.Sval }
        return ir.CNIL, "nil"
    }
}

// coll_type: a static type (short spelling) that is a slice, a map or a set.
func coll_type(t str) bool {
    return str.starts_with(t, "[]") or str.starts_with(t, "map[") or
           str.starts_with(t, "set[")
}

// lock_writer: a collection's builtin methods that change its length or
// order in place without running Voilà code (sort_by runs its key, so it is
// not locked: user code never runs under a variable's lock).
func lock_writer(m str) bool {
    return m == "append" or m == "pop" or m == "insert" or m == "remove" or
           m == "reverse" or m == "add" or m == "delete" or m == "set"
}

// len_only reports whether an expression runs no Voilà code but the
// builtin `len`: no other call, spawn, closure, receive or `try`.
func len_only(T ast.Tree, e int) bool {
    if e == 0 { return true }
    let n = T.Get(e)
    let k = n.Kind
    if k == ast.CALL {
        let c = T.Kid(e, 0)
        if T.Kind(c) != ast.IDENT or T.Get(c).Sval != "len" { return false }
        each a in T.Get(T.Kid(e, 1)).Kids {
            if not len_only(T, T.Kid(a, 0)) { return false }
        }
        return true
    }
    if k == ast.SPAWNEXPR or k == ast.CLOSURE or k == ast.TRYEXPR or
       k == ast.MUSTEXPR {
        return false
    }
    if k == ast.UNARY and n.Ival == tok.ARROW { return false }
    each c in n.Kids {
        if not len_only(T, c) { return false }
    }
    return true
}

// sync_builtin: the builtin collection methods that run a closure argument
// before they return, on the calling task, and keep no reference to it.
// Only ever trusted with a receiver whose static type IS a builtin
// collection (coll_type): a user method of the same name proves nothing.
func sync_builtin(m str) bool {
    return m == "map" or m == "filter" or m == "each" or m == "any" or
           m == "all" or m == "reduce" or m == "sort_by" or m == "sorted"
}
