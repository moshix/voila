// VendorWriteTo writes a unit's files into a directory and
// returns the paths of those cc must compile.
func VendorWriteTo(unit str, dir str) []str throws IOError {
    let names = VendorNames(unit)
    let data = VendorData(unit)
    each i, n in names {
        try os.write(dir || "/" || n, data[i])
    }
    var out = []
    each n in VendorCompile(unit) { out.append(dir || "/" || n) }
    return out
}
