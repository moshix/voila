// Package std — the Voilà-source standard library, carried
// inside the compiler.
//
// GENERATED by tools/build.voi. Do not edit: change std/ and
// rebuild. `use "std/net"` grafts these packages into a user
// program (see voilac/load/load.voi). The payload is base64
// because Voilà source is not a legal Voilà string literal.
package std

// Packages lists the std packages that have Voilà source.
func Packages() []str {
    return [
        "csv",
        "http",
        "net",
        "path",
        "sync",
        "test",
        "time",
    ]
}

// Files lists a package's source files, in load order.
func Files(pkg str) []str {
    if pkg == "csv" {
        return [
            "csv.voi",
        ]
    }
    if pkg == "http" {
        return [
            "http.voi",
        ]
    }
    if pkg == "net" {
        return [
            "net.voi",
        ]
    }
    if pkg == "path" {
        return [
            "path.voi",
        ]
    }
    if pkg == "sync" {
        return [
            "sync.voi",
        ]
    }
    if pkg == "test" {
        return [
            "test.voi",
        ]
    }
    if pkg == "time" {
        return [
            "time.voi",
        ]
    }
    return []
}

// Source returns one file's text.
func Source(pkg str, file str) str {
    if pkg == "csv" and file == "csv.voi" { return unb64("") }
    if pkg == "http" and file == "http.voi" { return unb64("") }
    if pkg == "net" and file == "net.voi" { return unb64("") }
    if pkg == "path" and file == "path.voi" { return unb64("") }
    if pkg == "sync" and file == "sync.voi" { return unb64("") }
    if pkg == "test" and file == "test.voi" { return unb64("") }
    if pkg == "time" and file == "time.voi" { return unb64("") }
    return ""
}
