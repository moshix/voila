// Package chk implements Voilà's static checks — the self-hosted port of
// internal/check.
//
// It began as the pragmatic stage-0 subset — borrow-escape in struct fields
// (§6.2), the Acyclicity Rule (§6.3), the widening-lattice literal checks
// (§3.2), match exhaustiveness (§3.5), straight-line use-after-move (§6.1)
// and the literal format-string checks (§13.1) — and has since grown trait
// conformance and generic bounds (traits.voi), binding discipline (bind.voi),
// declaration well-formedness (sig.voi), call sites (callsite.voi), std
// package members (stdpkg.voi), native arities (native.voi), and finally
// EXPRESSION TYPES (expr.voi), which is the one that asks whether a value
// fits the hole it is put in.
//
// The Go checker fills a diag.Bag with a message, a span, a label, notes and
// help; here a diagnostic is its position, its severity and its message text,
// which must match Go's byte for byte. Check hands back the BAG rather than
// rendered lines: only main.voi knows the -W policy that decides whether a
// warning is printed at all, and a checker that had already flattened its
// diagnostics to strings could not be told.
//
// The AST is an arena (package ast), so every "node pointer" is an int index
// and 0 means absent.
package chk

use "voilac/ast"
use "voilac/diag"
use "voilac/typ"
use "std/str"

struct Checker {
    T    ast.Tree
    file int          // the FILE node

    // The declaration tables, keyed by the FLAT name the loader produced
    // (`geom.Point`, not `Point`). The Go checker keys three maps the same
    // way; the parallel name slices give a stable, declaration-order walk
    // where Go iterates a map.
    structs map[str]int   // name → STRUCTDEC node
    enums   map[str]int   // name → ENUMDEC node
    funcs   map[str]int   // name → FUNC node
    excs    map[str]int   // name → EXCDEC node
    traits  map[str]int   // flat name → TRAITDEC node
    sNames  []str
    eNames  []str
    tNames  []str

    // The type universe (package typ): every nominal name an annotation may
    // legally spell, plus the arena the type-shaped checks intern into. It is
    // filled by collect_types below, from the same declaration list.
    Ty typ.Table

    // The METHOD UNION, keyed "Type|method" — every impl block on a type
    // plus an exception's own methods, which is what the flat dispatch table
    // will hold. Built once by chk/traits.voi's check_traits and read again
    // when a generic bound has to be judged at an instantiation site, which
    // happens later (check_sigs) and elsewhere. One table, one rule.
    mset map[str]int

    // The struct FIELD table (expr.voi), keyed "Type|field" → FIELDDECL
    // node, and the impl block each method came from, keyed "Type|method" →
    // IMPLDEC. The second is what lets a method's `T` be replaced by the
    // receiver's written type argument: the method table alone remembers the
    // body but not which generic list it was written under.
    flds   map[str]int
    implOf map[str]int

    // Every method NAME declared anywhere in the program, in any impl block,
    // exception or trait. LOOKUP ONLY, never iterated. It exists because a
    // trait-typed receiver dispatches on the value's DYNAMIC type (call.c's
    // vl_callm resolves by name against the flat table and the annotation
    // plays no part), so the only honest thing a checker can say about
    // `d.m()` on a `d Describe` is that NOTHING in this program declares an
    // `m` at all.
    mnames set[str]

    // Expression-typing context (expr.voi): the type of `self` in the
    // enclosing method, the enclosing function's single declared result (0
    // when it declares none, several, or is a closure), and its name for the
    // diagnostic. Recorded on the checker rather than threaded through every
    // recursion, exactly as the binding state below is.
    eSelf int
    eRes  int
    eFn   str

    // Binding-discipline state (bind.voi). The enclosing method's self-mode
    // is recorded rather than threaded through the recursion, so a closure
    // written inside a method still knows whose `self` it captured.
    bFn      str
    bSelfMut bool

    // Acyclicity state (acyclic.voi). A slice cannot be grown through a
    // parameter, so the owning-edge table and the reported-cycle set live on
    // the checker rather than being threaded through the DFS.
    edges    []Edge
    adj      map[str][]int   // edge indices by source type — see acyclic.voi
    path     set[str]        // the types on the acyclicity DFS stack
    reported set[str]

    // The std packages, as they appear after grafting (stdpkg.voi). sdSrc is
    // every VOILÀ-SOURCE package the release has and sdC every C-native one,
    // sdUser the ones a USER package has taken the qualifier of, sdPkgs the
    // Voilà-source ones this program actually grafted, sdHave every dotted
    // name a reference may legally resolve to (grafted declarations, C
    // natives and package constants), sdNames the PUBLIC subset a near miss
    // may be drawn from, and sdGlobals the global-scope names that stop a
    // qualifier from being read as one (a top-level `var path`).
    sdSrc     set[str]
    sdC       set[str]
    sdUser    set[str]
    sdPkgs    set[str]
    sdHave    set[str]
    sdNames   []str
    sdGlobals set[str]

    // The NATIVE argument counts (native.voi), read from low.NativeArities:
    // every native's minimum and maximum, keyed by the name the runtime
    // resolves — a std/str function under its bare spelling and its `str.`
    // one. natBare is the subset a BARE call may name at all (the lowerer's
    // prelude list, which is narrower than the natives), and natShadow the
    // declared names that resolve ahead of it and are in no other table here
    // — enum VARIANTS, and TYPE declarations (`type index = int` makes
    // `index(5)` a conversion, and collect() files only the struct-carrying
    // kind under structs).
    natMin     map[str]int
    natMax     map[str]int
    natBare    set[str]
    natShadow  set[str]

    // Every diagnostic this pass produces, in the order the checks ran.
    // Sorting and rendering belong to diag.Bag, which is also what gives a
    // check the choice of severity.
    D diag.Bag
}

// Check runs every static check over a loaded, flattened program and returns
// the diagnostics — empty when the program is clean.
func Check(t ast.Tree, file int) diag.Bag {
    var c = Checker{
        T: t, file: file,
        structs: make(map[str]int), enums: make(map[str]int),
        funcs: make(map[str]int), excs: make(map[str]int),
        traits: make(map[str]int),
        sNames: [], eNames: [], tNames: [],
        edges: [], adj: make(map[str][]int), path: set([]),
        reported: set([]), D: diag.New(), Ty: typ.New(),
        mset: make(map[str]int),
        flds: make(map[str]int), implOf: make(map[str]int),
        mnames: set([]),
        eSelf: 0, eRes: 0, eFn: "",
        bFn: "", bSelfMut: false,
        sdSrc: set([]), sdC: set([]), sdUser: set([]), sdPkgs: set([]),
        sdHave: set([]), sdNames: [],
        sdGlobals: set([]),
        natMin: make(map[str]int), natMax: make(map[str]int),
        natBare: set([]), natShadow: set([]),
    }
    c.collect()
    c.collect_types()
    c.check_borrow_fields()
    c.check_acyclicity()
    c.check_lattice()
    c.check_exhaustiveness()
    c.check_moves()
    c.check_format_strings()
    c.check_call_sites()
    c.check_composites()
    c.check_traits()
    c.check_bindings()
    c.check_sigs()
    c.check_unreachable()
    c.check_std_members()
    // LAST: it reads check_std_members' package tables and check_traits'
    // method union, both of which decide whether a `pkg.member` callee really
    // is a native.
    c.check_native_calls()
    // LAST OF ALL: expression typing reads every table above — the method
    // union, the field table, the declaration tables and check_native_calls'
    // natShadow, which is what stops `int(x)` being read as a conversion when
    // the program declares something else of that name.
    c.check_expr_types()
    return c.D
}

impl Checker {
    // collect indexes the top-level declarations the checks consult. A
    // `type X { … }` declaration carries its struct as a child, and the Go
    // checker files it under the TYPE's name.
    func collect(mut self) {
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.STRUCTDEC {
                self.add_struct(n.Sval, d)
            } else if n.Kind == ast.ENUMDEC {
                if not (n.Sval in self.enums) { self.eNames.append(n.Sval) }
                self.enums[n.Sval] = d
            } else if n.Kind == ast.FUNC {
                self.funcs[n.Sval] = d
            } else if n.Kind == ast.EXCDEC {
                self.excs[n.Sval] = d
            } else if n.Kind == ast.TRAITDEC {
                // The name is the FLAT one: a package's trait is
                // `pkg.Name` here, a builtin's is bare, and every reference
                // to either — an impl header, a bound, an annotation — was
                // rewritten to the same string by the loader (§11.2.1).
                if not (n.Sval in self.traits) { self.tNames.append(n.Sval) }
                self.traits[n.Sval] = d
            } else if n.Kind == ast.TYPEDEC {
                let sd = self.T.Kid(d, 0)
                if sd != 0 { self.add_struct(n.Sval, sd) }
            }
        }
    }

    func add_struct(mut self, name str, node int) {
        if not (name in self.structs) { self.sNames.append(name) }
        self.structs[name] = node
    }

    // collect_types fills the nominal universe the type table resolves names
    // against: every struct, enum, exception, type declaration and TRAIT the
    // program declares, under the flat name the loader produced.
    //
    // Traits are in the list because a trait IS a type in annotation position
    // — samples/08_shapes.voi declares `func report(items []Describe)`. Like
    // everything else here they arrive under their FLAT name: a package's
    // trait is `geom.Named`, a builtin's is bare, and the loader rewrote
    // every reference — annotation, `impl` header, generic bound — to the
    // same string, so nothing in this file has to know about packages.
    func collect_types(mut self) {
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.STRUCTDEC or n.Kind == ast.ENUMDEC or
               n.Kind == ast.EXCDEC or n.Kind == ast.TYPEDEC or
               n.Kind == ast.TRAITDEC {
                self.Ty.Declare(n.Sval)
            }
        }
    }

    // report_at is the normal entry: it takes the file from the NODE, which is
    // the only thing that knows which package it came from.
    func report_at(mut self, node int, msg str) {
        let n = self.T.Get(node)
        self.D.error(self.T.FileOf(node), n.Line, n.Col, "", msg)
    }

    // warn_at is report_at at the other severity. `code` is the stable name
    // -Wno-<code> and -Werror=<code> address the warning by, so every caller
    // must pass one diag.Codes() lists — a warning nobody can switch off has
    // no business being on by default.
    func warn_at(mut self, node int, code str, msg str) {
        let n = self.T.Get(node)
        self.D.warn(self.T.FileOf(node), n.Line, n.Col, code, msg)
    }

    // ------------------------------------------------------------ borrows

    // check_borrow_fields rejects borrows stored in struct fields (§6.2): a
    // field outlives the call that lent the value, so a borrow there could
    // escape.
    func check_borrow_fields(mut self) {
        each name in self.sNames {
            let fields = self.T.Kid(self.structs[name], 0)
            each f in self.T.Get(fields).Kids {
                let te = self.T.Get(f).Ival
                if te != 0 and self.T.Kind(te) == ast.TBORROW {
                    self.report_at(te, "borrow stored in struct field — " ||
                                       "borrows cannot escape (§6.2)")
                }
            }
        }
    }

    // ------------------------------------------------------------ walkers

    // all_stmts lists every statement the Go checker's walkStmts visits, in
    // the same order: function bodies, impl and exception methods, global
    // bindings, then the script statements. Expressions are NOT entered, so a
    // `match` inside a closure literal is invisible to these checks —
    // exactly as in Go.
    func all_stmts(self) []int {
        var out = []
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.FUNC {
                each s in self.walk_block(self.T.Kid(d, 0)) { out.append(s) }
            } else if n.Kind == ast.IMPLDEC {
                each m in self.T.Get(self.T.Kid(d, 0)).Kids {
                    each s in self.walk_block(self.T.Kid(m, 0)) {
                        out.append(s)
                    }
                }
            } else if n.Kind == ast.TRAITDEC {
                // A trait DEFAULT body is live code: low.lower_trait_default
                // compiles it and cg registers it for every implementor, so
                // it runs. These walkers were written when it was dead
                // syntax, and without this arm a bad format string, a
                // non-exhaustive match or a use-after-move inside a default
                // passed `check` and failed at run time — the one
                // inconsistency the verb exists to prevent.
                each m in self.T.Get(self.T.Kid(d, 0)).Kids {
                    each s in self.walk_block(self.T.Kid(m, 0)) {
                        out.append(s)
                    }
                }
            } else if n.Kind == ast.EXCDEC {
                each m in self.T.Get(self.T.Kid(d, 1)).Kids {
                    each s in self.walk_block(self.T.Kid(m, 0)) {
                        out.append(s)
                    }
                }
            } else if n.Kind == ast.GLOBAL {
                each s in self.walk_stmt(self.T.Kid(d, 0)) { out.append(s) }
            }
        }
        each s in self.T.Get(self.T.Kid(self.file, 2)).Kids {
            each x in self.walk_stmt(s) { out.append(x) }
        }
        return out
    }

    func walk_block(self, b int) []int {
        var out = []
        if b == 0 { return out }
        each s in self.T.Get(b).Kids {
            each x in self.walk_stmt(s) { out.append(x) }
        }
        return out
    }

    func walk_stmt(self, s int) []int {
        var out = []
        if s == 0 { return out }
        out.append(s)
        let k = self.T.Kind(s)
        if k == ast.BLOCK {
            each x in self.walk_block(s) { out.append(x) }
        } else if k == ast.IF {
            each x in self.walk_block(self.T.Kid(s, 1)) { out.append(x) }
            each x in self.walk_stmt(self.T.Kid(s, 2)) { out.append(x) }
        } else if k == ast.FOR or k == ast.EACH or k == ast.WHILE or
                  k == ast.GROUP {
            // for/each/while/group all keep their body in the second slot.
            each x in self.walk_block(self.T.Kid(s, 1)) { out.append(x) }
        } else if k == ast.SWITCH {
            each cs in self.T.Get(self.T.Kid(s, 1)).Kids {
                each b in self.T.Get(self.T.Kid(cs, 1)).Kids {
                    each x in self.walk_stmt(b) { out.append(x) }
                }
            }
        } else if k == ast.MATCH {
            each a in self.T.Get(self.T.Kid(s, 1)).Kids {
                each b in self.T.Get(self.T.Kid(a, 1)).Kids {
                    each x in self.walk_stmt(b) { out.append(x) }
                }
            }
        } else if k == ast.SELECTSTMT {
            each cs in self.T.Get(self.T.Kid(s, 0)).Kids {
                each b in self.T.Get(self.T.Kid(cs, 2)).Kids {
                    each x in self.walk_stmt(b) { out.append(x) }
                }
            }
        } else if k == ast.TRYCATCH {
            each x in self.walk_block(self.T.Kid(s, 0)) { out.append(x) }
            each cc in self.T.Get(self.T.Kid(s, 1)).Kids {
                each x in self.walk_block(self.T.Kid(cc, 0)) { out.append(x) }
            }
            each x in self.walk_block(self.T.Kid(s, 2)) { out.append(x) }
        }
        return out
    }

    // walk_expr returns e and every sub-expression Go's walkExpr visits, in
    // the same pre-order. A closure's body is a BLOCK, not an expression, and
    // is not entered; nor is a spawn block or an `else` whose alternative is a
    // diverging statement (Go keeps those in AltStmt/Block, which walkExpr
    // skips).
    func walk_expr(self, e int) []int {
        var out = []
        if e == 0 { return out }
        out.append(e)
        let n = self.T.Get(e)
        let k = n.Kind
        if k == ast.UNARY or k == ast.TRYEXPR or k == ast.MUSTEXPR or
           k == ast.ATTEMPT or k == ast.FIELD {
            each x in self.walk_expr(self.T.Kid(e, 0)) { out.append(x) }
        } else if k == ast.BINARY or k == ast.INDEX {
            each x in self.walk_expr(self.T.Kid(e, 0)) { out.append(x) }
            each x in self.walk_expr(self.T.Kid(e, 1)) { out.append(x) }
        } else if k == ast.RANGE {
            each x in self.walk_expr(self.T.Kid(e, 0)) { out.append(x) }
            each x in self.walk_expr(self.T.Kid(e, 1)) { out.append(x) }
            each x in self.walk_expr(self.T.Kid(e, 2)) { out.append(x) }
        } else if k == ast.CALL {
            each x in self.walk_expr(self.T.Kid(e, 0)) { out.append(x) }
            each a in self.T.Get(self.T.Kid(e, 1)).Kids {
                each x in self.walk_expr(self.T.Kid(a, 0)) { out.append(x) }
            }
        } else if k == ast.COMPOSITE {
            each f in n.Kids {
                each x in self.walk_expr(self.T.Kid(f, 0)) { out.append(x) }
            }
        } else if k == ast.SLICELIT or k == ast.TUPLE {
            each el in n.Kids {
                each x in self.walk_expr(el) { out.append(x) }
            }
        } else if k == ast.INTERP {
            each p in n.Kids {
                // A literal part is a STR node; Go stores it as a plain string
                // with a nil Expr and never visits it.
                if self.T.Kind(p) != ast.STR {
                    each x in self.walk_expr(p) { out.append(x) }
                }
            }
        } else if k == ast.ELSEEXPR {
            each x in self.walk_expr(self.T.Kid(e, 0)) { out.append(x) }
            if n.Ival2 != 1 {
                each x in self.walk_expr(self.T.Kid(e, 1)) { out.append(x) }
            }
        } else if k == ast.SPAWNEXPR {
            if n.Ival2 != 1 {
                each x in self.walk_expr(self.T.Kid(e, 0)) { out.append(x) }
            }
        }
        return out
    }
}

// chr renders one byte value as a string.
func chr(c int) str { return str.from_runes([rune(c)]) }

// has_byte reports whether s contains the byte c.
func has_byte(s str, c int) bool {
    var i = 0
    while i < len(s) {
        if s[i] == c { return true }
        i += 1
    }
    return false
}
