// Package cg compiles the Voilà IR to C — the stage-1 port of
// internal/cgen. Generated code calls libvoila (runtime/), so the produced
// executable contains no Go whatsoever.
//
// The oracle is the C itself: `voila build --emit=c x.voi` and
// `voilac -c x.voi` must be byte-identical, so every format string here is a
// transcription of the Go original.
//
// Model: every function's registers live in a heap frame (VlFrame) so that
// closures can capture them by reference, exactly as the interpreter's
// environments do. Helpers borrow their arguments and return owned values;
// frame slots own their contents. One instruction is one C statement.
package cg

use "voilac/ast"
use "voilac/ir"
use "voilac/low"
use "std/str"
use "std/fmt"

// CGenError carries every refusal the backend collected, joined by "\n".
// The backend refuses to build what it cannot express (loop-variable capture,
// `ctx`) rather than emit code that would behave differently.
exception CGenError {
    Msg str
}

// FieldDefault is a struct field whose declaration carries a literal default.
// ConstIdx is -1 when the field has no usable default.
struct FieldDefault {
    Name     str
    ConstIdx int
    // The C expression of the default value: `K[i]`, or `DF[j]` for a
    // literal converted to the field's NEWTYPE at start-up (§3.8).
    Ref      str
}

// TypeInfo is one struct/exception descriptor: field names and their rendered
// declared types (the runtime's zero-value constructor reads the latter).
struct TypeInfo {
    Name   str
    Fields []str
    FTypes []str
    // A newtype (`type Cel int`, §3.8): one unnamed field holding the
    // underlying value; the descriptor carries VlType.newtype = 1.
    NewType bool
}

// VarInfo is one enum variant descriptor.
struct VarInfo {
    Typ     str
    Variant str
    Fields  []str
    FTypes  []str   // each payload field's declared type (json.decode[T])
}

// Method is one entry of the runtime method table.
struct Method {
    Typ     str
    Name    str
    Fn      int
    HasSelf bool
}

// CallArg is one rendered call operand: "name:r3" or "r3..." or "r3".
struct CallArg {
    Reg    str
    Name   str
    Spread bool
}

struct Gen {
    mod  ir.Module
    T    ast.Tree
    file int          // the FILE node
    b    str.Builder

    fnIdx    map[str]int            // Voilà function name → C index
    natIdx   map[str]int            // builtin/package name → natives index
    nats     []str                  // in index order
    globals  map[str]int            // global name → G[] slot
    gnames   []str
    defaults map[str][]FieldDefault
    selCases []ir.Instr
    ctors    []str      // `Enum.Variant` constructors used as values
    patSeq   int
    errs     []str
    // The distinct C signatures of the program's FFI instructions, in the
    // order the bodies first used them; ffi prototype i is `vlffi_<i>`.
    ffis     []str

    // Trait-default rows: the (type, method) pairs an `impl Trait for T`
    // inherits rather than writes. Computed once, up front, because BOTH
    // consumers need it and one of them runs before any body is emitted —
    // see collect_inherited.
    inherited []Method
    // Newtype field defaults converted at start-up: "Newtype|constIdx",
    // indexed like the DF array (record_defaults).
    dfConv    []str

    // Name tables (see instr.voi).
    known    set[str]      // names the C runtime provides
    natKinds map[str]str   // native → argument kinds (low.NativeKinds)
    pkgConst set[str]      // package constants: values, not callables
    binOp    map[str]str
    unOp     map[str]str
}

func new_gen(t ast.Tree, file int, m ir.Module) Gen {
    var g = Gen{
        mod: m, T: t, file: file, b: str.Builder{},
        fnIdx: make(map[str]int), natIdx: make(map[str]int), nats: [],
        globals: make(map[str]int), gnames: [],
        defaults: make(map[str][]FieldDefault),
        selCases: [], ctors: [], patSeq: 0, errs: [], inherited: [],
        dfConv: [],
        ffis: [],
        known: set(), pkgConst: set(), natKinds: make(map[str]str),
        binOp: bin_op_fns(), unOp: un_op_fns(),
    }
    each n in known_native_names() { g.known.add(n) }
    each n in pkg_constant_names() { g.pkgConst.add(n) }
    var strm = set([])
    each n in low.StrMethodNames() { strm.add(n) }
    each e in low.NativeKinds() {
        let parts = str.split(e, "|")
        if len(parts) != 2 { continue }
        g.natKinds[parts[0]] = parts[1]
        if parts[0] in strm { g.natKinds["str." || parts[0]] = parts[1] }
    }
    return g
}

// Compile lowers a checked file to a self-contained C translation unit.
func Compile(t ast.Tree, file int, m ir.Module) str throws CGenError {
    var g = new_gen(t, file, m)
    each i, f in m.Funcs {
        g.fnIdx[f.Name] = i
    }
    g.collect_inherited()
    g.collect_globals()
    g.collect_defaults()

    // Patterns and function bodies intern constants, so they are generated
    // into buffers FIRST and the constant pool is emitted once it is final.
    // (Sizing K[] before the last intern is an out-of-bounds read.)
    let saved = g.b
    g.b = str.Builder{}
    g.emit_patterns()
    let patterns = g.b.done()

    g.b = str.Builder{}
    each i, f in m.Funcs {
        g.emit_func(i, f)
    }
    let bodies = g.b.done()
    g.b = saved

    g.emit_header()
    g.emit_consts()
    g.emit_types()
    g.emit_protos()
    g.emit_ffi_protos()
    g.emit_ctors()
    g.b.write(patterns)
    g.b.write(bodies)
    g.emit_method_table()
    g.emit_main()

    if len(g.errs) > 0 {
        throw CGenError{Msg: str.join(g.errs, "\n")}
    }
    return g.b.done()
}

impl Gen {
    // failf records a refusal once — the same message is never repeated.
    func failf(mut self, msg str) {
        each e in self.errs {
            if e == msg { return }
        }
        self.errs.append(msg)
    }

    // p writes one line of C.
    func p(mut self, s str) {
        self.b.write(s)
        self.b.write("\n")
    }

    // ------------------------------------------------------------ collect

    // collect_globals scans SETGLB/GETGLB for the module's global slots.
    func collect_globals(mut self) {
        each f in self.mod.Funcs {
            each ins in f.Instrs {
                var name = ""
                if ins.Op == "SETGLB" {
                    name = ins.Args[0]
                } else if ins.Op == "GETGLB" {
                    name = ins.Args[1]
                } else {
                    continue
                }
                if not (name in self.globals) {
                    self.globals[name] = len(self.gnames)
                    self.gnames.append(name)
                }
            }
        }
    }

    // collect_defaults records struct/exception field defaults. A default must
    // be a literal in native builds; anything else needs an initializer
    // function, which the stage-0 backend does not emit.
    func collect_defaults(mut self) {
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.STRUCTDEC {
                self.record_defaults(n.Sval, self.T.Kid(d, 0))
            } else if n.Kind == ast.TYPEDEC {
                let sd = self.T.Kid(d, 0)
                if sd != 0 {
                    self.record_defaults(n.Sval, self.T.Kid(sd, 0))
                }
            } else if n.Kind == ast.EXCDEC {
                self.record_defaults(n.Sval, self.T.Kid(d, 0))
            }
        }
    }

    func record_defaults(mut self, name str, fields int) {
        var ds = []
        each f in self.T.Get(fields).Kids {
            let fd = self.T.Get(f)
            let dflt = self.T.Kid(f, 0)
            if dflt == 0 {
                ds.append(FieldDefault{Name: fd.Sval, ConstIdx: 0 - 1,
                                       Ref: ""})
                continue
            }
            if not is_literal(self.T.Kind(dflt)) {
                self.failf(fmt.sprintf("cgen: field default for `%s.%s` " ||
                                       "must be a literal in native builds",
                                       name, fd.Sval))
                ds.append(FieldDefault{Name: fd.Sval, ConstIdx: 0 - 1,
                                       Ref: ""})
                continue
            }
            let kind, norm = self.lit_const(dflt)
            let ci = self.intern_const(kind, norm)
            var ref = fmt.sprintf("K[%d]", ci)
            // A literal default of a NEWTYPE field is the newtype's value
            // (§3.8): converted once at start-up into DF.
            let te = fd.Ival
            if te != 0 and self.T.Kind(te) == ast.TNAMED and
               self.T.Get(te).Sval in self.newtypeNames() {
                ref = fmt.sprintf("DF[%d]", len(self.dfConv))
                self.dfConv.append(self.T.Get(te).Sval || "|" || str(ci))
            }
            ds.append(FieldDefault{Name: fd.Sval, ConstIdx: ci, Ref: ref})
        }
        self.defaults[name] = ds
    }

    // newtypeNames lists the program's newtypes (`type X T`, not an alias,
    // not a struct).
    func newtypeNames(self) set[str] {
        var out = set([])
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.TYPEDEC and self.T.Kid(d, 0) == 0 and
               n.Ival2 != 1 {
                out.add(n.Sval)
            }
        }
        return out
    }

    // lit_const maps a literal expression to its (constant kind, pool text).
    func lit_const(self, id int) (int, str) {
        let n = self.T.Get(id)
        if n.Kind == ast.INT {
            return ir.CINT, str(parse_int_text(n.Sval))
        }
        if n.Kind == ast.FLOAT {
            return ir.CFLOAT, fmt.sprintf("%g", float(n.Sval))
        }
        if n.Kind == ast.DEC   { return ir.CDEC, n.Sval }
        if n.Kind == ast.STR   { return ir.CSTR, n.Sval }
        if n.Kind == ast.RUNE  { return ir.CRUNE, n.Sval }
        if n.Kind == ast.BOOL  { return ir.CBOOL, n.Sval }
        return ir.CNIL, "nil"
    }

    // intern_const adds a constant to the pool, reusing an equal entry. The
    // scan is linear because the pool is short and the dedup key is the pair
    // (kind, canonical text) — exactly the lowerer's key.
    func intern_const(mut self, kind int, text str) int {
        each i, c in self.mod.Consts {
            if c.Kind == kind and c.Text == text { return i }
        }
        self.mod.Consts.append(ir.Const{Kind: kind, Text: text})
        return len(self.mod.Consts) - 1
    }

    // native registers a runtime function and returns its NAT[] index.
    //
    // Reaching the refusal means the name does not EXIST, not that it is
    // waiting on an implementation: every name low/names.voi can lower has a
    // native (selftest cross-checks the two tables), so the wording must send
    // the reader to the spelling rather than to a missing feature. For a
    // Voilà-source std package chk/stdpkg.voi has already said so, at the
    // reference, with a near miss.
    func native(mut self, name str) int {
        if name in self.natIdx { return self.natIdx[name] }
        if not (name in self.known) {
            self.failf(fmt.sprintf("cgen: `%s` is not a name the runtime " ||
                                   "provides — check the spelling (§13.4)",
                                   name))
        }
        let i = len(self.nats)
        self.natIdx[name] = i
        self.nats.append(name)
        return i
    }

    // ------------------------------------------------------------ preamble

    func emit_header(mut self) {
        self.p("/* Generated by voila build. Do not edit.")
        self.p(fmt.sprintf(" * source: %s", self.mod.Source))
        self.p(" */")
        self.p("#include \"voila.h\"")
        self.p("#include <stdlib.h>")
        // The `link` libraries of the program's ffi blocks (§12), one per
        // line in this exact form: the driver (main.voi, link_flags) reads
        // them back out of the C and hands each to cc as -l<name>.
        each l in self.mod.Links {
            self.p("/* voila-link: " || l || " */")
        }
        // The runtime EXTENSIONS the program's natives live in (std/tls,
        // std/compress, std/sqlite), one per line in this exact form: the
        // driver (main.voi, vendor_units) compiles — or finds cached — each
        // one's archive and links it. A program that names none of their
        // natives gets no line, and links libvoila alone.
        let units = self.ext_units()
        each u in units {
            self.p("/* voila-vendor: " || u || " */")
        }
        self.p("")
        // Each extension's natives table; main() registers it (emit_main).
        each u in units {
            self.p("extern const VlExtEntry vl_ext_" || u || "[];")
        }
        if len(units) > 0 { self.p("") }
    }

    // ext_units is the sorted set of extensions whose natives the program
    // calls. Sorted so the generated C is deterministic (the fixpoint).
    func ext_units(self) []str {
        var seen = set([])
        each n in self.nats {
            let u = low.VendorOf(n)
            if u != "" { seen.add(u) }
        }
        var out = []
        each u in seen { out.append(u) }
        out.sort()
        return out
    }

    func emit_consts(mut self) {
        // A LARGE string constant is a static str object, not a copy made
        // at start-up: the pool is filled in main() before anything runs,
        // and copying megabytes there — the compiler carries its runtime
        // and the vendored libraries as such strings — cost every process
        // its time and twice the memory, for data most runs never read. A
        // static object costs nothing until it is read: its bytes stay in
        // the executable's pages. The struct mirrors VlStr (runtime/src/
        // voila_int.h) member for member; its count starts at 2^30, so no
        // balance of retains and releases can ever take it to zero, and no
        // free() is ever attempted on memory that is not the heap's.
        each i, c in self.mod.Consts {
            if c.Kind == ir.CSTR and len(c.Text) >= STATIC_STR_MIN {
                self.p(fmt.sprintf("static struct \{ VlObj hdr; int64_t " ||
                                   "len; char b[%d]; \} KS%d = \{\{" ||
                                   "1073741824, O_STR\}, %d, %s\};",
                                   len(c.Text) + 1, i, len(c.Text),
                                   c_quote(c.Text)))
            }
        }
        self.p(fmt.sprintf("static Value K[%d];",
                           max(1, len(self.mod.Consts))))
        self.p("static void init_consts(void) \{")
        each i, c in self.mod.Consts {
            if c.Kind == ir.CINT {
                self.p(fmt.sprintf("  K[%d] = vl_int(%sLL);", i, c.Text))
            } else if c.Kind == ir.CFLOAT {
                self.p(fmt.sprintf("  K[%d] = vl_float(%s);", i,
                                   c_float(c.Text)))
            } else if c.Kind == ir.CDEC {
                self.p(fmt.sprintf("  K[%d] = vl_dec_parse(%s);", i,
                                   c_quote(c.Text)))
            } else if c.Kind == ir.CSTR and len(c.Text) >= STATIC_STR_MIN {
                self.p(fmt.sprintf("  K[%d].t = VL_OBJ; K[%d].u.o = " ||
                                   "&KS%d.hdr;", i, i, i))
            } else if c.Kind == ir.CSTR {
                self.p(fmt.sprintf("  K[%d] = vl_str_n(%s, %d);", i,
                                   c_quote(c.Text), len(c.Text)))
            } else if c.Kind == ir.CRUNE {
                self.p(fmt.sprintf("  K[%d] = vl_rune(%d);", i,
                                   first_rune(c.Text)))
            } else if c.Kind == ir.CBOOL {
                self.p(fmt.sprintf("  K[%d] = vl_bool(%s);", i, c.Text))
            } else if c.Kind == ir.CNIL {
                self.p(fmt.sprintf("  K[%d] = vl_nil();", i))
            } else if c.Kind == ir.CUNIT {
                self.p(fmt.sprintf("  K[%d] = vl_unit();", i))
            }
        }
        self.p("\}")
        self.p("")
        self.p(fmt.sprintf("static Value DF[%d]; /* newtype field defaults */",
                           max(1, len(self.dfConv))))
        self.p(fmt.sprintf("static Value G[%d];", max(1, len(self.gnames))))
        self.p("")
    }

    // ------------------------------------------------------------ types

    // type_info gathers one struct/exception's field names and declared types.
    func type_info(self, name str, fields int) TypeInfo {
        var t = TypeInfo{Name: name, Fields: [], FTypes: [], NewType: false}
        each f in self.T.Get(fields).Kids {
            let fd = self.T.Get(f)
            t.Fields.append(fd.Sval)
            t.FTypes.append(self.type_text(fd.Ival))
        }
        return t
    }

    // has_defaults reports whether a struct or exception declares at least
    // one usable field default (collect_defaults).
    func has_defaults(self, name str) bool {
        if not (name in self.defaults) { return false }
        each fd in self.defaults[name] {
            if fd.ConstIdx >= 0 { return true }
        }
        return false
    }

    // emit_types writes the struct/enum/exception descriptors the runtime
    // needs.
    func emit_types(mut self) {
        var types = []
        var variants = []
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.STRUCTDEC {
                types.append(self.type_info(n.Sval, self.T.Kid(d, 0)))
            } else if n.Kind == ast.TYPEDEC {
                let sd = self.T.Kid(d, 0)
                if sd != 0 {
                    types.append(self.type_info(n.Sval, self.T.Kid(sd, 0)))
                } else if n.Ival2 != 1 {
                    // `type X T` — a newtype. Its one field has no name a
                    // program could spell, so `c.x` can never reach it.
                    types.append(TypeInfo{Name: n.Sval, Fields: [""],
                                          FTypes: [self.type_text(n.Ival)],
                                          NewType: true})
                }
            } else if n.Kind == ast.EXCDEC {
                types.append(self.type_info(n.Sval, self.T.Kid(d, 0)))
            } else if n.Kind == ast.ENUMDEC {
                each v in self.T.Get(self.T.Kid(d, 0)).Kids {
                    let vn = self.T.Get(v)
                    // Both halves are package-qualified in the tree
                    // (`geom.Shape`, `geom.Circle`), but a VlVariant pairs the
                    // qualified TYPE with the SHORT variant name — that is the
                    // shape vl_enum_new and vl_match both expect.
                    let vpkg, vshort = split_variant(vn.Sval)
                    var vd = VarInfo{Typ: n.Sval, Variant: vshort, Fields: [],
                                     FTypes: []}
                    each f in self.T.Get(self.T.Kid(v, 0)).Kids {
                        vd.Fields.append(self.T.Get(f).Sval)
                        vd.FTypes.append(self.type_text(self.T.Get(f).Ival))
                    }
                    variants.append(vd)
                }
            }
        }

        each i, t in types {
            if len(t.Fields) == 0 { continue }
            var qs = []
            var ts = []
            each k, fname in t.Fields {
                qs.append(c_quote(fname))
                ts.append(c_quote(t.FTypes[k]))
            }
            self.p(fmt.sprintf("static const char *const tf%d[] = \{%s\};",
                               i, str.join(qs, ", ")))
            self.p(fmt.sprintf("static const char *const tt%d[] = \{%s\};",
                               i, str.join(ts, ", ")))
            // The declared defaults, as pointers into the constant pool
            // (VlType.defaults): only for a type that has at least one, so
            // every other descriptor is emitted exactly as before.
            if self.has_defaults(t.Name) {
                var ds = []
                each fd in self.defaults[t.Name] {
                    if fd.ConstIdx < 0 {
                        ds.append("NULL")
                    } else {
                        ds.append("&" || fd.Ref)
                    }
                }
                self.p(fmt.sprintf("static const Value *const td%d[] = " ||
                                   "\{%s\};", i, str.join(ds, ", ")))
            }
        }
        self.p("static const VlType g_types[] = \{")
        each i, t in types {
            var fp = "NULL"
            var tp = "NULL"
            if len(t.Fields) > 0 {
                fp = fmt.sprintf("tf%d", i)
                tp = fmt.sprintf("tt%d", i)
            }
            if len(t.Fields) > 0 and self.has_defaults(t.Name) {
                var nt = 0
                if t.NewType { nt = 1 }
                self.p(fmt.sprintf("  \{%s, %d, %s, %s, %d, td%d\},",
                                   c_quote(t.Name), len(t.Fields), fp, tp, nt,
                                   i))
            } else if t.NewType {
                self.p(fmt.sprintf("  \{%s, %d, %s, %s, 1\},",
                                   c_quote(t.Name), len(t.Fields), fp, tp))
            } else {
                self.p(fmt.sprintf("  \{%s, %d, %s, %s\},", c_quote(t.Name),
                                   len(t.Fields), fp, tp))
            }
        }
        self.p("  \{NULL, 0, NULL, NULL\}")
        self.p("\};")

        each i, v in variants {
            if len(v.Fields) == 0 { continue }
            var qs = []
            each fname in v.Fields {
                qs.append(c_quote(fname))
            }
            self.p(fmt.sprintf("static const char *const vf%d[] = \{%s\};",
                               i, str.join(qs, ", ")))
            var ts = []
            each ft in v.FTypes {
                ts.append(c_quote(ft))
            }
            self.p(fmt.sprintf("static const char *const vt%d[] = \{%s\};",
                               i, str.join(ts, ", ")))
        }
        self.p("static const VlVariant g_variants[] = \{")
        each i, v in variants {
            if len(v.Fields) > 0 {
                self.p(fmt.sprintf("  \{%s, %s, %d, vf%d, vt%d\},",
                                   c_quote(v.Typ), c_quote(v.Variant),
                                   len(v.Fields), i, i))
            } else {
                self.p(fmt.sprintf("  \{%s, %s, %d, NULL\},", c_quote(v.Typ),
                                   c_quote(v.Variant), len(v.Fields)))
            }
        }
        self.p("  \{NULL, NULL, 0, NULL\}")
        self.p("\};")
        self.p(fmt.sprintf("static const int g_ntypes = %d;", len(types)))
        self.p(fmt.sprintf("static const int g_nvariants = %d;",
                           len(variants)))
        self.p("")
    }

    // ------------------------------------------------------------ patterns

    // emit_patterns writes a static VlPat tree for every PMATCH in the module.
    func emit_patterns(mut self) {
        each f in self.mod.Funcs {
            each ins in f.Instrs {
                if ins.Op == "PMATCH" and ins.Pat != 0 {
                    self.emit_pattern(ins.Pat)
                }
            }
        }
    }

    // emit_pattern assigns each pattern node a stable C symbol, children
    // first (a node's initializer names its children).
    func emit_pattern(mut self, pi int) str {
        each e in self.mod.Pats[pi].Elems {
            self.emit_pattern(e)
        }
        self.patSeq += 1
        let name = fmt.sprintf("p%d", self.patSeq)
        self.mod.Pats[pi].CName = name

        var elems = "NULL"
        if len(self.mod.Pats[pi].Elems) > 0 {
            var refs = []
            each e in self.mod.Pats[pi].Elems {
                refs.append(self.mod.Pats[e].CName)
            }
            self.p(fmt.sprintf("static const VlPat %s_e[] = \{%s\};", name,
                               str.join(refs, ", ")))
            elems = name || "_e"
        }

        let kind = pat_kind_name(self.mod.Pats[pi].Kind)
        var slot = 0
        if self.mod.Pats[pi].Kind == ir.PAT_BIND {
            slot = reg_slot(self.mod.Pats[pi].Reg)
        }
        var lit = 0
        if self.mod.Pats[pi].Kind == ir.PAT_LIT {
            lit = self.intern_const(self.mod.Pats[pi].LitKind,
                                    self.mod.Pats[pi].LitText)
        }
        let pname = c_quote(self.mod.Pats[pi].Name)
        self.p(fmt.sprintf("static const VlPat %s = \{%s, %s, %d, %d, %d, " ||
                           "%s\};", name, kind, pname, slot, lit,
                           len(self.mod.Pats[pi].Elems), elems))
        return name
    }

    // ------------------------------------------------------------ functions

    func emit_protos(mut self) {
        each i, f in self.mod.Funcs {
            self.p(fmt.sprintf("static Value %s(Value *argv, int argc, " ||
                               "VlFrame *up); /* %s */", c_func_name(i),
                               f.Name))
        }
        // One VlFnInfo per function: the name a stack trace shows and the
        // file it was written in.
        // … and which registers its closures read through an upvalue
        // (um_N): vl_frame_clear must leave those alone at exit.
        each i, f in self.mod.Funcs {
            var file = f.File
            if file == "" { file = self.mod.Source }
            let um = up_mask(self.mod, i)
            if um != "" {
                self.p(fmt.sprintf("static const unsigned char um_%d[%d] = " ||
                                   "\{%s\};", i, f.NRegs, um))
                self.p(fmt.sprintf("static const VlFnInfo fi_%d = \{%s, %s, " ||
                                   "um_%d, %d\};", i,
                                   c_quote(display_name(f.Name)),
                                   c_quote(file), i, f.NRegs))
            } else {
                self.p(fmt.sprintf("static const VlFnInfo fi_%d = \{%s, %s, " ||
                                   "NULL, 0\};", i,
                                   c_quote(display_name(f.Name)),
                                   c_quote(file)))
            }
        }
        self.p("")
        self.p(fmt.sprintf("static VlFn NAT[%d]; /* sized exactly; the " ||
                           "bodies are generated first */",
                           max(1, len(self.nats))))
        self.p("")
    }

    // emit_ffi_protos declares each C function an ffi block names, under a
    // C name of the generator's own (`vlffi_<i>`) bound to the real symbol by
    // an asm label (voila.h, VL_FFI_SYM). The program's headers may already
    // declare `strlen` — with a different spelling of its types — and a
    // second declaration of the same identifier would not compile; one of a
    // NEW identifier that merely shares the symbol always does.
    func emit_ffi_protos(mut self) {
        if len(self.ffis) == 0 { return }
        // One C symbol, one prototype: two blocks that declare the same
        // function with different C types would give C two declarations
        // of one symbol that disagree, which no compiler can be trusted with.
        each i, s in self.ffis {
            let nm = parse_ffi_sig(s).name
            var j = 0
            while j < i {
                if parse_ffi_sig(self.ffis[j]).name == nm {
                    self.failf("ffi: C function `" || nm || "` is declared " ||
                               "with two different signatures")
                }
                j += 1
            }
        }
        each i, s in self.ffis {
            let sig = parse_ffi_sig(s)
            var ps = []
            each ct in sig.params {
                ps.append(ffi_ctype_c(ct))
            }
            if sig.variadic { ps.append("...") }
            if len(ps) == 0 { ps.append("void") }
            self.p(fmt.sprintf("extern %s vlffi_%d(%s) " ||
                               "__asm__(VL_FFI_SYM(%s));",
                               ffi_ctype_c(sig.ret), i, str.join(ps, ", "),
                               c_quote(sig.name)))
        }
        self.p("")
    }

    // rt gives a slot's RT_* type; RT_BOX when the pass did not run.
    func rt(self, f ir.Func, slot int) int {
        if slot < 0 or slot >= len(f.RegT) { return ir.RT_BOX }
        return f.RegT[slot]
    }

    // operand renders an IR operand as a borrowed C expression. A typed
    // register boxes on demand: vl_int/vl_float/vl_bool are immediates, so
    // the wrap allocates nothing and needs no retain.
    func operand(mut self, f ir.Func, s str) str {
        if str.starts_with(s, "r") and reg_slot(s) >= 0 {
            let n = reg_slot(s)
            let t = self.rt(f, n)
            if t == ir.RT_INT { return fmt.sprintf("vl_int(r%d_i)", n) }
            if t == ir.RT_FLOAT { return fmt.sprintf("vl_float(r%d_f)", n) }
            if t == ir.RT_BOOL { return fmt.sprintf("vl_bool(r%d_b)", n) }
            return fmt.sprintf("F->r[%d]", reg_slot(s))
        }
        if str.starts_with(s, "K") {
            let n = atoi(s[1..len(s)])
            if n >= 0 {
                return fmt.sprintf("K[%d]", n)
            }
        }
        if str.starts_with(s, "^") {
            let name = s[1..len(s)]
            if not f.HasUp(name) {
                self.failf(fmt.sprintf("cgen: unresolved upvalue `%s` in %s",
                                       name, f.Name))
                return "vl_nil()"
            }
            let up = f.Up(name)
            return fmt.sprintf("vl_up(F->up, %d, %d)", up.Depth - 1, up.Slot)
        }
        self.failf(fmt.sprintf("cgen: bad operand %q in %s", s, f.Name))
        return "vl_nil()"
    }

    // dst renders a destination register. A typed slot here is an internal
    // bug: the transfer function promised every non-native def forces BOX,
    // so only native emission paths may write typed slots.
    func dst(mut self, f ir.Func, s str) str {
        let n = reg_slot(s)
        if n < 0 {
            self.failf(fmt.sprintf("cgen: bad destination %q in %s", s,
                                   f.Name))
            return "F->r[0]"
        }
        if self.rt(f, n) != ir.RT_BOX {
            self.failf(fmt.sprintf("cgen: typed register r%d written by a " ||
                                   "boxed path in %s", n, f.Name))
        }
        return fmt.sprintf("F->r[%d]", n)
    }

    // emit_argv writes an argv array for a call, returning its C name and
    // length expression.
    func emit_argv(mut self, f ir.Func, id int, spec str) (str, str) {
        let args = parse_args(spec)
        let name = fmt.sprintf("a%d", id)
        if len(args) == 0 {
            return "NULL", "0"
        }
        var hasSpread = false
        each a in args {
            if a.Spread { hasSpread = true }
        }
        if not hasSpread {
            var vals = []
            each a in args {
                vals.append(self.operand(f, a.Reg))
            }
            self.p(fmt.sprintf("  Value %s[] = \{%s\};", name,
                               str.join(vals, ", ")))
            return name, str(len(vals))
        }
        // Spread: build the argv dynamically.
        self.p(fmt.sprintf("  Value %s_s = vl_slice_new(0);", name))
        each a in args {
            if a.Spread {
                self.p(fmt.sprintf("  vl_spread(%s_s, %s);", name,
                                   self.operand(f, a.Reg)))
            } else {
                self.p(fmt.sprintf("  vl_slice_append(%s_s, vl_retain(%s));",
                                   name, self.operand(f, a.Reg)))
            }
        }
        self.p(fmt.sprintf("  Value *%s = vl_slice_data(%s_s);", name, name))
        return name, fmt.sprintf("(int)vl_len(%s_s)", name)
    }

    // release_argv frees the temporary slice a spread call built (it is an
    // owned value; leaving it unreleased leaked one slice per call).
    func release_argv(mut self, id int, spec str) {
        each a in parse_args(spec) {
            if a.Spread {
                self.p(fmt.sprintf("  vl_release(a%d_s);", id))
                return
            }
        }
    }

    func emit_func(mut self, idx int, f ir.Func) {
        self.p(fmt.sprintf("/* %s — %s */", f.Name, f.Sig))
        self.p(fmt.sprintf("static Value %s(Value *argv, int argc, " ||
                           "VlFrame *up) \{", c_func_name(idx)))
        var nregs = f.NRegs
        if nregs < 1 { nregs = 1 }
        if f.Elide {
            // Frame elision (-O2): the registers live in THIS call's C stack
            // frame. Everything downstream — push, unwinding, PMATCH writes,
            // the epilogue — is unchanged, because a stack frame is
            // layout-identical to a heap one; only the allocator differs.
            self.p(fmt.sprintf("  VL_FRAME_ON_STACK(F, %d, up);", nregs))
        } else {
            self.p(fmt.sprintf("  VlFrame *F = vl_frame_new(%d, up);", nregs))
        }
        self.p("  vl_frame_push(F);")
        self.p(fmt.sprintf("  F->info = &fi_%d;", idx))
        self.p("  Value __ret = vl_unit();")
        self.p("  (void)argc;")
        // Typed registers (-O3) are C locals beside the frame; their frame
        // slots stay nil forever. The `= 0` default is unobservable: no
        // accepted program reads a register before a def (see typing.voi).
        each ri, rt in f.RegT {
            if rt == ir.RT_INT {
                self.p(fmt.sprintf("  int64_t r%d_i = 0;", ri))
            } else if rt == ir.RT_FLOAT {
                self.p(fmt.sprintf("  double r%d_f = 0;", ri))
            } else if rt == ir.RT_BOOL {
                self.p(fmt.sprintf("  bool r%d_b = false;", ri))
            }
        }
        // Parameters land in the lowest registers. Under -O the spill stops
        // at NParams: slots past the declared parameters are temporaries no
        // instruction ever reads before writing, so spilling extra call
        // arguments into them was always dead weight.
        var spill = nregs
        if self.mod.OptLevel >= 1 and f.NParams < spill {
            spill = f.NParams
        }
        self.p(fmt.sprintf("  for (int i = 0; i < argc && i < %d; i++) " ||
                           "vl_set(&F->r[i], vl_retain(argv[i]));", spill))

        // The frame's line (VlFrame.line, for stack traces) is stored before
        // the first instruction of a source line that can FAIL — one store
        // per line, and none for the moves, constants and jumps that cannot
        // trap. A label is a join point whose predecessor's line is unknown,
        // so it forgets the last line stored.
        var seq = 0
        var lastLine = 0
        each ins in f.Instrs {
            each l in ins.Labels {
                self.p(fmt.sprintf(" %s: ;", l))
                lastLine = 0
            }
            seq += 1
            if ins.Src > 0 and ins.Src != lastLine and
               self.can_fail(f, ins) {
                self.p(fmt.sprintf("  F->line = %d;", ins.Src))
                lastLine = ins.Src
            }
            self.emit_instr(f, ins, seq)
        }

        self.p(" __exit: ;")
        self.p("  vl_frame_pop_run_defers(F);")
        self.p("  vl_frame_clear(F); /* break frame<->closure cycles " ||
               "before releasing */")
        self.p("  vl_frame_release(F);")
        self.p("  return __ret;")
        self.p("\}")
        self.p("")
    }

    // emit_ctors writes the constructor functions variant_ctor minted while
    // the bodies were generated: a payload variant used as a first-class
    // value (`xs.map(Shape.Circle)`) is a function of its payload.
    func emit_ctors(mut self) {
        each i, c in self.ctors {
            let typ, variant = split_variant(c)
            self.p(fmt.sprintf("static Value vc_%d(Value *argv, int argc, " ||
                               "VlFrame *up) \{", i))
            self.p("  (void)up;")
            self.p(fmt.sprintf("  return vl_enum_new(%s, %s, argv, argc);",
                               c_quote(typ), c_quote(variant)))
            self.p("\}")
        }
        if len(self.ctors) > 0 { self.p("") }
    }

    // declares_type reports whether the program declares a type `name`.
    func declares_type(self, name str) bool {
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if (n.Kind == ast.STRUCTDEC or n.Kind == ast.ENUMDEC or
                n.Kind == ast.TYPEDEC or n.Kind == ast.EXCDEC) and
               n.Sval == name {
                return true
            }
        }
        return false
    }

    // alias_node is the target type node of `type name = T`, or 0.
    func alias_node(self, name str) int {
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.TYPEDEC and n.Ival2 == 1 and n.Sval == name {
                return n.Ival
            }
        }
        return 0
    }

    // can_fail reports whether an instruction can trap, abort or throw —
    // the ones whose source line a stack trace needs. Conservative: an op
    // not listed as safe counts as fallible.
    func can_fail(self, f ir.Func, ins ir.Instr) bool {
        let op = ins.Op
        if op == "*" or op == "LOADK" or op == "MOVE" or op == "JUMP" or
           op == "RET" or op == "NDSAVE" or op == "NDREST" or
           op == "ARGDEF" or op == "GETGLB" or op == "SETGLB" or
           op == "MKCLOS" or op == "ZERO" or op == "TUPLE" or
           op == "NEWSLICE" or op == "NEWMAP" or op == "NEWSET" or
           op == "ISFAIL" or op == "EHPUSH" or op == "EHPOP" or
           op == "CATCH" or op == "CATCHF" or op == "LOADFN" or
           op == "DROP" or
           op == "SELBEG" or op == "SELRECV" or op == "SELSEND" or
           op == "SELDEF" or op == "VARARG" or op == "TYPEOF" {
            return false
        }
        // At -O3 a native comparison, bit operation or branch on a typed
        // bool cannot trap.
        if len(f.RegT) > 0 and len(ins.Args) > 0 {
            let d = reg_slot(ins.Args[0])
            if (op == "JMPF" or op == "JMPT") and d >= 0 and
               self.rt(f, d) == ir.RT_BOOL {
                return false
            }
            if d >= 0 and self.rt(f, d) != ir.RT_BOX and
               (op == "CMPLT" or op == "CMPLE" or op == "CMPGT" or
                op == "CMPGE" or op == "CMPEQ" or op == "CMPNE" or
                op == "BAND" or op == "BOR" or op == "BXOR" or
                op == "BNOT" or op == "NOT") {
                return false
            }
        }
        return true
    }

    // ------------------------------------------------------------ table

    // collect_inherited works out which trait defaults each implementor
    // inherits, and it runs BEFORE a single body is emitted. That timing is
    // the point: a method reaches its body by two roads, and only one of them
    // is the method table. `p.subtitle()` becomes a CALLM the runtime resolves
    // through vl_find_method, but `Page.subtitle()` — the spelling a self-less
    // default has no alternative to — lowers to a CALL naming `Page.subtitle`,
    // which instr.voi resolves through fnIdx and nowhere else. So an inherited
    // default is registered in BOTH: a row here, and an fnIdx entry pointing
    // the written-out name at the one shared body. Deferring this to
    // emit_method_table would leave every static call unresolved and the
    // backend refusing a program `check` had already passed.
    func collect_inherited(mut self) {
        // Trait declarations by their FLAT name. The loader has already
        // flattened both sides — a TRAITDEC's Sval and the `impl X for T`
        // header's — to the same string (§11.2.1), so the two match without
        // this stage knowing anything about packages. A trait may be declared
        // AFTER the impl block naming it, so the index is built first, in one
        // pass of its own. Last writer wins, as it does in chk.collect and in
        // fnIdx.
        var traits = make(map[str]int)
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.TRAITDEC { traits[n.Sval] = d }
        }
        if len(traits) == 0 { return }

        // `written` holds every (type, method) the program SPELLS OUT, taken
        // from the declaration rather than from anything downstream of it: a
        // method the program writes is the implementor's own, and a trait
        // default must never shadow it. Inherent impls and an exception's own
        // methods count — the table is flat, so they satisfy a trait exactly
        // as chk/traits.voi's union rule says they do.
        var written = set([])
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.IMPLDEC {
                let tn = self.impl_target(d)
                each m in self.T.Get(self.T.Kid(d, 0)).Kids {
                    written.add(tn || "|" || self.T.Get(m).Sval)
                }
            } else if n.Kind == ast.EXCDEC {
                each m in self.T.Get(self.T.Kid(d, 1)).Kids {
                    written.add(n.Sval || "|" || self.T.Get(m).Sval)
                }
            }
        }

        // One row per `impl Trait for T` method T did not write. An inherent
        // `impl T { … }` (Sval "") introduces no trait and inherits nothing.
        //
        // `written` also settles the case where one type implements two
        // traits that default the SAME method name: the first `impl` block in
        // declaration order claims the pair, and the second finds it taken.
        // That is the rule vl_find_method already applies when it searches
        // the finished table and returns the first match — decided here
        // instead, so the table carries one row rather than two.
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind != ast.IMPLDEC or n.Sval == "" { continue }
            if not (n.Sval in traits) { continue }   // builtin: no method list
            let tn = self.impl_target(d)
            if tn == "" { continue }
            each m in self.T.Get(self.T.Kid(traits[n.Sval], 0)).Kids {
                if self.T.Kind(m) != ast.FUNC { continue }
                // No body and no `= expr`: abstract, nothing to inherit.
                if self.T.Kid(m, 0) == 0 and self.T.Kid(m, 5) == 0 { continue }
                let mn = self.T.Get(m)
                let key = tn || "|" || mn.Sval
                let full = n.Sval || "$$" || mn.Sval
                if key in written or not (full in self.fnIdx) { continue }
                written.add(key)
                let fi = self.fnIdx[full]
                // The alias lets `T.m()` — a STATIC call, resolved through
                // fnIdx rather than the method table — reach the shared
                // body. It must never overwrite an existing entry: fnIdx is
                // one flat namespace where methods (`Type.method`) and
                // package-qualified functions (`pkg.Func`) both live, minted
                // with a dot by flattening. `written` already proves this
                // type declared no such method, so a key ALREADY here
                // belongs to something else — a package function `Box.Area`
                // beside a `Box` inheriting a default `Area` — and
                // clobbering it would silently redirect that call: the very
                // last-writer-wins failure `$$` was chosen to avoid.
                // ...and `known` as well as `fnIdx`. They are two DIFFERENT
                // namespaces and emit_call consults fnIdx FIRST, so an alias
                // that shadows a C native silently redirects every call to
                // it in the whole program — `impl Shouty for str { }`, an
                // empty block writing no method at all, rerouted every
                // `str.upper` while `"x".upper()` still reached the native,
                // so the two roads disagreed. `written` proves only that the
                // TYPE declared no such method; it knows nothing about the
                // runtime's own names.
                let alias = tn || "." || mn.Sval
                if not (alias in self.fnIdx) and not (alias in self.known) {
                    self.fnIdx[alias] = fi
                }
                self.inherited.append(Method{Typ: tn, Name: mn.Sval, Fn: fi,
                                             HasSelf: (mn.Ival2 & 1) != 0})
            }
        }
    }

    // impl_target names the type an impl block attaches to — the TNAMED's
    // name, or "" for a target that is not a named type and so carries no
    // methods. The same answer chk/traits.voi's impl_target gives.
    func impl_target(self, d int) str {
        let te = self.T.Get(d).Ival
        if te == 0 or self.T.Kind(te) != ast.TNAMED { return "" }
        return self.T.Get(te).Sval
    }

    func emit_method_table(mut self) {
        var ms = []
        each d in self.T.Get(self.T.Kid(self.file, 1)).Kids {
            let n = self.T.Get(d)
            if n.Kind == ast.IMPLDEC {
                // The impl target: only a named type carries methods.
                let tn = self.impl_target(d)
                each m in self.T.Get(self.T.Kid(d, 0)).Kids {
                    let mn = self.T.Get(m)
                    let full = tn || "." || mn.Sval
                    if full in self.fnIdx {
                        ms.append(Method{Typ: tn, Name: mn.Sval,
                                         Fn: self.fnIdx[full],
                                         HasSelf: (mn.Ival2 & 1) != 0})
                    }
                }
            } else if n.Kind == ast.EXCDEC {
                each m in self.T.Get(self.T.Kid(d, 1)).Kids {
                    let mn = self.T.Get(m)
                    let full = n.Sval || "." || mn.Sval
                    if full in self.fnIdx {
                        ms.append(Method{Typ: n.Sval, Name: mn.Sval,
                                         Fn: self.fnIdx[full],
                                         HasSelf: (mn.Ival2 & 1) != 0})
                    }
                }
            }
        }
        // Inherited trait defaults, AFTER every explicit method: one compiled
        // body — low.lower_trait_default emitted it once under
        // `{Trait}$${method}` — serves every implementor that did not write
        // the method itself. collect_inherited decided which those are.
        each x in self.inherited { ms.append(x) }
        let sorted = sort_methods(ms)
        self.p("static const VlMethod g_methods[] = \{")
        each x in sorted {
            self.p(fmt.sprintf("  \{%s, %s, %s, %s\},", c_quote(x.Typ),
                               c_quote(x.Name), c_func_name(x.Fn),
                               bool_c(x.HasSelf)))
        }
        self.p("  \{NULL, NULL, NULL, false\}")
        self.p("\};")
        self.p(fmt.sprintf("static const int g_nmethods = %d;", len(sorted)))
        self.p("")
    }

    func emit_main(mut self) {
        self.p("int main(int argc, char **argv) \{")
        self.p("  vl_init(argc, argv);")
        self.p("  vl_register_types(g_types, g_ntypes, g_variants, " ||
               "g_nvariants, g_methods, g_nmethods);")
        self.p("  init_consts();")
        each j, dc in self.dfConv {
            let parts = str.split(dc, "|")
            self.p(fmt.sprintf("  DF[%d] = vl_conv(%s, K[%s], NULL);", j,
                               c_quote(parts[0]), parts[1]))
        }
        // Extension natives are found only once their table is registered.
        each u in self.ext_units() {
            self.p("  vl_ext_register(vl_ext_" || u || ");")
        }
        each i, name in self.nats {
            self.p(fmt.sprintf("  NAT[%d] = vl_lookup_fn(%s);", i,
                               c_quote(name)))
        }
        self.p(fmt.sprintf("  for (int i = 0; i < %d; i++) if (!NAT[i]) " ||
                           "\{ fprintf(stderr, \"voila: missing runtime " ||
                           "function\\n\"); return 1; \}", len(self.nats)))
        if "$INIT" in self.fnIdx {
            self.p(fmt.sprintf("  vl_release(%s(NULL, 0, NULL));",
                               c_func_name(self.fnIdx["$INIT"])))
        }
        if "$SCRIPT" in self.fnIdx {
            self.p(fmt.sprintf("  vl_release(%s(NULL, 0, NULL));",
                               c_func_name(self.fnIdx["$SCRIPT"])))
        }
        if "main" in self.fnIdx {
            self.p(fmt.sprintf("  Value r = %s(NULL, 0, NULL);",
                               c_func_name(self.fnIdx["main"])))
            self.p("  if (vl_isfail(r) && r.t != VL_NIL) \{")
            self.p("    Value m = vl_callm(r, \"message\", NULL, 0);")
            self.p("    fprintf(stderr, \"error: %s\\n\", vl_cstr(m));")
            self.p("    return 1;")
            self.p("  \}")
            self.p("  vl_release(r);")
        }
        self.p("  int code = vl_finish();")
        self.p(fmt.sprintf("  for (int i = 0; i < %d; i++) vl_release(G[i]);",
                           max(1, len(self.gnames))))
        self.p(fmt.sprintf("  for (int i = 0; i < %d; i++) vl_release(K[i]);",
                           max(1, len(self.mod.Consts))))
        self.p("  return code;")
        self.p("\}")
    }

    // ------------------------------------------------------------ types

    // type_text renders a declared type for the runtime's zero-value
    // constructor. An unhandled form (a borrow) renders as "", exactly as the
    // Go original's default branch does.
    func type_text(self, te int) str {
        if te == 0 { return "" }
        let n = self.T.Get(te)
        if n.Kind == ast.TNAMED  {
            // An ALIAS (`type X = T`) has no descriptor of its own: a field
            // declared with it zero-fills as its target does.
            let at = self.alias_node(n.Sval)
            if at != 0 and at != te { return self.type_text(at) }
            if len(n.Kids) > 0 and n.Sval == "Box" and
               not self.declares_type("Box") {
                // The predeclared Box keeps its element type: vl_zero
                // builds a Box of the element's zero.
                return "Box[" || self.type_text(n.Kids[0]) || "]"
            }
            return n.Sval
        }
        if n.Kind == ast.TOPTION {
            return "?" || self.type_text(self.T.Kid(te, 0))
        }
        if n.Kind == ast.TRESULT {
            return self.type_text(self.T.Kid(te, 0)) || "!"
        }
        if n.Kind == ast.TSLICE {
            return "[]" || self.type_text(self.T.Kid(te, 0))
        }
        if n.Kind == ast.TMAP {
            return "map[" || self.type_text(self.T.Kid(te, 0)) || "]" ||
                   self.type_text(self.T.Kid(te, 1))
        }
        if n.Kind == ast.TSET {
            return "set[" || self.type_text(self.T.Kid(te, 0)) || "]"
        }
        if n.Kind == ast.TCHAN {
            return "chan[" || self.type_text(self.T.Kid(te, 0)) || "]"
        }
        if n.Kind == ast.TBOX {
            var kind = "shared"
            if n.Ival2 == 1 {
                kind = "cell"
            } else if n.Ival2 == 2 {
                kind = "weak"
            }
            return kind || "[" || self.type_text(self.T.Kid(te, 0)) || "]"
        }
        if n.Kind == ast.TTUPLE { return "tuple" }
        if n.Kind == ast.TFN    { return "fn" }
        return ""
    }
}

// ---------------------------------------------------------------- helpers

func c_func_name(i int) str { return fmt.sprintf("vf_%d", i) }

// display_name renders an IR function name as a stack trace shows it: a
// closure, spawn or defer body (`main$fn2`, `Type.m$fn1$fn1`) as the
// function it is written in, a trait default (`Trait$$m`) as `Trait.m`, and
// the module and script initialisers by what they are.
func display_name(name str) str {
    if name == "$INIT" { return "<module init>" }
    if name == "$SCRIPT" { return "<script>" }
    let dd = str.index(name, "$$")
    if dd > 0 {
        let rest = name[dd + 2..len(name)]
        let d2 = str.index(rest, "$")
        if d2 >= 0 {
            return name[0..dd] || "." || rest[0..d2] || " (closure)"
        }
        return name[0..dd] || "." || rest
    }
    let d = str.index(name, "$")
    if d > 0 {
        var base = name[0..d]
        if base == "$INIT" or base == "" { base = "<module init>" }
        return base || " (closure)"
    }
    if d == 0 {
        // `$INIT$fn1`, `$SCRIPT$fn1`
        let inner = name[1..len(name)]
        let d3 = str.index(inner, "$")
        if d3 > 0 {
            var base = "<module init>"
            if inner[0..d3] == "SCRIPT" { base = "<script>" }
            return base || " (closure)"
        }
    }
    return name
}

func bool_c(b bool) str {
    if b { return "true" }
    return "false"
}

// is_literal reports whether a node kind is a basic literal — the only field
// default a native build can express.
func is_literal(k int) bool {
    return k == ast.INT or k == ast.FLOAT or k == ast.DEC or k == ast.STR or
           k == ast.RUNE or k == ast.BOOL or k == ast.NILLIT
}

func pat_kind_name(k int) str {
    if k == ir.PAT_WILD    { return "VL_P_WILD" }
    if k == ir.PAT_NIL     { return "VL_P_NIL" }
    if k == ir.PAT_LIT     { return "VL_P_LIT" }
    if k == ir.PAT_BIND    { return "VL_P_BIND" }
    if k == ir.PAT_VARIANT { return "VL_P_VARIANT" }
    if k == ir.PAT_OR      { return "VL_P_OR" }
    if k == ir.PAT_RANGE   { return "VL_P_RANGE" }
    if k == ir.PAT_STRUCT  { return "VL_P_STRUCT" }
    if k == ir.PAT_FIELD   { return "VL_P_FIELD" }
    if k == ir.PAT_TUPLE   { return "VL_P_TUPLE" }
    return ""
}

// STATIC_STR_MIN is the size from which a string constant is emitted as a
// static object rather than copied into the heap at start-up (emit_consts).
const STATIC_STR_MIN = 4096

// C_PLAIN is every byte c_quote writes unchanged AND as itself: printable
// ASCII except the quote and the backslash.
const C_PLAIN = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz\{|\}~"

// c_quote renders a C string literal. Bytes above 0x1f pass through — a UTF-8
// sequence is written raw, exactly as the Go original's byte loop does.
func c_quote(s str) str {
    // Fast path: a string of plain bytes only is its own C spelling. The
    // per-rune loop below costs a boxed write per character, and the
    // compiler's embedded payloads (voilac/rt, base64, megabytes) made it the
    // single largest cost of compiling the compiler. One C scan decides it,
    // and the output is byte-identical to the slow path's.
    if str.skip_any(s, C_PLAIN, 0) == len(s) {
        return "\"" || s || "\""
    }
    var b = str.Builder{}
    b.write("\"")
    each c in s {
        if c == '"' {
            b.write("\\\"")
        } else if c == '\\' {
            b.write("\\\\")
        } else if c == '\n' {
            b.write("\\n")
        } else if c == '\t' {
            b.write("\\t")
        } else if c == '\r' {
            b.write("\\r")
        } else if int(c) < 32 {
            b.write(fmt.sprintf("\\%03o", c))
        } else {
            b.write(str(c))
        }
    }
    b.write("\"")
    return b.done()
}

// c_float renders a float constant as a C literal: an integral text needs a
// `.0` so the C compiler reads it as a double.
func c_float(s str) str {
    if not is_float_text(s) { return "0" }
    if not contains_any(s, ".eE") { return s || ".0" }
    return s
}

func contains_any(s str, chars str) bool {
    each c in s {
        if str.contains(chars, str(c)) { return true }
    }
    return false
}

// is_float_text reports whether the text is a plain decimal float — the pool
// only ever holds %g-normalized text.
func is_float_text(s str) bool {
    var digits = 0
    each c in s {
        if int(c) >= 48 and int(c) <= 57 {
            digits += 1
        } else if c != '.' and c != 'e' and c != 'E' and c != '+' and
                  c != '-' {
            return false
        }
    }
    return digits > 0
}

func first_rune(s str) int {
    let rs = runes(s)
    if len(rs) == 0 { return 0 }
    return int(rs[0])
}

// atoi parses a non-negative decimal, returning -1 when the text is not one
// (the Go original treats strconv.Atoi's error the same way).
func atoi(s str) int {
    if len(s) == 0 { return 0 - 1 }
    var n = 0
    each c in s {
        if int(c) < 48 or int(c) > 57 { return 0 - 1 }
        n = n * 10 + (int(c) - 48)
    }
    return n
}

// reg_slot maps "r7" to 7, and anything else to -1.
func reg_slot(r str) int {
    var s = r
    if str.starts_with(s, "r") { s = s[1..len(s)] }
    return atoi(s)
}

// parse_int_text reads an integer literal the way Go's strconv.ParseInt(s, 0,
// 64) does: 0x/0o/0b radix prefixes, and a bare leading 0 means octal. A
// malformed literal yields 0, as the Go backend's ignored error does.
func parse_int_text(s0 str) int {
    var s = s0
    var neg = false
    if str.starts_with(s, "-") {
        neg = true
        s = s[1..len(s)]
    } else if str.starts_with(s, "+") {
        s = s[1..len(s)]
    }
    var base = 10
    if str.starts_with(s, "0x") or str.starts_with(s, "0X") {
        base = 16
        s = s[2..len(s)]
    } else if str.starts_with(s, "0o") or str.starts_with(s, "0O") {
        base = 8
        s = s[2..len(s)]
    } else if str.starts_with(s, "0b") or str.starts_with(s, "0B") {
        base = 2
        s = s[2..len(s)]
    } else if len(s) > 1 and str.starts_with(s, "0") {
        base = 8
        s = s[1..len(s)]
    }
    var n = 0
    each c in s {
        if c == '_' { continue }
        let d = digit_val(c)
        if d < 0 or d >= base { return 0 }
        n = n * base + d
    }
    if neg { return 0 - n }
    return n
}

func digit_val(c rune) int {
    let v = int(c)
    if v >= 48 and v <= 57  { return v - 48 }       // '0'..'9'
    if v >= 97 and v <= 102 { return v - 97 + 10 }  // 'a'..'f'
    if v >= 65 and v <= 70  { return v - 65 + 10 }  // 'A'..'F'
    return 0 - 1
}

// parse_args splits a rendered "(r1,name:r2,r3...)" operand.
func parse_args(spec str) []CallArg {
    var s = spec
    if str.ends_with(s, ")") { s = s[0..len(s) - 1] }
    if str.starts_with(s, "(") { s = s[1..len(s)] }
    if s == "" { return [] }
    var out = []
    each part0 in str.split(s, ",") {
        var part = part0
        var spread = false
        if str.ends_with(part, "...") {
            spread = true
            part = part[0..len(part) - 3]
        }
        var name = ""
        let i = str.index(part, ":")
        if i >= 0 {
            name = part[0..i]
            part = part[i + 1..len(part)]
        }
        out.append(CallArg{Reg: part, Name: name, Spread: spread})
    }
    return out
}

// sort_methods orders the method table by (type, name), stably — the Go
// original's sort.SliceStable. Insertion sort keeps equal keys in source
// order, which is what "stable" buys us.
func sort_methods(ms []Method) []Method {
    var out = []
    each m in ms {
        var i = len(out)
        while i > 0 and method_less(m, out[i - 1]) {
            i -= 1
        }
        out.append(m)
        var j = len(out) - 1
        while j > i {
            out[j] = out[j - 1]
            j -= 1
        }
        out[i] = m
    }
    return out
}

func method_less(a Method, b Method) bool {
    if a.Typ != b.Typ { return a.Typ < b.Typ }
    return a.Name < b.Name
}

// ------------------------------------------------------------------ ffi

// FFI_MAX_VARARGS bounds the variadic arguments one foreign call may pass
// (cg/instr.voi's emit_ffi spells out every arrangement up to it).
const FFI_MAX_VARARGS = 6

// FfiSig is a parsed C signature: the FFI instruction's second operand,
// "@name|result|param,param,…|variadic" (ast.FUNC_FFI).
struct FfiSig {
    name     str
    ret      str
    params   []str
    variadic bool
}

func parse_ffi_sig(s str) FfiSig {
    let parts = str.split(s[1..len(s)], "|")
    var ps = []
    if parts[2] != "" { ps = str.split(parts[2], ",") }
    return FfiSig{name: parts[0], ret: parts[1], params: ps,
                  variadic: parts[3] == "1"}
}

// ffi_ctype_c is the C spelling of a type code (par.ffi_ctype).
func ffi_ctype_c(ct str) str {
    if ct == "i8" { return "signed char" }
    if ct == "u8" { return "unsigned char" }
    if ct == "i16" { return "short" }
    if ct == "u16" { return "unsigned short" }
    if ct == "i32" { return "int" }
    if ct == "u32" { return "unsigned int" }
    if ct == "i64" { return "long long" }
    if ct == "u64" { return "unsigned long long" }
    if ct == "f32" { return "float" }
    if ct == "f64" { return "double" }
    if ct == "bool" { return "_Bool" }
    if ct == "cstr" { return "const char *" }
    if ct == "ptr" { return "void *" }
    return "void"
}

// ffi_arg unboxes one argument for a C parameter of type code `ct`. The
// static type of the declaration already range-checked a narrow integer on
// entry (a sized parameter, §3.2), so the cast cannot lose a value.
func ffi_arg(ct str, v str, i int, fname str) str {
    if ct == "f32" or ct == "f64" {
        return fmt.sprintf("(%s)vl_ffi_float(%s, %d, %s)", ffi_ctype_c(ct),
                           v, i, fname)
    }
    if ct == "bool" { return fmt.sprintf("vl_ffi_bool(%s, %d, %s)", v, i, fname) }
    if ct == "cstr" { return fmt.sprintf("vl_ffi_cstr(%s, %d, %s)", v, i, fname) }
    if ct == "ptr" { return fmt.sprintf("vl_ffi_ptr(%s, %d, %s)", v, i, fname) }
    return fmt.sprintf("(%s)vl_ffi_int(%s, %d, %s)", ffi_ctype_c(ct), v, i,
                       fname)
}

// ffi_box boxes the C result `fr_` of type code `ct` as an owned Value.
func ffi_box(ct str) str {
    if ct == "void" { return "vl_unit()" }
    if ct == "u64" { return "vl_ffi_ret_u64(fr_)" }
    if ct == "f32" or ct == "f64" { return "vl_float((double)fr_)" }
    if ct == "bool" { return "vl_bool(fr_)" }
    if ct == "cstr" { return "vl_ffi_ret_cstr(fr_)" }
    if ct == "ptr" { return "vl_ffi_ret_ptr(fr_)" }
    return "vl_int((int64_t)fr_)"
}

// up_mask is "0,1,…" — 1 for each register of function fi that a closure of
// it (a descendant: `name$fn…`) reads through an upvalue — or "" when none
// is. Over-marking a deeper ancestor's slot only keeps a closure alive a
// little longer; the frame's release path still frees the cycle.
func up_mask(m ir.Module, fi int) str {
    let f = m.Funcs[fi]
    if f.NRegs == 0 { return "" }
    var bits = []
    var i = 0
    while i < f.NRegs {
        bits.append(false)
        i += 1
    }
    var any = false
    let prefix = f.Name || "$fn"
    each g in m.Funcs {
        if str.starts_with(g.Name, prefix) {
            each u in g.Ups {
                if u.Slot >= 0 and u.Slot < f.NRegs {
                    bits[u.Slot] = true
                    any = true
                }
            }
        }
    }
    if not any { return "" }
    var out = []
    each b in bits {
        if b {
            out.append("1")
        } else {
            out.append("0")
        }
    }
    return str.join(out, ",")
}
