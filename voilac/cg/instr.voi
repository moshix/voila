// cg/instr.voi — one IR instruction, one C statement.
//
// The name tables below decide what a native build can express: a program
// using anything the C runtime does not provide fails at BUILD time with a
// clear message rather than at run time.
package cg

use "voilac/ir"
use "voilac/low"
use "std/str"
use "std/fmt"

// prelude_natives are the built-in functions the C runtime provides.
func prelude_natives() []str {
    return ["len", "append", "close", "err", "errf", "assert", "min", "max",
            "abs", "sum", "avg", "round", "floor", "ceil", "trunc",
            "round_to", "range", "zip", "enumerate", "keys", "values",
            "shared", "cell", "weak", "Box", "set", "printf", "sprintf",
            "to_int", "to_i8", "to_i16", "to_i32", "to_i64", "to_u8",
            "to_u16", "to_u32", "to_u64", "to_byte", "to_float", "to_dec",
            "to_rune",
            "wrap_i8", "wrap_i16", "wrap_i32", "wrap_i64", "wrap_u8",
            "wrap_u16", "wrap_u32", "wrap_u64", "sat_i8", "sat_i16",
            "sat_i32", "sat_i64", "sat_u8", "sat_u16", "sat_u32", "sat_u64",
            "wrap_add", "wrap_mul"]
}

// str_natives are std/str's functions, reachable bare (the method-call
// duality s.upper() == str.upper(s)) and as `str.NAME`.
func str_natives() []str { return low.StrMethodNames() }

// pkg_natives are the package-qualified names the C runtime provides. Both
// halves are spliced in from low/names.voi rather than written here — the C
// packages' from low.StdCNatives, the VOILÀ-SOURCE packages' (net, sync,
// time) from low.StdSrcNatives. chk needs each sublist on its own to tell a
// native from a typo and must not import cg, so this is the splice and not a
// second copy.
func pkg_natives() []str {
    var out = []
    each n in low.StdCNatives() {
        out.append(n)
    }
    each n in low.StdSrcNatives() {
        out.append(n)
    }
    return out
}

// known_native_names is the full set: prelude, std/str (bare and qualified),
// and the packages.
func known_native_names() []str {
    var out = []
    each n in prelude_natives() {
        out.append(n)
    }
    each n in str_natives() {
        out.append(n)
        out.append("str." || n)
    }
    each n in pkg_natives() {
        out.append(n)
    }
    return out
}

// pkg_constant_names are package CONSTANTS rather than functions: LOADFN of
// one of these yields a value, not a callable, so it must NOT be registered in
// the natives table (which the runtime resolves as function pointers). The one
// copy is low.PkgConstantNames, for the same reason as pkg_natives above:
// chk/stdpkg.voi accepts `os.stdout` on the strength of it.
func pkg_constant_names() []str { return low.PkgConstantNames() }

func bin_op_fns() map[str]str {
    var m = make(map[str]str)
    m["ADD"]   = "vl_add"
    m["SUB"]   = "vl_sub"
    m["MUL"]   = "vl_mul"
    m["DIV"]   = "vl_div"
    m["IDIV"]  = "vl_idiv"
    m["MOD"]   = "vl_mod"
    m["POW"]   = "vl_pow"
    m["CAT"]   = "vl_cat"
    m["SHL"]   = "vl_shl"
    m["SHR"]   = "vl_shr"
    m["BAND"]  = "vl_band"
    m["BOR"]   = "vl_bor"
    m["BXOR"]  = "vl_bxor"
    m["CMPEQ"] = "vl_cmpeq"
    m["CMPNE"] = "vl_cmpne"
    m["CMPLT"] = "vl_cmplt"
    m["CMPLE"] = "vl_cmple"
    m["CMPGT"] = "vl_cmpgt"
    m["CMPGE"] = "vl_cmpge"
    m["CMPIN"] = "vl_cmpin"
    return m
}

func un_op_fns() map[str]str {
    var m = make(map[str]str)
    m["NEG"]  = "vl_neg"
    m["NOT"]  = "vl_not"
    m["BNOT"] = "vl_bnot"
    return m
}

// sz_code maps a sized integer type name to the runtime's VL_SZ_* code
// (voila.h): i8 i16 i32 u8 u16 u32 u64 → 1…7.
func sz_code(t str) int {
    if t == "i8"  { return 1 }
    if t == "i16" { return 2 }
    if t == "i32" { return 3 }
    if t == "u8"  { return 4 }
    if t == "u16" { return 5 }
    if t == "u32" { return 6 }
    return 7
}

// sz_op_code maps a sized-capable IR op to vl_arith_sz's operator code, or
// -1 for an op that has no sized form.
func sz_op_code(op str) int {
    if op == "ADD"  { return 0 }
    if op == "SUB"  { return 1 }
    if op == "MUL"  { return 2 }
    if op == "POW"  { return 3 }
    if op == "IDIV" { return 4 }
    return 0 - 1
}

// split_variant divides `pkg.Enum.Variant` into its type and variant halves at
// the LAST dot — the type name itself may be package-qualified.
func split_variant(name str) (str, str) {
    let i = str.last_index(name, ".")
    if i < 0 { return name, name }
    return name[0..i], name[i + 1..len(name)]
}

impl Gen {
    // is_variant reports whether type.variant names an enum variant: `typ`
    // must be an enum this module declares (the IR's type table says so).
    func is_variant(self, typ str, variant str) bool {
        return len(self.variant_call(typ || "." || variant)) > 0
    }

    // variant_ctor returns the C name of the constructor function for one
    // payload variant used as a VALUE (`let mk = Shape.Circle`), minting it
    // on first use. Each is a three-line function emitted after the
    // prototypes (see emit_ctors), so the closure LOADFN builds is an
    // ordinary closure over no frame.
    func variant_ctor(mut self, typ str, variant str) str {
        let key = typ || "." || variant
        each i, c in self.ctors {
            if c == key { return fmt.sprintf("vc_%d", i) }
        }
        self.ctors.append(key)
        return fmt.sprintf("vc_%d", len(self.ctors) - 1)
    }

    // variant_call recognizes a CALL whose name is Enum.Variant; it returns
    // [type, variant], or an empty slice when the name is not one.
    func variant_call(self, name str) []str {
        if not str.contains(name, ".") { return [] }
        let typ, variant = split_variant(name)
        each t in self.mod.Types {
            if t.Kind == "ENUM" and t.Name == typ {
                return [typ, variant]
            }
        }
        return []
    }

    // ------------------------------------------------------------ dispatch

    // emit_instr writes one instruction as C.
    // const_is_immediate reports whether "Kn" names a pool constant of an
    // immediate kind — one whose retain/release are no-ops.
    func const_is_immediate(self, a str) bool {
        if len(a) < 2 { return false }
        if a[0] != 'K' { return false }
        var v = 0
        var i = 1
        while i < len(a) {
            let c = a[i]
            if c < '0' or c > '9' { return false }
            v = v * 10 + (c - 48)
            i += 1
        }
        if v >= len(self.mod.Consts) { return false }
        let k = self.mod.Consts[v].Kind
        return k == ir.CINT or k == ir.CFLOAT or k == ir.CBOOL or
               k == ir.CRUNE or k == ir.CNIL or k == ir.CUNIT
    }

    func emit_instr(mut self, f ir.Func, ins ir.Instr, seq int) {
        let a = ins.Args

        // -O3: instructions whose destination is a typed register render as
        // native C arithmetic. Everything not handled there falls through to
        // the boxed paths below, where operand() boxes typed sources on
        // demand and dst() rejects typed destinations (the transfer function
        // guarantees they cannot occur).
        if len(f.RegT) > 0 {
            if self.emit_native(f, ins) { return }
        }

        // A SIZED arithmetic op (a fourth operand naming the type, see
        // low/sized.voi) goes through the range-checking form.
        if len(a) > 3 and sz_op_code(ins.Op) >= 0 {
            self.p(fmt.sprintf("  vl_set(&%s, vl_arith_sz(%d, %s, %s, %d));",
                               self.dst(f, a[0]), sz_op_code(ins.Op),
                               self.operand(f, a[1]), self.operand(f, a[2]),
                               sz_code(a[3])))
            return
        }
        if ins.Op == "NEG" and len(a) > 2 {
            self.p(fmt.sprintf("  vl_set(&%s, vl_neg_sz(%s, %d));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               sz_code(a[2])))
            return
        }
        if ins.Op in self.binOp {
            let fn = self.binOp[ins.Op]
            self.p(fmt.sprintf("  vl_set(&%s, %s(%s, %s));",
                               self.dst(f, a[0]), fn, self.operand(f, a[1]),
                               self.operand(f, a[2])))
            return
        }
        if ins.Op in self.unOp {
            let fn = self.unOp[ins.Op]
            self.p(fmt.sprintf("  vl_set(&%s, %s(%s));", self.dst(f, a[0]),
                               fn, self.operand(f, a[1])))
            return
        }

        switch ins.Op {
        case "*":   // listing-only comment
            return

        case "LOADK", "MOVE":
            // Retain-elision (-O1+): an IMMEDIATE constant (int, float, bool,
            // rune, nil, unit) owns nothing — vl_retain of it is the
            // identity, and the frame's eventual release of the slot is a
            // no-op. Only constants are elided here: a register's kind is
            // unknown until the -O3 typing pass. Gated on OptLevel so an
            // unoptimized build emits exactly what it always did.
            if self.mod.OptLevel >= 1 and ins.Op == "LOADK" and
               self.const_is_immediate(a[1]) {
                self.p(fmt.sprintf("  vl_set(&%s, %s);",
                                   self.dst(f, a[0]), self.operand(f, a[1])))
            } else {
                self.p(fmt.sprintf("  vl_set(&%s, vl_retain(%s));",
                                   self.dst(f, a[0]), self.operand(f, a[1])))
            }

        case "CKSZ":
            // A store into a sized location (low/sized.voi): range-check the
            // value in place. A typed register checks natively, with the
            // same cold trap.
            let r = reg_slot(a[0])
            if r >= 0 and self.rt(f, r) == ir.RT_INT {
                self.p(fmt.sprintf("  vl_cksz_i(r%d_i, %d);", r, sz_code(a[1])))
            } else {
                self.p(fmt.sprintf("  vl_cksz(%s, %d);", self.operand(f, a[0]),
                                   sz_code(a[1])))
            }

        case "ZERO":
            self.p(fmt.sprintf("  vl_set(&%s, vl_zero(%s));",
                               self.dst(f, a[0]), c_quote(a[1])))

        case "GETGLB":
            self.p(fmt.sprintf("  vl_set(&%s, vl_retain(G[%d]));",
                               self.dst(f, a[0]), self.globals[a[1]]))
        case "SETGLB":
            self.p(fmt.sprintf("  vl_set(&G[%d], vl_retain(%s));",
                               self.globals[a[0]], self.operand(f, a[1])))

        case "UPSET":
            if not f.HasUp(a[0]) {
                self.failf(fmt.sprintf("cgen: unresolved upvalue `%s` in %s",
                                       a[0], f.Name))
                return
            }
            let up = f.Up(a[0])
            self.p(fmt.sprintf("  vl_upset(F->up, %d, %d, vl_retain(%s));",
                               up.Depth - 1, up.Slot, self.operand(f, a[1])))

        case "LOADFN":
            self.emit_loadfn(f, a)

        case "GETCTX":
            self.failf("cgen: `ctx` is not available in native builds yet")

        case "JUMP":
            self.p(fmt.sprintf("  goto %s;", a[0]))
        case "JMPF":
            self.p(fmt.sprintf("  if (!vl_truthy(%s)) goto %s;",
                               self.operand(f, a[0]), a[1]))
        case "JMPT":
            self.p(fmt.sprintf("  if (vl_truthy(%s)) goto %s;",
                               self.operand(f, a[0]), a[1]))

        case "RET":
            if len(a) == 0 {
                self.p("  __ret = vl_unit(); goto __exit;")
            } else {
                self.p(fmt.sprintf("  __ret = vl_retain(%s); goto __exit;",
                                   self.operand(f, a[0])))
            }

        case "ABORT":
            self.p(fmt.sprintf("  vl_abort(\"%%s\", %s);",
                               c_quote(str.strip(a[0], "'"))))

        case "CKCANC":
            self.p("  vl_check_cancelled();")

        case "CALL":
            self.emit_call(f, a, seq)

        case "CALLR":
            let argv, n = self.emit_argv(f, seq, a[2])
            self.p(fmt.sprintf("  vl_set(&%s, vl_call(%s, %s, %s));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               argv, n))
            self.release_argv(seq, a[2])

        case "CALLM":
            let argv, n = self.emit_argv(f, seq, a[3])
            if len(a) > 4 {
                // a[4]: the receiver's STATIC type when the run time
                // cannot know it — a sized integer is an `int` at run time
                // (low/expr.voi) — tried first in the method table.
                self.p(fmt.sprintf("  vl_set(&%s, vl_callm_as(%s, %s, %s, " ||
                                   "%s, %s));", self.dst(f, a[0]),
                                   self.operand(f, a[1]), c_quote(a[4]),
                                   c_quote(a[2]), argv, n))
            } else {
                self.p(fmt.sprintf("  vl_set(&%s, vl_callm(%s, %s, %s, %s));",
                                   self.dst(f, a[0]), self.operand(f, a[1]),
                                   c_quote(a[2]), argv, n))
            }
            self.release_argv(seq, a[3])

        case "SELFTY":
            // The type a trait default was DISPATCHED as (its `Self`), read
            // once at entry (runtime/src/call.c, vl_self_desc).
            self.p(fmt.sprintf("  vl_set(&%s, vl_self_desc(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))

        case "CALLT":
            // A static trait method through a type descriptor
            // (low/traitdesc.voi): a[1] holds the type's flat name.
            let argv, n = self.emit_argv(f, seq, a[3])
            self.p(fmt.sprintf("  vl_set(&%s, vl_callt(%s, %s, %s, %s));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               c_quote(a[2]), argv, n))
            self.release_argv(seq, a[3])

        case "UNIQ":
            // A Box's or a struct's copy-on-write (low/boxcow.voi). a[2] is
            // the threshold: digits, or a register holding a count RCOUNT
            // took. a[3…] say where to WRITE BACK a copy — `fld ro name`,
            // `idx rc ri`, `glb name`, `up name` — and nothing is written
            // unless the value was actually copied. The tag is tested
            // inline, so anything else costs two comparisons and no
            // reference-count traffic.
            let ud = self.dst(f, a[0])
            let us = self.operand(f, a[1])
            var thr = a[2]
            if str.starts_with(thr, "r") {
                thr = "(" || self.operand(f, thr) || ").u.i"
            }
            var wb = ""
            if len(a) > 3 and a[3] == "fld" {
                wb = fmt.sprintf(" vl_setfld(%s, %s, vl_retain(nb%d));",
                                 self.operand(f, a[4]), c_quote(a[5]), seq)
            } else if len(a) > 3 and a[3] == "idx" {
                wb = fmt.sprintf(" vl_setidx(%s, %s, vl_retain(nb%d));",
                                 self.operand(f, a[4]), self.operand(f, a[5]),
                                 seq)
            } else if len(a) > 3 and a[3] == "glb" {
                wb = fmt.sprintf(" vl_set(&G[%d], vl_retain(nb%d));",
                                 self.globals[a[4]], seq)
            } else if len(a) > 3 and a[3] == "up" {
                if not f.HasUp(a[4]) {
                    self.failf(fmt.sprintf("cgen: unresolved upvalue `%s` " ||
                                           "in %s", a[4], f.Name))
                    return
                }
                let up = f.Up(a[4])
                wb = fmt.sprintf(" vl_upset(F->up, %d, %d, vl_retain(nb%d));",
                                 up.Depth - 1, up.Slot, seq)
            }
            // A STRUCT is copied on write too (vl_cow_unique): structs
            // have value semantics (§3.4, §6.4), and the two tag tests are
            // still the whole cost for anything else.
            // A STRUCT and a CONTAINER are copied on write too (§3.4,
            // §6.4): the kind mask is one test, and the count another. A
            // temporary still holding the value would count as an owner;
            // low/kill.voi drops every dead one first.
            self.p(fmt.sprintf("  if (%s.t == VL_OBJ && ((1u << %s.u.o->kind) " ||
                               "& VL_COW_KINDS) && %s.u.o->rc > %s) \{ " ||
                               "Value nb%d = vl_cow_unique(%s, %s);" ||
                               "%s vl_set(&%s, nb%d); \}", us, us, us, thr,
                               seq, us, thr, wb, ud, seq))
            if ud != us {
                self.p(fmt.sprintf("  else vl_set(&%s, vl_retain(%s));", ud,
                                   us))
            }

        case "KILL":
            // A temporary no instruction reads again (low/kill.voi): its
            // reference is dropped now rather than when the register is next
            // written, so it does not count as an owner of the value. A
            // natively typed register (-O3) holds no reference at all.
            let ks = reg_slot(a[0])
            if ks >= 0 and self.rt(f, ks) == ir.RT_BOX {
                // "v" (low.kill_scope) marks the end of a binding's scope:
                // the value dies there whatever it is (§6) — a `shared` one
                // included, so a `weak` to it stops upgrading.
                self.p(fmt.sprintf("  if (F->r[%d].t == VL_OBJ) \{ " ||
                                   "Value k_ = F->r[%d]; F->r[%d].t = " ||
                                   "VL_NIL; vl_release(k_); \}", ks, ks, ks))
            }

        case "ESCAPE":
            // The closure in a[0] may escape its task (low/expr.voi): mark
            // its frame chain before the value goes anywhere.
            self.p(fmt.sprintf("  vl_closure_escapes(%s);",
                               self.operand(f, a[0])))

        case "VARREAD":
            // A captured variable read as an owned snapshot (low/expr.voi,
            // vl_varread): a[1] is its register here or its `^name`; a
            // "fixed" binding (never written after it is made) is read
            // with a plain reference — no write can replace it.
            let src = a[1]
            let fixed = len(a) > 2 and a[2] == "fixed"
            if str.starts_with(src, "^") {
                let rn = src[1..len(src)]
                if not f.HasUp(rn) {
                    self.failf(fmt.sprintf("cgen: unresolved upvalue `%s` " ||
                                           "in %s", rn, f.Name))
                    return
                }
                let up = f.Up(rn)
                if fixed {
                    self.p(fmt.sprintf("  vl_set(&%s, vl_retain(vl_up(F->up, " ||
                                       "%d, %d)));", self.dst(f, a[0]),
                                       up.Depth - 1, up.Slot))
                } else {
                    self.p(fmt.sprintf("  vl_set(&%s, vl_varread(vl_frame_up(" ||
                                       "F->up, %d), %d));", self.dst(f, a[0]),
                                       up.Depth - 1, up.Slot))
                }
            } else if self.rt(f, reg_slot(src)) != ir.RT_BOX {
                // Natively typed (-O3): a scalar no closure reads through
                // the frame (a name-only capture) — nothing to share.
                self.p(fmt.sprintf("  vl_set(&%s, vl_retain(%s));",
                                   self.dst(f, a[0]), self.operand(f, src)))
            } else if fixed {
                self.p(fmt.sprintf("  vl_set(&%s, vl_retain(F->r[%d]));",
                                   self.dst(f, a[0]), reg_slot(src)))
            } else {
                self.p(fmt.sprintf("  vl_set(&%s, vl_varread(F, %d));",
                                   self.dst(f, a[0]), reg_slot(src)))
            }

        case "SHAREDTHR":
            // The copy-in threshold of a `mut` argument in a captured
            // variable (low/boxcow.voi, private_copy): 0 — copy whatever
            // it is — once a closure over the variable's frame may escape
            // its task (VlFrame.escapes), beyond any count otherwise.
            let k = a[1]
            var fr = "F"
            if str.starts_with(k, "^") {
                let rn = k[1..len(k)]
                if not f.HasUp(rn) {
                    self.failf(fmt.sprintf("cgen: unresolved upvalue `%s` " ||
                                           "in %s", rn, f.Name))
                    return
                }
                fr = fmt.sprintf("vl_frame_up(F->up, %d)", f.Up(rn).Depth - 1)
            }
            self.p(fmt.sprintf("  vl_set(&%s, vl_int((%s)->escapes ? 0 : " ||
                               "INT64_MAX));", self.dst(f, a[0]), fr))

        case "VARLOCK", "VARUNLOCK":
            // A write through a variable closures capture, under its
            // frame's lock (low/boxcow.voi, var_root): a[0] is the
            // variable's register (this frame) or its `^name` upvalue.
            let k = a[0]
            var fr = "F"
            if str.starts_with(k, "^") {
                let rn = k[1..len(k)]
                if not f.HasUp(rn) {
                    self.failf(fmt.sprintf("cgen: unresolved upvalue `%s` " ||
                                           "in %s", rn, f.Name))
                    return
                }
                fr = fmt.sprintf("vl_frame_up(F->up, %d)", f.Up(rn).Depth - 1)
            }
            if ins.Op == "VARLOCK" {
                self.p(fmt.sprintf("  vl_varlock(%s);", fr))
            } else {
                self.p(fmt.sprintf("  vl_varunlock(%s);", fr))
            }

        case "RCOUNT":
            // The reference count of a value, for UNIQ's threshold (0 for
            // anything that is not an object).
            let rs = self.operand(f, a[1])
            self.p(fmt.sprintf("  vl_set(&%s, vl_int(%s.t == VL_OBJ ? " ||
                               "(int64_t)%s.u.o->rc : 0));",
                               self.dst(f, a[0]), rs, rs))

        case "TYPEOF":
            self.p(fmt.sprintf("  vl_set(&%s, vl_typedesc(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))

        case "CONV":
            if len(a) > 3 {
                self.p(fmt.sprintf("  Value cb%d = %s;", seq,
                                   self.operand(f, a[3])))
                self.p(fmt.sprintf("  vl_set(&%s, vl_conv(%s, %s, &cb%d));",
                                   self.dst(f, a[0]), c_quote(a[1]),
                                   self.operand(f, a[2]), seq))
            } else {
                self.p(fmt.sprintf("  vl_set(&%s, vl_conv(%s, %s, NULL));",
                                   self.dst(f, a[0]), c_quote(a[1]),
                                   self.operand(f, a[2])))
            }

        case "NEWCHAN":
            if len(a) > 1 {
                self.p(fmt.sprintf("  vl_set(&%s, " ||
                                   "vl_chan_new(vl_int_of(%s)));",
                                   self.dst(f, a[0]), self.operand(f, a[1])))
            } else {
                self.p(fmt.sprintf("  vl_set(&%s, vl_chan_new(0));",
                                   self.dst(f, a[0])))
            }

        case "NEWSLICE":
            let spec = a[1]
            if str.starts_with(spec, "[") {
                // make([]T, n) — sized, zero-filled.
                let reg = str.strip(spec, "[]")
                self.p(fmt.sprintf("  vl_set(&%s, " ||
                                   "vl_slice_new(vl_int_of(%s)));",
                                   self.dst(f, a[0]), self.operand(f, reg)))
                return
            }
            self.p(fmt.sprintf("  vl_set(&%s, vl_slice_new(0));",
                               self.dst(f, a[0])))
            each arg in parse_args(spec) {
                self.p(fmt.sprintf("  vl_slice_append(%s, vl_retain(%s));",
                                   self.dst(f, a[0]),
                                   self.operand(f, arg.Reg)))
            }

        case "NEWMAP":
            self.p(fmt.sprintf("  vl_set(&%s, vl_map_new());",
                               self.dst(f, a[0])))
        case "NEWSET":
            self.p(fmt.sprintf("  vl_set(&%s, vl_set_new());",
                               self.dst(f, a[0])))

        case "NEWRANGE":
            var by = "1"
            if a[3] != "1" {
                by = "vl_int_of(" || self.operand(f, a[3]) || ")"
            }
            self.p(fmt.sprintf("  vl_set(&%s, vl_range_new(vl_int_of(%s), " ||
                               "vl_int_of(%s), %s, %s));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               self.operand(f, a[2]), by,
                               bool_c(a[4] == "incl")))

        case "NEWSTRUCT", "NEWEXC":
            self.emit_composite(f, ins, seq, ins.Op == "NEWEXC")

        case "NEWENUM":
            let typ, variant = split_variant(a[1])
            let argv, n = self.emit_argv(f, seq, a[2])
            self.p(fmt.sprintf("  vl_set(&%s, vl_enum_new(%s, %s, %s, %s));",
                               self.dst(f, a[0]), c_quote(typ),
                               c_quote(variant), argv, n))
            self.release_argv(seq, a[2])

        case "TUPLE":
            let argv, n = self.emit_argv(f, seq, a[1])
            self.p(fmt.sprintf("  vl_set(&%s, vl_tuple_new(%s, %s));",
                               self.dst(f, a[0]), argv, n))
            self.release_argv(seq, a[1])

        case "UNTUPLE":
            each i, r in parse_args(a[0]) {
                if r.Reg == "_" { continue }
                self.p(fmt.sprintf("  vl_set(&%s, vl_index(%s, vl_int(%d)));",
                                   self.dst(f, r.Reg), self.operand(f, a[1]),
                                   i))
            }

        case "INDEX":
            self.p(fmt.sprintf("  vl_set(&%s, vl_index(%s, %s));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               self.operand(f, a[2])))
        case "SETIDX":
            self.p(fmt.sprintf("  vl_setidx(%s, %s, vl_retain(%s));",
                               self.operand(f, a[0]), self.operand(f, a[1]),
                               self.operand(f, a[2])))
        case "SLICE":
            self.p(fmt.sprintf("  vl_set(&%s, vl_slice_range(%s, %s));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               self.operand(f, a[2])))
        case "FIELD":
            self.p(fmt.sprintf("  vl_set(&%s, vl_field(%s, %s));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               c_quote(a[2])))
        case "SETFLD":
            self.p(fmt.sprintf("  vl_setfld(%s, %s, vl_retain(%s));",
                               self.operand(f, a[0]), c_quote(a[1]),
                               self.operand(f, a[2])))

        case "INTERP":
            let argv, n = self.emit_argv(f, seq, a[1])
            self.p(fmt.sprintf("  vl_set(&%s, vl_interp(%s, %s));",
                               self.dst(f, a[0]), argv, n))
            self.release_argv(seq, a[1])

        case "SAY":
            let argv, n = self.emit_argv(f, seq, a[0])
            self.p(fmt.sprintf("  vl_say(%s, %s);", argv, n))
            self.release_argv(seq, a[0])

        case "TOSTR":
            self.p(fmt.sprintf("  vl_set(&%s, vl_tostr(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))

        case "ISFAIL":
            self.p(fmt.sprintf("  vl_set(&%s, vl_bool(vl_isfail(%s)));",
                               self.dst(f, a[0]), self.operand(f, a[1])))

        case "TRYP":
            // `try expr`: a failure becomes this function's result (§8.1).
            self.p(fmt.sprintf("  if (vl_isfail(%s)) \{ __ret = " ||
                               "vl_retain(%s); goto __exit; \}",
                               self.operand(f, a[1]),
                               self.operand(f, a[1])))
            self.p(fmt.sprintf("  vl_set(&%s, vl_retain(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))

        case "MUST":
            self.p(fmt.sprintf("  vl_set(&%s, vl_must(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))

        case "THROW":
            if len(a) > 1 {
                self.p(fmt.sprintf("  vl_throw_from(%s, %s);",
                                   self.operand(f, a[0]),
                                   self.operand(f, a[1])))
            } else {
                self.p(fmt.sprintf("  vl_throw(%s);",
                                   self.operand(f, a[0])))
            }
        case "RETHROW":
            self.p(fmt.sprintf("  vl_rethrow(%s);", self.operand(f, a[0])))

        case "EHPUSH":
            self.p(fmt.sprintf("  VlHandler h%d;", seq))
            self.p(fmt.sprintf("  if (VL_TRY(h%d)) goto %s;", seq, a[0]))
        case "EHPOP":
            self.p("  vl_eh_pop();")
        case "CATCHF":
            // The in-flight exception, a fault included (low: try/finally).
            self.p(fmt.sprintf("  vl_set(&%s, vl_eh_pending());",
                               self.dst(f, a[0])))
        case "CATCH":
            self.p(fmt.sprintf("  vl_set(&%s, vl_eh_current());",
                               self.dst(f, a[0])))
        case "ISTYPE":
            self.p(fmt.sprintf("  vl_set(&%s, vl_bool(vl_istype(%s, %s)));",
                               self.dst(f, a[0]), self.operand(f, a[1]),
                               c_quote(str.strip(a[2], "'"))))

        case "NUMDIG":
            self.p(fmt.sprintf("  vl_numeric_digits(%s);", a[0]))
        case "NDSAVE":
            self.p("  vl_digits_save();")
        case "NDREST":
            self.p("  vl_digits_restore();")

        case "DROP":
            // The static checker already rejects use-after-move; nothing to
            // do.
            return

        case "DEFER":
            self.p(fmt.sprintf("  vl_defer(F, %s);", self.operand(f, a[0])))

        case "MKCLOS":
            if not (a[1] in self.fnIdx) {
                self.failf(fmt.sprintf("cgen: unknown closure %s", a[1]))
                return
            }
            // `env(r3,r5)`: the closure captures loop variables, which are
            // SNAPSHOT into a fresh frame of their own whose parent is this
            // one (low.lower_closure). The closure holds that frame; ours is
            // released as soon as the closure has retained it.
            var env = ""
            var k = 2
            while k < len(a) {
                if str.starts_with(a[k], "env(") { env = a[k] }
                k += 1
            }
            if env == "" {
                self.p(fmt.sprintf("  vl_set(&%s, vl_closure(%s, F));",
                                   self.dst(f, a[0]),
                                   c_func_name(self.fnIdx[a[1]])))
                return
            }
            let regs = parse_args(env[3..len(env)])
            self.p(fmt.sprintf("  \{ VlFrame *E%d = vl_frame_new(%d, F);",
                               seq, len(regs)))
            each i, r in regs {
                self.p(fmt.sprintf("    vl_set(&E%d->r[%d], vl_retain(%s));",
                                   seq, i, self.operand(f, r.Reg)))
            }
            self.p(fmt.sprintf("    vl_set(&%s, vl_closure(%s, E%d));",
                               self.dst(f, a[0]),
                               c_func_name(self.fnIdx[a[1]]), seq))
            self.p(fmt.sprintf("    vl_frame_release(E%d); \}", seq))

        case "GRPBEG":
            if len(a) > 0 {
                self.p(fmt.sprintf("  vl_group_begin(%s);",
                                   self.operand(f, a[0])))
            } else {
                self.p("  vl_group_begin(vl_nil());")
            }
        case "GRPEND":
            self.p("  vl_release(vl_group_end(false));")
        case "GRPENDT":
            self.p(fmt.sprintf("  \{ Value ge%d = vl_group_end(true);", seq))
            self.p(fmt.sprintf("    if (ge%d.t != VL_NIL) \{ __ret = ge%d; " ||
                               "goto __exit; \}", seq, seq))
            self.p(fmt.sprintf("    vl_release(ge%d); \}", seq))

        case "SPAWN":
            let name = a[1]
            let argv, n = self.emit_argv(f, seq, a[2])
            if name in self.fnIdx {
                self.p(fmt.sprintf("  vl_set(&%s, vl_spawn_fn(%s, %s, %s));",
                                   self.dst(f, a[0]),
                                   c_func_name(self.fnIdx[name]), argv, n))
                self.release_argv(seq, a[2])
                return
            }
            let idx = self.native(name)
            self.p(fmt.sprintf("  vl_set(&%s, vl_spawn_fn(NAT[%d], %s, %s));",
                               self.dst(f, a[0]), idx, argv, n))
            self.release_argv(seq, a[2])

        case "SPAWNR":
            self.p(fmt.sprintf("  vl_set(&%s, vl_spawn_closure(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))

        case "SEND":
            self.p(fmt.sprintf("  vl_chan_send(%s, vl_retain(%s));",
                               self.operand(f, a[0]), self.operand(f, a[1])))
        case "RECV":
            self.p(fmt.sprintf("  vl_set(&%s, vl_chan_recv(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))
        case "RECVOK":
            self.p(fmt.sprintf("  \{ Value ok%d; vl_set(&%s, " ||
                               "vl_chan_recv_ok(%s, &ok%d));", seq,
                               self.dst(f, a[0]), self.operand(f, a[2]),
                               seq))
            self.p(fmt.sprintf("    vl_set(&%s, ok%d); \}",
                               self.dst(f, a[1]), seq))

        case "ITER":
            self.p(fmt.sprintf("  vl_set(&%s, vl_iter(%s));",
                               self.dst(f, a[0]), self.operand(f, a[1])))
        case "ITNEXT":
            self.p(fmt.sprintf("  \{ Value ik%d, iv%d;", seq, seq))
            self.p(fmt.sprintf("    if (!vl_iter_next(%s, &ik%d, &iv%d)) " ||
                               "goto %s;", self.operand(f, a[2]), seq, seq,
                               a[3]))
            self.p(fmt.sprintf("    vl_set(&%s, ik%d); vl_set(&%s, iv%d); \}",
                               self.dst(f, a[0]), seq, self.dst(f, a[1]),
                               seq))

        case "PMATCH":
            if ins.Pat == 0 {
                self.failf("cgen: PMATCH without a structured pattern")
                return
            }
            self.p(fmt.sprintf("  vl_set(&%s, vl_bool(vl_match(F, %s, &%s, " ||
                               "K)));", self.dst(f, a[0]),
                               self.operand(f, a[1]),
                               self.mod.Pats[ins.Pat].CName))

        case "PARSE":
            self.emit_parse(f, ins, seq)

        case "ARGDEF":
            self.p(fmt.sprintf("  if (argc > %d) goto %s;", reg_slot(a[0]),
                               a[1]))
        case "VARARG":
            let slot = reg_slot(a[0])
            self.p(fmt.sprintf("  \{ Value va%d = vl_slice_new(0);", seq))
            self.p(fmt.sprintf("    for (int i = %d; i < argc; i++) " ||
                               "vl_slice_append(va%d, vl_retain(argv[i]));",
                               slot, seq))
            self.p(fmt.sprintf("    vl_set(&F->r[%d], va%d); \}", slot, seq))

        case "SELBEG":
            self.selCases = []
        case "FFI":
            self.emit_ffi(f, a)

        case "SELRECV", "SELSEND", "SELDEF":
            self.selCases.append(ins)
        case "SELEND":
            self.emit_select(f, seq)

        default:
            self.failf(fmt.sprintf("cgen: no C lowering for %s", ins.Op))
        }
    }

    // ------------------------------------------------------------ calls

    // ------------------------------------------------------------ ffi

    // ffi_index interns a C signature and returns its prototype's number.
    func ffi_index(mut self, sig str) int {
        each i, s in self.ffis {
            if s == sig { return i }
        }
        self.ffis.append(sig)
        return len(self.ffis) - 1
    }

    // emit_ffi renders `FFI dst, sig, params…` (low.lower_func_body): unbox
    // each argument by its C type, call the C function, box the result.
    //
    // A VARIADIC tail arrives as one slice. C cannot be handed a run-time
    // argument list, so every arity and every int/double arrangement up to
    // FFI_MAX_VARARGS is spelled out as its own call, and a switch on
    // 128 * count + (a bit per float argument) picks the one that matches —
    // 127 calls for six. An integer-class vararg travels as a 64-bit integer,
    // a float as a double: C's default argument promotions, applied by the
    // run-time kind of each value (ffi.c, vl_ffi_vclass).
    func emit_ffi(mut self, f ir.Func, a []str) {
        let sig = parse_ffi_sig(a[1])
        let pi = self.ffi_index(a[1])
        let fname = c_quote(sig.name)
        var fixed = []
        each i, ct in sig.params {
            fixed.append(ffi_arg(ct, self.operand(f, a[2 + i]), i + 1,
                                 fname))
        }
        var res = ""
        if sig.ret != "void" { res = "fr_ = " }
        self.p(fmt.sprintf("  \{ /* ffi %s */", sig.name))
        if sig.ret != "void" {
            self.p(fmt.sprintf("    %s fr_;", ffi_ctype_c(sig.ret)))
        }
        if not sig.variadic {
            self.p(fmt.sprintf("    %svlffi_%d(%s);", res, pi,
                               str.join(fixed, ", ")))
        } else {
            let va = self.operand(f, a[2 + len(sig.params)])
            self.p(fmt.sprintf("    Value *vp_ = vl_slice_data(%s);", va))
            self.p(fmt.sprintf("    int64_t vn_ = vl_len(%s);", va))
            self.p(fmt.sprintf("    if (vn_ > %d) vl_abort(\"ffi %%s: at " ||
                               "most %d variadic arguments\", %s);",
                               FFI_MAX_VARARGS, FFI_MAX_VARARGS, fname))
            self.p(fmt.sprintf("    long long vi_[%d] = \{0\}; double " ||
                               "vd_[%d] = \{0\}; int vm_ = 0;",
                               FFI_MAX_VARARGS, FFI_MAX_VARARGS))
            self.p("    for (int i = 0; i < vn_; i++) \{")
            self.p("      if (vl_ffi_vclass(vp_[i])) \{ vm_ |= 1 << i; " ||
                   "vd_[i] = vl_ffi_vdouble(vp_[i]); \}")
            self.p("      else vi_[i] = vl_ffi_vword(vp_[i]);")
            self.p("    \}")
            self.p("    switch ((int)vn_ * 128 + vm_) \{")
            var n = 0
            while n <= FFI_MAX_VARARGS {
                var mask = 0
                while mask < (1 << n) {
                    var args = []
                    each x in fixed { args.append(x) }
                    var k = 0
                    while k < n {
                        if (mask & (1 << k)) != 0 {
                            args.append(fmt.sprintf("vd_[%d]", k))
                        } else {
                            args.append(fmt.sprintf("vi_[%d]", k))
                        }
                        k += 1
                    }
                    self.p(fmt.sprintf("    case %d: %svlffi_%d(%s); break;",
                                       n * 128 + mask, res, pi,
                                       str.join(args, ", ")))
                    mask += 1
                }
                n += 1
            }
            self.p("    \}")
        }
        self.p(fmt.sprintf("    vl_set(&%s, %s);", self.dst(f, a[0]),
                           ffi_box(sig.ret)))
        self.p("  \}")
    }

    // ------------------------------------------------------------ -O3

    // const_rt maps "Kn" to the RT_* type of the pool constant.
    func const_rt(self, a str) int {
        if len(a) < 2 { return ir.RT_BOX }
        if a[0] != 'K' { return ir.RT_BOX }
        var v = 0
        var i = 1
        while i < len(a) {
            let c = a[i]
            if c < '0' or c > '9' { return ir.RT_BOX }
            v = v * 10 + (c - 48)
            i += 1
        }
        if v >= len(self.mod.Consts) { return ir.RT_BOX }
        let k = self.mod.Consts[v].Kind
        if k == ir.CINT { return ir.RT_INT }
        if k == ir.CFLOAT { return ir.RT_FLOAT }
        if k == ir.CBOOL { return ir.RT_BOOL }
        return ir.RT_BOX
    }

    // xty gives an operand's RT_* type: register slot or pool constant.
    func xty(self, f ir.Func, a str) int {
        let r = reg_slot(a)
        if r >= 0 { return self.rt(f, r) }
        return self.const_rt(a)
    }

    // nat renders an operand in native form. `want` is RT_INT or RT_FLOAT
    // (or RT_BOOL for booleans); an int operand in a float position widens
    // through vl_itof_ck — the same trap, in the same order, as the boxed
    // path's int_to_float.
    func nat(mut self, f ir.Func, a str, want int) str {
        let t = self.xty(f, a)
        let r = reg_slot(a)
        var e = ""
        if r >= 0 {
            if t == ir.RT_INT { e = fmt.sprintf("r%d_i", r) }
            if t == ir.RT_FLOAT { e = fmt.sprintf("r%d_f", r) }
            if t == ir.RT_BOOL { e = fmt.sprintf("r%d_b", r) }
        } else if str.starts_with(a, "K") {
            let n = atoi(a[1..len(a)])
            if n >= 0 and n < len(self.mod.Consts) {
                let c = self.mod.Consts[n]
                if c.Kind == ir.CINT { e = c.Text || "LL" }
                if c.Kind == ir.CFLOAT { e = c.Text }
                if c.Kind == ir.CBOOL { e = c.Text }
            }
        }
        if e == "" {
            self.failf(fmt.sprintf("cgen: operand %q is not native in %s",
                                   a, f.Name))
            return "0"
        }
        if want == ir.RT_FLOAT and t == ir.RT_INT {
            return fmt.sprintf("vl_itof_ck(%s)", e)
        }
        return e
    }

    // emit_native renders the typed-register instruction forms; it returns
    // false for anything the boxed paths should handle. A typed DESTINATION
    // on an op outside this table is an inference bug — dst() aborts on it.
    func emit_native(mut self, f ir.Func, ins ir.Instr) bool {
        let op = ins.Op
        let a = ins.Args

        // Branches read a typed bool source.
        if op == "JMPF" or op == "JMPT" {
            let r = reg_slot(a[0])
            if r >= 0 and self.rt(f, r) == ir.RT_BOOL {
                var neg = "!"
                if op == "JMPT" { neg = "" }
                self.p(fmt.sprintf("  if (%sr%d_b) goto %s;", neg, r, a[1]))
                return true
            }
            return false
        }

        if len(a) == 0 { return false }
        let d = reg_slot(a[0])
        if d < 0 { return false }
        let dt = self.rt(f, d)
        if dt == ir.RT_BOX { return false }

        var lhs = ""
        if dt == ir.RT_INT { lhs = fmt.sprintf("r%d_i", d) }
        if dt == ir.RT_FLOAT { lhs = fmt.sprintf("r%d_f", d) }
        if dt == ir.RT_BOOL { lhs = fmt.sprintf("r%d_b", d) }

        if op == "LOADK" or op == "MOVE" {
            self.p(fmt.sprintf("  %s = %s;", lhs, self.nat(f, a[1], dt)))
            return true
        }
        if op == "ADD" or op == "SUB" or op == "MUL" {
            if dt == ir.RT_INT and len(a) > 3 {
                // The sized form: the same inline core vl_arith_sz uses.
                var fn = "vl_iadd_sz"
                if op == "SUB" { fn = "vl_isub_sz" }
                if op == "MUL" { fn = "vl_imul_sz" }
                self.p(fmt.sprintf("  %s = %s(%s, %s, %d);", lhs, fn,
                                   self.nat(f, a[1], ir.RT_INT),
                                   self.nat(f, a[2], ir.RT_INT),
                                   sz_code(a[3])))
            } else if dt == ir.RT_INT {
                var fn = "vl_iadd_ck"
                if op == "SUB" { fn = "vl_isub_ck" }
                if op == "MUL" { fn = "vl_imul_ck" }
                self.p(fmt.sprintf("  %s = %s(%s, %s);", lhs, fn,
                                   self.nat(f, a[1], ir.RT_INT),
                                   self.nat(f, a[2], ir.RT_INT)))
            } else {
                var c = "+"
                if op == "SUB" { c = "-" }
                if op == "MUL" { c = "*" }
                self.p(fmt.sprintf("  %s = %s %s %s;", lhs,
                                   self.nat(f, a[1], ir.RT_FLOAT), c,
                                   self.nat(f, a[2], ir.RT_FLOAT)))
            }
            return true
        }
        if op == "DIV" {
            // `/` always yields float; two ints check div0 BEFORE widening,
            // exactly as the boxed path does.
            if self.xty(f, a[1]) == ir.RT_INT and
               self.xty(f, a[2]) == ir.RT_INT {
                self.p(fmt.sprintf("  %s = vl_idivf_ck(%s, %s);", lhs,
                                   self.nat(f, a[1], ir.RT_INT),
                                   self.nat(f, a[2], ir.RT_INT)))
            } else {
                self.p(fmt.sprintf("  %s = vl_fdiv_ck(%s, %s);", lhs,
                                   self.nat(f, a[1], ir.RT_FLOAT),
                                   self.nat(f, a[2], ir.RT_FLOAT)))
            }
            return true
        }
        if op == "IDIV" {
            if self.xty(f, a[1]) == ir.RT_INT and
               self.xty(f, a[2]) == ir.RT_INT and len(a) > 3 {
                self.p(fmt.sprintf("  %s = vl_idiv_sz(%s, %s, %d);", lhs,
                                   self.nat(f, a[1], ir.RT_INT),
                                   self.nat(f, a[2], ir.RT_INT),
                                   sz_code(a[3])))
            } else if self.xty(f, a[1]) == ir.RT_INT and
               self.xty(f, a[2]) == ir.RT_INT {
                self.p(fmt.sprintf("  %s = vl_ifloordiv(%s, %s);", lhs,
                                   self.nat(f, a[1], ir.RT_INT),
                                   self.nat(f, a[2], ir.RT_INT)))
            } else {
                self.p(fmt.sprintf("  %s = vl_ifloordiv_f(%s, %s);", lhs,
                                   self.nat(f, a[1], ir.RT_FLOAT),
                                   self.nat(f, a[2], ir.RT_FLOAT)))
            }
            return true
        }
        if op == "MOD" or op == "POW" {
            if dt == ir.RT_INT and op == "POW" and len(a) > 3 {
                self.p(fmt.sprintf("  %s = vl_ipow_sz(%s, %s, %d);", lhs,
                                   self.nat(f, a[1], ir.RT_INT),
                                   self.nat(f, a[2], ir.RT_INT),
                                   sz_code(a[3])))
            } else if dt == ir.RT_INT {
                var fn = "vl_ifloormod"
                if op == "POW" { fn = "vl_ipow_i" }
                self.p(fmt.sprintf("  %s = %s(%s, %s);", lhs, fn,
                                   self.nat(f, a[1], ir.RT_INT),
                                   self.nat(f, a[2], ir.RT_INT)))
            } else {
                var fn = "vl_ffloormod"
                if op == "POW" { fn = "vl_fpow" }
                self.p(fmt.sprintf("  %s = %s(%s, %s);", lhs, fn,
                                   self.nat(f, a[1], ir.RT_FLOAT),
                                   self.nat(f, a[2], ir.RT_FLOAT)))
            }
            return true
        }
        if op == "SHL" or op == "SHR" {
            var fn = "vl_ishl_ck"
            if op == "SHR" { fn = "vl_ishr_ck" }
            self.p(fmt.sprintf("  %s = %s(%s, %s);", lhs, fn,
                               self.nat(f, a[1], ir.RT_INT),
                               self.nat(f, a[2], ir.RT_INT)))
            return true
        }
        if op == "BAND" or op == "BOR" or op == "BXOR" {
            var c = "&"
            if op == "BOR" { c = "|" }
            if op == "BXOR" { c = "^" }
            self.p(fmt.sprintf("  %s = %s %s %s;", lhs,
                               self.nat(f, a[1], ir.RT_INT), c,
                               self.nat(f, a[2], ir.RT_INT)))
            return true
        }
        if op == "BNOT" {
            self.p(fmt.sprintf("  %s = ~%s;", lhs,
                               self.nat(f, a[1], ir.RT_INT)))
            return true
        }
        if op == "NEG" {
            if dt == ir.RT_INT and len(a) > 2 {
                self.p(fmt.sprintf("  %s = vl_ineg_sz(%s, %d);", lhs,
                                   self.nat(f, a[1], ir.RT_INT),
                                   sz_code(a[2])))
            } else if dt == ir.RT_INT {
                self.p(fmt.sprintf("  %s = vl_ineg_ck(%s);", lhs,
                                   self.nat(f, a[1], ir.RT_INT)))
            } else {
                self.p(fmt.sprintf("  %s = -%s;", lhs,
                                   self.nat(f, a[1], ir.RT_FLOAT)))
            }
            return true
        }
        if op == "NOT" {
            self.p(fmt.sprintf("  %s = !%s;", lhs,
                               self.nat(f, a[1], ir.RT_BOOL)))
            return true
        }
        if op == "CMPLT" or op == "CMPLE" or op == "CMPGT" or
           op == "CMPGE" or op == "CMPEQ" or op == "CMPNE" {
            var c = "<"
            if op == "CMPLE" { c = "<=" }
            if op == "CMPGT" { c = ">" }
            if op == "CMPGE" { c = ">=" }
            if op == "CMPEQ" { c = "==" }
            if op == "CMPNE" { c = "!=" }
            let tx = self.xty(f, a[1])
            let ty = self.xty(f, a[2])
            // The inference typed this BOOL, so both operands are native;
            // an int/float mix compares as floats, widening with the same
            // trap as the boxed path.
            var w = ir.RT_INT
            if tx != ir.RT_INT or ty != ir.RT_INT { w = ir.RT_FLOAT }
            if tx == ir.RT_BOOL and ty == ir.RT_BOOL { w = ir.RT_BOOL }
            self.p(fmt.sprintf("  %s = %s %s %s;", lhs,
                               self.nat(f, a[1], w), c,
                               self.nat(f, a[2], w)))
            return true
        }
        // A typed destination on any other op cannot happen; let the boxed
        // path's dst() failf with the precise message.
        return false
    }

    // emit_loadfn takes a function's address: a module function becomes a
    // closure, anything else a runtime lookup.
    func emit_loadfn(mut self, f ir.Func, a []str) {
        let name = a[1]
        if name in self.fnIdx {
            self.p(fmt.sprintf("  vl_set(&%s, vl_closure(%s, NULL));",
                               self.dst(f, a[0]),
                               c_func_name(self.fnIdx[name])))
            return
        }
        if str.contains(name, ".") and not (name in self.pkgConst) {
            // A variant constructor used as a value, or a package function.
            let typ, variant = split_variant(name)
            if self.is_variant(typ, variant) {
                self.p(fmt.sprintf("  vl_set(&%s, vl_closure(%s, NULL));",
                                   self.dst(f, a[0]),
                                   self.variant_ctor(typ, variant)))
                return
            }
        }
        if not (name in self.pkgConst) {
            self.native(name)   // a function reference: resolve it in NAT too
        } else if not (name in self.known) {
            self.failf(fmt.sprintf("cgen: `%s` is not available in native " ||
                                   "builds", name))
        }
        self.p(fmt.sprintf("  vl_set(&%s, vl_lookup_value(%s));",
                           self.dst(f, a[0]), c_quote(name)))
    }

    // emit_argk emits the run-time argument-kind check of a call to the
    // native `name` (low.NativeKinds), when it has a kinds row and the call
    // passes anything. A spread call's vector is a slice's storage, so it
    // is checked but never unwrapped in place.
    func emit_argk(mut self, name str, argv str, n str, spec str) {
        if not (name in self.natKinds) or argv == "NULL" { return }
        var fix = "true"
        each x in parse_args(spec) {
            if x.Spread { fix = "false" }
        }
        self.p(fmt.sprintf("  vl_argk(%s, %s, %s, %s, %s);", c_quote(name),
                           c_quote(self.natKinds[name]), argv, n, fix))
    }

    func emit_call(mut self, f ir.Func, a []str, seq int) {
        let name = a[1]
        let argv, n = self.emit_argv(f, seq, a[2])
        // `prelude:NAME` is a call the LOWERER synthesised (a set literal's
        // constructor, an open slice's len): it always means the native, so
        // it bypasses fnIdx, where a user function of the same name lives.
        // No user name contains a colon.
        if str.starts_with(name, "prelude:") {
            self.emit_argk(name[8..len(name)], argv, n, a[2])
            let pidx = self.native(name[8..len(name)])
            self.p(fmt.sprintf("  vl_set(&%s, NAT[%d](%s, %s, NULL));",
                               self.dst(f, a[0]), pidx, argv, n))
            self.release_argv(seq, a[2])
            return
        }
        if name in self.fnIdx {
            self.p(fmt.sprintf("  vl_set(&%s, %s(%s, %s, NULL));",
                               self.dst(f, a[0]),
                               c_func_name(self.fnIdx[name]), argv, n))
            self.release_argv(seq, a[2])
            return
        }
        let v = self.variant_call(name)
        if len(v) > 0 {
            self.p(fmt.sprintf("  vl_set(&%s, vl_enum_new(%s, %s, %s, %s));",
                               self.dst(f, a[0]), c_quote(v[0]),
                               c_quote(v[1]), argv, n))
            self.release_argv(seq, a[2])
            return
        }
        if str.ends_with(name, "]") {
            let br = str.index(name, "[")
            let base = name[0..br]
            var typ = name[br + 1..len(name)]
            if str.ends_with(typ, "]") { typ = typ[0..len(typ) - 1] }
            if base != "json.decode" and base != "sqlite.decode" {
                // Generics are type-erased everywhere else (§3.7):
                // cell[int](0) is simply cell(0).
                if base in self.fnIdx {
                    self.p(fmt.sprintf("  vl_set(&%s, %s(%s, %s, NULL));",
                                       self.dst(f, a[0]),
                                       c_func_name(self.fnIdx[base]), argv,
                                       n))
                    return
                }
                self.emit_argk(base, argv, n, a[2])
                let bidx = self.native(base)
                self.p(fmt.sprintf("  vl_set(&%s, NAT[%d](%s, %s, NULL));",
                                   self.dst(f, a[0]), bidx, argv, n))
                return
            }
            // json.decode[T] keeps its type argument: the runtime needs T
            // to shape the decoded value. So does sqlite.decode[T], a row
            // decoded into T by the same machinery (ext/sqlite.c).
            let jidx = self.native(base)
            self.p(fmt.sprintf("  Value ty%d = vl_str(%s);", seq,
                               c_quote(typ)))
            self.p(fmt.sprintf("  Value ja%d[8]; ja%d[0] = ty%d;", seq, seq,
                               seq))
            self.p(fmt.sprintf("  for (int i = 0; i < %s && i < 7; i++) " ||
                               "ja%d[i+1] = %s[i];", n, seq, argv))
            self.p(fmt.sprintf("  vl_set(&%s, NAT[%d](ja%d, %s + 1, NULL));",
                               self.dst(f, a[0]), jidx, seq, n))
            self.p(fmt.sprintf("  vl_release(ty%d);", seq))
            return
        }
        self.emit_argk(name, argv, n, a[2])
        let idx = self.native(name)
        self.p(fmt.sprintf("  vl_set(&%s, NAT[%d](%s, %s, NULL));",
                           self.dst(f, a[0]), idx, argv, n))
        self.release_argv(seq, a[2])
    }

    // ------------------------------------------------------------ composites

    // emit_composite builds a struct or exception value.
    func emit_composite(mut self, f ir.Func, ins ir.Instr, seq int,
                        isExc bool) {
        let a = ins.Args
        var typ = a[1]
        // Generics are type-erased: Stack[str] is the Stack descriptor (§3.7).
        let br = str.index(typ, "[")
        if br > 0 { typ = typ[0..br] }

        var pos = []
        var named = []
        each x in parse_args(a[2]) {
            if x.Name != "" {
                named.append(x)
            } else {
                pos.append(x)
            }
        }
        var posName = "NULL"
        var posN = "0"
        if len(pos) > 0 {
            var vals = []
            each x in pos {
                vals.append(self.operand(f, x.Reg))
            }
            self.p(fmt.sprintf("  Value cp%d[] = \{%s\};", seq,
                               str.join(vals, ", ")))
            posName = fmt.sprintf("cp%d", seq)
            posN = str(len(pos))
        }
        var nmName = "NULL"
        var nvName = "NULL"
        var nN = "0"
        if len(named) > 0 {
            var ks = []
            var vs = []
            each x in named {
                ks.append(c_quote(x.Name))
                vs.append(self.operand(f, x.Reg))
            }
            self.p(fmt.sprintf("  const char *cn%d[] = \{%s\};", seq,
                               str.join(ks, ", ")))
            self.p(fmt.sprintf("  Value cv%d[] = \{%s\};", seq,
                               str.join(vs, ", ")))
            nmName = fmt.sprintf("cn%d", seq)
            nvName = fmt.sprintf("cv%d", seq)
            nN = str(len(named))
        }
        var ctor = "vl_struct_new"
        if isExc { ctor = "vl_exc_new" }
        let dst = fmt.sprintf("F->r[%d]", reg_slot(a[0]))
        self.p(fmt.sprintf("  vl_set(&%s, %s(%s, %s, %s, %s, %s, %s));", dst,
                           ctor, c_quote(typ), posName, posN, nmName, nvName,
                           nN))

        // Field defaults for fields the literal omitted (§3.4).
        self.emit_field_defaults(typ, dst, seq, named, len(pos))
    }

    // emit_field_defaults fills declared defaults the composite literal
    // omitted.
    func emit_field_defaults(mut self, typ str, dst str, seq int,
                             named []CallArg, npos int) {
        if not (typ in self.defaults) { return }
        var given = set()
        each n in named {
            given.add(n.Name)
        }
        each i, fd in self.defaults[typ] {
            if fd.Name in given or i < npos or fd.ConstIdx < 0 { continue }
            self.p(fmt.sprintf("  vl_setfld(%s, %s, vl_retain(%s));", dst,
                               c_quote(fd.Name), fd.Ref))
        }
    }

    // ------------------------------------------------------------ parse

    // emit_parse renders the PARSE template.
    func emit_parse(mut self, f ir.Func, ins ir.Instr, seq int) {
        let a = ins.Args
        self.p(fmt.sprintf("  \{ static const VlTerm t%d[] = \{", seq))
        each t in ins.Terms {
            if t.Kind == ir.TERM_VAR {
                var slot = reg_slot(t.Reg)
                if slot < 0 {
                    self.failf(fmt.sprintf("cgen: `parse` into the " ||
                                           "captured variable `%s` is not " ||
                                           "supported in native builds",
                                           t.Name))
                    slot = 0
                }
                self.p(fmt.sprintf("    \{VL_T_VAR, %d, NULL, 0\},", slot))
            } else if t.Kind == ir.TERM_DISCARD {
                self.p("    \{VL_T_DISCARD, 0, NULL, 0\},")
            } else if t.Kind == ir.TERM_LIT {
                self.p(fmt.sprintf("    \{VL_T_LIT, 0, %s, 0\},",
                                   c_quote(t.Lit)))
            } else if t.Kind == ir.TERM_COL {
                self.p(fmt.sprintf("    \{VL_T_COL, 0, NULL, %d\},", t.Col))
            }
        }
        self.p("    \{VL_T_DISCARD, 0, NULL, 0\}\};")
        self.p(fmt.sprintf("    vl_parse(F, %s, %s, t%d, %d); \}",
                           self.operand(f, a[0]), c_quote(a[1]), seq,
                           len(ins.Terms)))
    }

    // ------------------------------------------------------------ select

    // emit_select renders a select statement from the buffered case
    // instructions.
    func emit_select(mut self, f ir.Func, seq int) {
        let cases = self.selCases
        self.selCases = []
        self.p(fmt.sprintf("  \{ VlSelCase sc%d[%d];", seq,
                           max(1, len(cases))))
        each i, c in cases {
            if c.Op == "SELRECV" {
                self.p(fmt.sprintf("    sc%d[%d].kind = VL_SEL_RECV; " ||
                                   "sc%d[%d].ch = %s;", seq, i, seq, i,
                                   self.operand(f, c.Args[1])))
            } else if c.Op == "SELSEND" {
                self.p(fmt.sprintf("    sc%d[%d].kind = VL_SEL_SEND; " ||
                                   "sc%d[%d].ch = %s; sc%d[%d].send = %s;",
                                   seq, i, seq, i,
                                   self.operand(f, c.Args[1]), seq, i,
                                   self.operand(f, c.Args[2])))
            } else if c.Op == "SELDEF" {
                self.p(fmt.sprintf("    sc%d[%d].kind = VL_SEL_DEFAULT;", seq,
                                   i))
            }
        }
        self.p(fmt.sprintf("    Value rv%d; bool ro%d;", seq, seq))
        self.p(fmt.sprintf("    int ch%d = vl_select(sc%d, %d, &rv%d, " ||
                           "&ro%d);", seq, seq, len(cases), seq, seq))
        each i, c in cases {
            self.p(fmt.sprintf("    if (ch%d == %d) \{", seq, i))
            if c.Op == "SELRECV" {
                // Args: label, chan, [value-bind], [ok-bind] — by POSITION.
                let binds = c.Args[2..len(c.Args)]
                if len(binds) > 0 {
                    let parts = str.split_n(binds[0], "=", 2)
                    if len(parts) == 2 {
                        self.p(fmt.sprintf("      vl_set(&F->r[%d], " ||
                                           "vl_retain(rv%d));",
                                           reg_slot(parts[1]), seq))
                    }
                }
                if len(binds) > 1 {
                    let parts = str.split_n(binds[1], "=", 2)
                    if len(parts) == 2 {
                        self.p(fmt.sprintf("      vl_set(&F->r[%d], " ||
                                           "vl_bool(ro%d));",
                                           reg_slot(parts[1]), seq))
                    }
                }
                self.p(fmt.sprintf("      vl_release(rv%d);", seq))
            }
            self.p(fmt.sprintf("      goto %s;", c.Args[0]))
            self.p("    \}")
        }
        self.p("  \}")
    }
}
