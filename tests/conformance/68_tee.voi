// chan.tee runs as ONE task with buffered outputs and a queue per output: a
// fast and a slow consumer read 200,000 values each, in order, without the
// fast one waiting for the slow one; outputs drained one after the other
// still work — 10,000 of them, more than the stage buffers, and readers that
// alternate between the outputs; and a delivered value leaves its queue.
use "std/chan"
use "std/time"

func main() {
    group {
        let src = chan[int](0)
        spawn {
            var i = 0
            while i < 200000 {
                src <- i
                i += 1
            }
            close(src)
        }
        let a, b = chan.tee(src)
        let done = chan[str](2)
        spawn {
            var n = 0
            var ordered = true
            each v in a {
                if v != n { ordered = false }
                n += 1
            }
            done <- "fast {n} {ordered}"
        }
        spawn {
            var n = 0
            var ordered = true
            each v in b {
                if v != n { ordered = false }
                n += 1
                if n % 20000 == 0 { time.sleep(time.Millisecond * 5) }
            }
            done <- "slow {n} {ordered}"
        }
        var got = [<-done, <-done]
        got.sort()
        say got
    }
    group {
        let a, b = chan.tee(chan.from(["x", "y", "z"]))
        say chan.collect(a)
        say chan.collect(b)
    }
    // More values than the stage buffers, read one output after the other:
    // `a` must END once src is drained, while `b` is still to be read.
    var xs = []
    var i = 0
    while i < 10000 {
        xs.append(i)
        i += 1
    }
    group {
        let a, b = chan.tee(chan.from(xs))
        let ga = chan.collect(a)
        let gb = chan.collect(b)
        say len(ga), len(gb), ga == xs, gb == xs
    }
    // Interleaved: one value from each in turn, then the rest of each.
    group {
        let a, b = chan.tee(chan.from(xs))
        var na = 0
        var nb = 0
        var k = 0
        while k < 3000 {
            let x, oka = <-a
            let y, okb = <-b
            if oka and okb and x == k and y == k {
                na += 1
                nb += 1
            }
            k += 1
        }
        each v in b { nb += 1 }
        each v in a { na += 1 }
        say na, nb
    }
}
