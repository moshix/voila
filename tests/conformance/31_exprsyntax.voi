// 31 — expression syntax: `if` and `match` as values, typed collection
// literals, several explicit type arguments, open-ended slices, postfix `?`,
// tuple destructuring and selection, parallel assignment, the richer match
// patterns, and `else { … }` after a fallible call.

enum Shape { Circle(r int), Ring(r int), Rect(w int, h int), Empty }
enum Color { Red, Green, Blue }
struct P { x int, y int }
struct Lru[K, V] { cap int, keys []K, vals []V }

exception Boom { why str }

// ---------------------------------------------------------- 1. if / match

func sign(n int) str {
    return if n < 0 { "neg" } else if n == 0 { "zero" } else { "pos" }
}

func describe(s Shape) str {
    let d = match s {
        Circle(r) | Ring(r) => "round r={r}"
        Rect(w, h) if w == h => "square {w}"
        Rect(w, h) => "rect {w}x{h}"
        Empty => "empty"
    }
    return d
}

// An arm may diverge: the value is then simply never produced.
func first_even(xs []int) int {
    each x in xs {
        let e = if x % 2 == 0 { x } else { continue }
        return e
    }
    return -1
}

func guarded(n int) str {
    let v = match n {
        0 => return "early"
        x if x > 100 => throw Boom{why: "too big"}
        _ => "n={n}"
    }
    return v
}

// ------------------------------------------------- 3. several type args

func mk[K, V](k K, v V) map[K]V {
    var m = make(map[K]V)
    m[k] = v
    return m
}

func swap[A, B](a A, b B) (B, A) { return b, a }

// --------------------------------------------------------- 5. postfix `?`

func half(n int) int! {
    if n % 2 != 0 { return err("odd: {n}") }
    return n ~/ 2
}

func eighth(n int) int! {
    return half(half(half(n)?)?)?
}

func lookup(m map[str]int, k str) ?int {
    if k in m { return m[k] }
    return nil
}

func sum2(m map[str]int, a str, b str) ?int {
    return lookup(m, a)? + lookup(m, b)?
}

// ----------------------------------------------------------- 6. tuples

func divmod(a int, b int) (int, int) { return a ~/ b, a % b }

// --------------------------------------------------------- 7. patterns

func bucket(n int) str {
    match n {
        -9..=-1 => return "small negative"
        0 | 1 | 2 => return "tiny"
        3..10 => return "single digit"
        10..=99 => return "two digits"
        _ => return "other"
    }
}

func kind(c rune) str {
    return match c {
        'a'..='z' | 'A'..='Z' => "letter"
        '0'..='9' => "digit"
        ' ' | '\t' => "space"
        _ => "other"
    }
}

func spot(p P) str {
    return match p {
        P{x: 0, y: 0} => "origin"
        P{x: 0, y} => "on the y axis at {y}"
        P{x, y: 0} => "on the x axis at {x}"
        P{x: 1 | 2, ..} => "near"
        P{x, y} => "at {x},{y}"
    }
}

func cell(t (int, bool)) str {
    return match t {
        (0, true) => "zero, set"
        (0, false) => "zero, clear"
        (n, true) => "{n}, set"
        (_, false) => "other, clear"
    }
}

func both(a ?int, b ?int) str {
    return match (a, b) {
        (Some(x), Some(y)) => "both {x} {y}"
        (Some(x), nil) | (nil, Some(x)) => "one {x}"
        (nil, nil) => "none"
    }
}

// A `?Enum` matched by `Some(x)` beside bare variants is still covered.
func shade(c ?Color) str {
    return match c { Red => "red"; Some(x) => "other"; nil => "none" }
}

// ------------------------------------------------------ 8. else { … }

func port(s str) int {
    let n = to_int(s) else { return 0 }
    return n
}

func port_or(s str) int {
    let n = to_int(s) else {
        let fallback = 8000
        fallback + 80
    }
    return n
}

func main() {
    say "-- 1. if and match as values"
    say sign(-4), sign(0), sign(9)
    say describe(Circle(2)), describe(Ring(3)), describe(Rect(2, 2)),
        describe(Rect(2, 5)), describe(Empty)
    say first_even([1, 3, 8, 5]), first_even([1, 3])
    say guarded(0), guarded(7)
    try {
        say guarded(500)
    } catch e: Boom {
        say "caught", e.why
    }
    let w = if let Some(v) = to_int("21") { v * 2 } else { 0 }
    let w2 = if let Some(v) = to_int("x") { v * 2 } else { -1 }
    say w, w2
    let nested = if true {
        let base = 10
        if base > 5 { base + 1 } else { base - 1 }
    } else {
        0
    }
    say nested
    let arm = match 3 { 1 => "one", 2 => "two", _ => "many" }
    say arm
    // A comma ends a one-statement arm, even after a `say` list.
    each k in [1, 2, 3] {
        match k { 1 => say "one", "uno", 2 => say "two", _ => say "many" }
    }

    say "-- 2. typed collection literals"
    let m = map[str]int{"a": 1, "b": 2, "a": 3}
    say len(m), m["a"], m["b"]
    let ages = map[str]int{
        "ann": 31,
        "bob": 42,
    }
    say ages["ann"] + ages["bob"]
    let none = map[str]int{}
    say len(none)
    let st = set[int]{3, 1, 3, 2, 1}
    say len(st), 1 in st, 4 in st
    let xs = []int{10, 20, 30, 40, 50}
    let empty = []str{}
    let grid = [][]int{[]int{1, 2}, []int{}, []int{3}}
    say xs, len(empty), grid, len(grid[1])

    let rows = []int{
        7
        8
    }
    say rows
    // `map` and `set` are still ordinary names when they are not literals.
    let set = [4, 5, 6]
    var map = make(map[str]int)
    map["k"] = set[1]
    say set[2], map["k"]

    say "-- 3. several explicit type arguments"
    let mm = mk[str, int]("k", 9)
    say mm["k"]
    let (b1, a1) = swap[int, str](1, "one")
    say b1, a1
    let cache = Lru[str, int]{cap: 2, keys: ["a"], vals: [1]}
    say cache.cap, cache.keys, cache.vals

    say "-- 4. open-ended slices"
    say xs[2..], xs[..2], xs[..=1], xs[..], xs[5..]
    let word = "voila!"
    say word[1..], word[..3], word[..]
    let mid = 2
    say xs[mid..][0], word[mid + 1..]

    say "-- 5. postfix ?"
    say eighth(64) else -1, eighth(12) else -1
    let tbl = map[str]int{"x": 4, "y": 5}
    say sum2(tbl, "x", "y") else -1, sum2(tbl, "x", "z") else -1

    say "-- 6. tuples"
    let t = (7, "seven", 7.5)
    say t.0, t.1, t.2
    let deep = ((1, 2), (3, (4, 5)))
    say deep.0.1, deep.1.1.0
    let (q, r) = divmod(17, 5)
    say q, r
    var (lo, hi) = (1, 9)
    lo += 1
    hi, lo = lo, hi
    say lo, hi
    var a = 1
    var b = 2
    var c = 3
    a, b, c = b, c, a
    say a, b, c
    var ys = [1, 2, 3]
    ys[0], ys[2] = ys[2], ys[0]
    say ys
    var dq = 0
    var dr = 0
    dq, dr = divmod(23, 4)
    say dq, dr
    var keep = 0
    keep, _ = divmod(9, 2)
    say keep

    say "-- 7. patterns"
    say bucket(-5), bucket(2), bucket(7), bucket(10), bucket(99), bucket(100)
    say kind('q'), kind('Q'), kind('7'), kind(' '), kind('#')
    say spot(P{x: 0, y: 0}), spot(P{x: 0, y: 4}), spot(P{x: 3, y: 0})
    say spot(P{x: 2, y: 9}), spot(P{x: 5, y: 6})
    say cell((0, true)), cell((0, false)), cell((4, true)), cell((4, false))
    say both(1, 2), both(1, nil), both(nil, 3), both(nil, nil)
    say shade(Red), shade(Blue), shade(nil)

    say "-- 8. else with a block"
    say port("8080"), port("http")
    say port_or("443"), port_or("")
}
