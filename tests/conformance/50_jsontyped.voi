// json.decode[T] is recursive and typed (§13.4): nested structs, slices of
// structs, maps, optionals, enums, newtypes, sets and Boxes come back as the
// types the program declared, and a mismatch is an error VALUE that names the
// JSON path. json.encode is its exact inverse.
use "std/json"

struct Limits { max_mb int, ratio float = 0.5, burst ?int }
struct Opt { level ?int = 3, name ?str }
type Id int
enum Color { Red, Green, Blue }
enum Shape { Circle(r float), Rect(w int, h int), Dot }
struct Svc {
    name   str
    id     Id
    limits Limits
    tags   []str
    nick   ?str
    color  Color
    shapes []Shape
    env    map[str]int
    ports  map[int]str
    uniq   set[int]
    price  dec
    boxed  Box[Limits]
    peers  []Svc
}

func show(r Svc!) {
    match r {
        Ok(v)  => say "ok", v.name
        Err(e) => say "error:", e.message()
    }
}

const DOC = `{
  "name": "api", "id": 7,
  "limits": {"max_mb": 64},
  "tags": ["a", "b"],
  "color": "Green",
  "shapes": [{"Circle": {"r": 1.5}}, {"Rect": [2, 3]}, "Dot"],
  "env": {"X": 1}, "ports": {"80": "http", "443": "https"},
  "uniq": [3, 1, 3],
  "price": 19.90,
  "boxed": {"max_mb": 1, "burst": 4},
  "peers": [{"name": "db", "id": 8, "limits": {"max_mb": 2, "ratio": 0.25},
             "tags": [], "color": "Red", "shapes": [], "env": {},
             "ports": {}, "uniq": [], "price": 0, "boxed": {"max_mb": 0},
             "peers": [], "unknown keys": "are ignored"}]
}`

func main() {
    let s = must json.decode[Svc](DOC)
    say s.name, s.id, s.limits.max_mb, s.limits.ratio, s.limits.burst
    say s.tags, s.nick, s.color, s.shapes
    say s.env, s.ports, s.uniq, s.price, s.boxed.get().burst
    say s.peers[0].name, s.peers[0].limits.ratio, s.peers[0].color
    say s.ports[443]

    // encode is the inverse: the round trip gives the same text back.
    let text = json.encode(s)
    say text
    let again = must json.decode[Svc](text)
    say json.encode(again) == text

    // Top-level shapes other than a struct.
    say json.decode[[]int]("[1, 2, 3]")
    say json.decode[map[str][]bool](`{"a": [true, false]}`)
    say json.decode[?int]("null"), json.decode[Color](`"Blue"`)
    say json.decode[[]u8]("[0, 255]")

    // Mismatches name the path.
    show(json.decode[Svc](`{"name": 5}`))
    show(json.decode[Svc](`{"name": "x", "id": 1, "limits": {"max_mb": "big"}}`))
    show(json.decode[Svc](`{"name": "x", "id": 1, "limits": {}}`))
    show(json.decode[Svc](`{"name": "x", "id": "seven"}`))
    show(json.decode[Svc](`[]`))
    say json.decode[[]Limits](`[{"max_mb": 1}, {"max_mb": 2.5}]`)
    say json.decode[[]Color](`["Red", "Mauve"]`)
    say json.decode[[]Shape](`[{"Rect": [1]}]`)
    say json.decode[map[int]str](`{"x": "y"}`)
    say json.decode[[]u8]("[1, 300]")
    say json.decode[[]str](`["ok", null]`)
    say json.decode[[]?str](`["ok", null]`)

    // An absent `?T` field with a default takes the default, not nil.
    say json.decode[Opt](`{}`), json.decode[Opt](`{"level": null}`)
    say json.decode[[]rune](`[65, "é", 1114112]`)
    say json.decode[[]rune](`["ab"]`)

    // The parser is strict (RFC 8259).
    say json.decode(`{"a": 1,}`)
    say json.decode(`[1, 2] x`)
    say json.decode("[01]")
    say json.decode("\"\u{1}\"")
    say json.decode(`"\q"`)
    say must json.decode(`"é 😀 \/"`)
    say must json.decode("123456789012345678901234567890")
    say json.encode("tab\t nl\n ctl\u{1} quote\" back\\")
    say json.pretty(Shape.Rect(1, 2))
}
