// std/time — the calendar half: decomposition, construction, RFC 3339.
//
// Every value printed here is built from a FIXED timestamp. Nothing that
// depends on the wall clock, the machine's timezone or the locale reaches
// stdout, because this golden is compared byte for byte at -O0, -O1, -O2 and
// -O3. The three clock-reading functions are exercised at the end, but only
// through invariants that answer the same way on every machine.
use "std/time"

// show prints one call as `input -> output`, so a diff against the golden
// names the case that broke rather than just the line number.
func show(what str, got str) {
    say what, "->", got
}

func main() {
    // ------------------------------------------------- construction, parts
    let d = must time.utc(2026, 8, 25, 13, 4, 5)
    show("utc(2026,8,25,13,4,5)", d.rfc3339())
    say "fields ->", d.year, d.month, d.day, d.hour, d.minute, d.second,
        d.nanosecond, d.offset
    say "show ->", d
    show("date_string", d.date_string())
    show("time_string", d.time_string())
    show("weekday_name", d.weekday_name())
    show("month_name", d.month_name())
    say "weekday ->", d.weekday()
    say "yearday ->", d.yearday()
    say "unix ->", d.unix()
    say "unix_millis ->", d.unix_millis()
    say "unix_nanos ->", d.unix_nanos()

    // A nanosecond field survives construction and formatting.
    let ns = must time.date(1999, 12, 31, 23, 59, 59, 123456789, 0)
    show("date(...123456789ns)", ns.rfc3339())
    show("millisecond only", (must time.date(2000, 1, 1, 0, 0, 0, 5000000, 0)).rfc3339())
    show("microsecond only", (must time.date(2000, 1, 1, 0, 0, 0, 5000, 0)).rfc3339())

    // -------------------------------------------------- the epoch and before
    show("from_unix(0)", time.from_unix(0).rfc3339())
    show("from_unix(-1)", time.from_unix(-1).rfc3339())
    show("from_unix(1787663045)", time.from_unix(1787663045).rfc3339())
    show("from_unix_nanos(-1)", time.from_unix_nanos(-1).rfc3339())
    show("from_unix_nanos(1)", time.from_unix_nanos(1).rfc3339())
    // 1900-01-01 predates the epoch by 70 years; the floor conventions are
    // what make a negative timestamp land on the right day rather than one
    // day out.
    show("from_unix(-2208988800)", time.from_unix(-2208988800).rfc3339())

    // ---------------------------------------------------------- leap years
    say "leap 1900 ->", time.is_leap_year(1900)
    say "leap 2000 ->", time.is_leap_year(2000)
    say "leap 2023 ->", time.is_leap_year(2023)
    say "leap 2024 ->", time.is_leap_year(2024)
    say "days_in_month(2024,2) ->", time.days_in_month(2024, 2)
    say "days_in_month(2023,2) ->", time.days_in_month(2023, 2)
    say "days_in_month(1900,2) ->", time.days_in_month(1900, 2)
    say "days_in_month(2000,2) ->", time.days_in_month(2000, 2)
    say "days_in_month(2024,4) ->", time.days_in_month(2024, 4)
    show("2024-02-29 exists", (must time.utc(2024, 2, 29, 0, 0, 0)).rfc3339())
    show("2024-12-31 yearday",
         str((must time.utc(2024, 12, 31, 0, 0, 0)).yearday()))
    show("2023-12-31 yearday",
         str((must time.utc(2023, 12, 31, 0, 0, 0)).yearday()))
    match time.utc(2023, 2, 29, 0, 0, 0) {
        Ok(x) => say "2023-02-29 wrongly accepted ->", x
        Err(e) => say "2023-02-29 ->", e.message()
    }

    // ------------------------------------------------------ month boundaries
    let feb28_leap = must time.utc(2024, 2, 28, 12, 0, 0)
    show("2024-02-28 + 24h", feb28_leap.add(24 * time.Hour).rfc3339())
    show("2024-02-28 + 48h", feb28_leap.add(48 * time.Hour).rfc3339())
    let feb28_plain = must time.utc(2023, 2, 28, 12, 0, 0)
    show("2023-02-28 + 24h", feb28_plain.add(24 * time.Hour).rfc3339())
    let newyear = must time.utc(2025, 12, 31, 23, 59, 59)
    show("2025-12-31T23:59:59 + 1s", newyear.add(time.Second).rfc3339())
    show("2025-01-01T00:00:00 - 1s",
         (must time.utc(2025, 1, 1, 0, 0, 0)).add(-time.Second).rfc3339())
    // A sub-second carry across a month boundary.
    let edge = must time.date(2024, 1, 31, 23, 59, 59, 750000000, 0)
    show("2024-01-31T23:59:59.75 + 500ms",
         edge.add(500 * time.Millisecond).rfc3339())

    // --------------------------------------------------- a fixed offset
    // +05:30 is India: a non-zero offset that is not a whole hour, so it
    // catches an implementation that only ever divides by 3600.
    let ist = must time.date(2026, 8, 25, 18, 34, 5, 0, 19800)
    show("date(+05:30)", ist.rfc3339())
    say "same moment as UTC reading ->", ist.same_moment(d)
    say "unix agrees ->", ist.unix() == d.unix()
    show("to_utc", ist.to_utc().rfc3339())
    show("to_offset(-05:00)", ist.to_offset(0 - 5 * 3600).rfc3339())
    show("to_offset(-00:01)", ist.to_offset(0 - 60).rfc3339())
    show("UTC reading to +05:30", d.to_offset(19800).rfc3339())
    // Crossing the date line by offset alone: the same instant is a
    // different DAY at +14:00 and at -11:00.
    let atUtc = must time.utc(2026, 8, 25, 0, 30, 0)
    show("+14:00 reading", atUtc.to_offset(14 * 3600).rfc3339())
    show("-11:00 reading", atUtc.to_offset(0 - 11 * 3600).rfc3339())
    say "still one moment ->",
        atUtc.to_offset(14 * 3600).same_moment(atUtc.to_offset(0 - 11 * 3600))

    // ------------------------------------------------------ ordering
    say "before ->", feb28_plain.before(feb28_leap)
    say "after ->", feb28_leap.after(feb28_plain)
    say "not before itself ->", d.before(d)

    // ------------------------------------------------- RFC 3339 round trip
    each s in ["2026-08-25T13:04:05Z", "2026-08-25T13:04:05.25+02:00",
               "1970-01-01T00:00:00Z", "1969-12-31T23:59:59.999999999Z",
               "2024-02-29T00:00:00+05:30", "2026-08-25t13:04:05z",
               "2026-08-25 13:04:05Z", "0001-01-01T00:00:00Z",
               "9999-12-31T23:59:59.000001Z"] {
        let p = must time.parse_rfc3339(s)
        say "parse", s, "->", p.rfc3339(), p.unix(), p.offset
    }
    // The round trip is exact for a value this package produced: text ->
    // DateTime -> text is the identity, offset and all.
    let rt = must time.parse_rfc3339(ist.rfc3339())
    say "round trip exact ->", rt.rfc3339() == ist.rfc3339(),
        rt.offset == ist.offset, rt.same_moment(ist)

    // ------------------------------------------------------- parse refusals
    each bad in ["", "2026-08-25", "2026-08-25T13:04:05", "2026-13-25T13:04:05Z",
                 "2026-08-32T13:04:05Z", "2026-08-25T24:04:05Z",
                 "2026-08-25T13:60:05Z", "2026-08-25T13:04:60Z",
                 "2026-08-25X13:04:05Z", "2026-08-25T13:04:05.Z",
                 "2026-08-25T13:04:05+0200", "2026-08-25T13:04:05+02:00xyz",
                 "20260825T130405Z", "2026-08-25T13:04:05+99:00"] {
        match time.parse_rfc3339(bad) {
            Ok(x) => say "wrongly accepted", bad, "->", x
            Err(e) => say "refused ->", e.message()
        }
    }

    // ------------------------------------------------- back to an instant
    let i = d.to_instant()
    say "to_instant unix ->", i.unix()
    say "to_instant unix_nanos ->", i.unix_nanos()
    say "instant round trip ->", time.from_instant(i).rfc3339() == d.rfc3339()
    say "instant at offset ->", time.from_instant_at(i, 19800).rfc3339()

    // ------------------------------------------------------- the clock
    // No wall-clock VALUE is printed, and nothing here asserts anything about
    // the MACHINE's offset — `TZ` is not pinned by the test runner, and POSIX
    // admits offsets that are not whole minutes and offsets of a full day, so
    // "the local offset is a whole number of minutes" would be a golden that
    // a legal TZ can flip. Every line below is either pure or reads the clock
    // ONCE and asks something true of every instant.
    let now = time.now()
    say "now_utc is sane ->", time.now_utc().year >= 2020
    say "now_local is a real date ->",
        time.now_local().month >= 1 and time.now_local().month <= 12
    say "local reading is the same moment ->",
        time.local(now).same_moment(time.from_instant(now))
    say "local reading carries the offset it was read at ->",
        time.local(now).offset == time.offset_at(now)
    say "instant survives the round trip ->",
        time.from_instant(now).to_instant().unix_nanos() == now.unix_nanos()
    say "to_local keeps the moment ->",
        d.to_local().same_moment(d)
    // instant.unix() floors, exactly as DateTime.unix() does, so a pre-epoch
    // fraction cannot read as one second on the calendar and another here.
    let preepoch = must time.date(1969, 12, 31, 23, 59, 59, 500000000, 0)
    say "instant.unix floors ->", preepoch.to_instant().unix(),
        preepoch.unix(), preepoch.to_instant().unix_millis()
}
