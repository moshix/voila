struct Point { x float, y float }
trait Show { func show(self) str }
impl Show for Point {
    func show(self) str { return "({self.x}, {self.y})" }
}
impl Point {
    func shift(mut self, dx float) { self.x += dx }
    func origin() Point { return Point{0.0, 0.0} }
}
struct Stack[T] { items []T }
impl[T] Stack[T] {
    func push(mut self, own v T) { self.items.append(v) }
    func pop(mut self) ?T { return self.items.pop() }
    func depth(self) int { return len(self.items) }
}
// A trait method may live in an INHERENT impl block. The runtime dispatches
// through ONE flat (type, method) table with no notion of which block an
// entry came from, so `Marker` satisfies `Tag` when the program runs — and
// the checker judges conformance against the union of every impl on a type.
// This case is here so that union rule can never silently tighten.
trait Tag { func tag(self) str }
struct Marker { n int }
impl Marker { func tag(self) str { return "marker#{self.n}" } }
impl Tag for Marker { }

func divmod(a, b int) (int, int) { return a~/b, a % b }
func greet(name str, greeting str = "Hello") str { return "{greeting}, {name}!" }
func total(nums ...int) int {
    var t = 0
    each n in nums { t += n }
    return t
}
func make_const(n int) fn() int { return fn() int { return n } }

// `unit` is the EMPTY type (§3.1) — the result type of a function with no
// result — so a `unit` function may fall off its end and may `return` bare,
// exactly like one that declares nothing at all. A checker that counted the
// annotation as an owed result would reject all three of these.
func announce(s str) unit { say "unit: " || s }

func classify(n int) unit {
    if n < 0 { return }
    say "unit: nonneg"
}

func nothing() () { }

func main() {
    let p = Point{x: 1.5, y: 2.5}
    say p.show(), p
    var q = Point{1.0, 2.0}
    q.shift(3.0)
    say q
    say Point.origin()
    var st = Stack[int]{items: []}
    st.push(1)
    st.push(2)
    say st.depth(), st.pop(), st.pop(), st.pop()
    let a, b = divmod(17, 5)
    say a, b
    say greet("moshix"), greet("moshix", greeting: "Ciao")
    say total(1, 2, 3), total([4, 5]...)
    let double = fn(x int) int { return x * 2 }
    say double(21), [1,2,3].map(fn(x) { x * x })
    var counter = 0
    let inc = fn() { counter += 1 }
    inc()
    inc()
    say counter
    // A closure over a loop variable must be built through a helper that takes
    // the value as a parameter: each iteration then has its own binding in
    // both engines. (Capturing the loop variable directly is refused by the
    // native backend — see tests/negative/loopcapture.)
    var fs = []
    for i in 0..3 { fs.append(make_const(i)) }
    var got = []
    each f in fs { got.append(f()) }
    say fs.len(), got
    let mk = Marker{n: 7}
    say mk.tag()
    announce("fell off the end")
    classify(-1)
    classify(0)
    nothing()
}
