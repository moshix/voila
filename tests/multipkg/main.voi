package main

use "app/geom"
use "app/report"
use "app/geom" as g
use "app/Box"

func main() {
    let shapes = [Circle(2.0), Rect(3.0, 4.0)]
    var lines = []
    each s in shapes {
        lines.append(report.Describe(s))
    }
    report.Render(lines)

    let b = geom.MakeBox(2.0, 5.0)
    say b, b.Area()

    // A second file of the same package; a cross-package exception; a trait
    // implemented in one package and called from another; a generic type.
    say geom.Describe(b)
    try {
        let bad = geom.Validate(geom.MakeBox(-1.0, 2.0))
        say bad
    } catch e: geom.BadShape {
        say "caught:", e.why
    }
    let p = geom.MakePair(1.5, 2.5)
    say p, p.a + p.b

    // An alias for an imported package.
    say g.Area(Circle(1.0))

    geom.Set("hello")
    say geom.Get(), geom.Defaulted()

    // A trait DEFAULT inherited by a type whose name matches a PACKAGE must
    // not steal that package's function slot. `Box.Area` is minted twice —
    // once by Box/area.voi, once as the inherited default below — and the
    // package function must keep it. (It briefly did not: the inherited-
    // default alias overwrote fnIdx unguarded, so this printed 7.)
    say Box.Area()
    let boxed = Box{}
    say boxed.Area()

    // A local may shadow a package name; the loader must respect that.
    let geom = 42
    say geom
}

// Named to collide with the `Box` package on purpose; see above.
trait Measured { func Area() int = 7 }
struct Box { }
impl Measured for Box { }
