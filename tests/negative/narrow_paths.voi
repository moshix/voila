// Nil narrowing of a LOCATION (`s.v`, `ss[0].v`, `m["a"]`) is undone by any
// write that may reach it: an assignment to it or to the root, a method that
// writes its receiver, a `mut` argument, a closure that writes through the
// root, a collection method that writes. Each refusal is a program that
// reaches arithmetic with nil.
struct S { v ?int }
impl S { func reset(mut self) { self.v = nil } }
func clear(s mut S) { s.v = nil }
func a() int {
    var s = S{v: 1}
    if s.v != nil { s.v = nil; return s.v + 1 }
    return 0
}
func b() int {
    var s = S{v: 1}
    if s.v != nil { s.reset(); return s.v + 1 }
    return 0
}
func c() int {
    var s = S{v: 1}
    if s.v != nil { clear(s); return s.v + 1 }
    return 0
}
func d() int {
    var s = S{v: 1}
    if s.v != nil { s = S{v: nil}; return s.v + 1 }
    return 0
}
func e() int {
    var m = map[str]?int{"a": 1}
    if m["a"] != nil { m.remove("a"); return m["a"] + 1 }
    return 0
}
func f() int {
    var ss = [S{v: 1}]
    if ss[0].v != nil { ss[0].v = nil; return ss[0].v + 1 }
    return 0
}
func g() int {
    var s = S{v: 1}
    let wipe = fn() { s.v = nil }
    if s.v == nil { return 0 }
    wipe()
    return s.v + 1
}
func h(p S) int {
    if p.v != nil {
        var p = S{v: nil}               // a new p: its p.v is not narrowed
        return p.v + 1
    }
    return 0
}
func ok() int {
    var s = S{v: 1}
    if s.v == nil { return 0 }
    return s.v + 1
}
func main() { say a(), b(), c(), d(), e(), f(), g(), h(S{v: 1}), ok() }
