// Operators take operands of the kinds they are defined on (§5.1): no
// cross-kind comparison, no `+` that concatenates, no truthiness.
struct P { x int }
struct Q { x int }
func main() {
    let n = 3
    let s = "x"
    let b = true
    say n == s
    say n + s
    say s - 1
    say b * 2
    say P{x: 1} == Q{x: 1}
    say [1] == "1"
    if n { say "n" }
    while s { say "s" }
    say n and b
    say not s
    say -s
    // Legal: numbers mix along the lattice, a rune is a number and the
    // string it denotes, `||` converts, `in` takes a string.
    say n + 2.5, n * 2, 'A' == "A", 'a' + 1, s || n || b, "x" in s
    say n / 2, n ~/ 2, 3d * n, n == 3.0, b == true, P{x: 1} == P{x: 1}
}
