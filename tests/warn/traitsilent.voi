// The third batch's constructs under -Wall: generic traits and their
// bounds, Self, static methods through a type parameter, std/iter and Ord.
// Every one of them is a working program (tests/conformance/41_generictraits
// and 42_selfstatic run it), so nothing here may be reported.
use "std/iter"
use "std/sort"

trait Into[T] {
    func into(self) T
    func twice(self) (T, T) = (self.into(), self.into())
}

trait Named { func name(self) str }

// A marker trait: implemented at two arguments by one type, which the
// by-name dispatch allows because neither impl writes a method.
trait Tag[T] { }

type Cel int
type Label str

impl Into[str] for Cel { func into(self) str { return "{int(self)}C" } }
impl Into[int] for Label { func into(self) int { return len(str(self)) } }
impl Named for Cel { func name(self) str { return "celsius" } }
impl Tag[int] for Cel { }
impl Tag[str] for Cel { }

// Two parameters, one of them in the other's bound.
trait Pair[A, B] { func pair(self) (A, B) }
impl Pair[str, int] for Label {
    func pair(self) (str, int) { return str(self), self.into() }
}

func render[T: Into[str]](x T) str { return "[" || x.into() || "]" }

func both[T: Into[str] + Named](x T) str { return x.name() || "=" || x.into() }

func described[T](x T) str where T: Named + Into[str] {
    return x.name() || ":" || x.into()
}

// A where clause on a generic impl block.
struct Shelf[T] { items []T }
impl[T] Shelf[T] where T: Into[str] {
    func line(self) str {
        var out = []
        each it in self.items { out.append(it.into()) }
        return out.join(", ")
    }
}

// std/iter: a type promises the protocol; `each` drives it.
struct Countdown { n int }
impl iter.Iterator[int] for Countdown {
    func next(mut self) ?int {
        if self.n == 0 { return nil }
        self.n -= 1
        return self.n + 1
    }
}

func total[I: iter.Iterator[int]](it mut I) int {
    var t = 0
    each v in it { t += v }
    return t
}

// Ord: ordering by the type's own cmp.
struct Ver { major int, minor int }
impl Ord for Ver {
    func cmp(self, o Ver) int {
        if self.major != o.major { return self.major - o.major }
        return self.minor - o.minor
    }
}
enum Size { Small, Large(n int) }
impl Size {
    func cmp(self, o Size) int { return self.rank() - o.rank() }
    func rank(self) int {
        match self {
            Small => return 0
            Large(n) => return n
        }
    }
}

func main41() {
    let c = Cel(21)
    say render(c), render[Cel](Cel(-4))
    say c.twice(), Label("abc").twice()
    say both(c), described(c)
    say Label("hello").pair()

    // A trait at arguments is a type: a slice of it dispatches dynamically.
    var xs []Into[str] = [Cel(1), Cel(2)]
    each x in xs { say x.into() }

    say Shelf[Cel]{items: [Cel(1), Cel(30)]}.line()

    each v in (Countdown{n: 3}) { say "tick", v }
    var cd = Countdown{n: 4}
    say iter.collect(cd), iter.count(Countdown{n: 5}), total(Countdown{n: 4})

    var vs = [Ver{1, 2}, Ver{0, 9}, Ver{1, 0}]
    sort.sort(vs)
    say vs
    say Ver{1, 2} < Ver{1, 3}, Ver{2, 0} >= Ver{1, 9}, Ver{1, 1} == Ver{1, 1}
    say max(Ver{1, 1}, Ver{0, 5}), min(Ver{1, 1}, Ver{0, 5})
    say [Large(5), Small, Large(2)].sorted(), Small < Large(1)
}
trait Default {
    func default() Self
    func reset(self) Self = Self.default()    // Self, through the receiver
}

trait Eq2 { func same(self, o Self) bool }

trait Labelled {
    func name() str = "anon"                  // an inherited static default
    func label(self) str = "<" || Self.name() || ">"
}

struct Point { x int, y int }
type Deg int

impl Default for Point {
    func default() Self { return Self{x: 1, y: 2} }
}
impl Eq2 for Point {
    func same(self, o Self) bool { return self.x == o.x and self.y == o.y }
}
impl Labelled for Point { }

impl Default for Deg { func default() Deg { return Deg(37) } }
impl Labelled for Deg { func name() str { return "cel" } }

impl Default for int { func default() int { return 42 } }

impl Point {
    func doubled(self) Self { return Self{x: self.x * 2, y: self.y * 2} }
    func origin(self) bool {
        match self {
            Self{x: 0, y: 0} => return true
            _ => return false
        }
    }
    func tell(self) str { return "{Self.name()}@{self.x}" }
    func maker(self) fn() Self { return fn() Self { return Self.default() } }
}

func make[T: Default]() T { return T.default() }
func like[T: Default](x T) T { return T.default() }
func forward[T: Default]() T { return make[T]() }
func two[A: Default, B](b B) (A, B) { return A.default(), b }
func name_of[T: Labelled]() str { return T.name() }
func in_closure[T: Default]() T {
    let f = fn() T { return T.default() }
    return f()
}
func with_default[T: Default](n int = 3) (T, int) { return T.default(), n }

func main() {
    say Point.default(), Deg.default(), int.default()
    say make[Point](), make[Deg](), make[int]()
    say like(Point{9, 9}), like(Deg(1)), like(5)
    say forward[Point](), forward[Deg]()
    say two[Deg, str]("b")
    say name_of[Point](), name_of[Deg]()
    say in_closure[Point](), with_default[Deg](), with_default[int](n: 8)
    say Point{5, 6}.reset(), Deg(3).reset()
    say Point{1, 2}.same(Point.default()), Point{0, 0}.origin()
    say Point{2, 3}.doubled(), Point{4, 4}.tell(), Point{1, 1}.label()
    say Deg(0).label()
    let mk = Point{0, 0}.maker()
    say mk()
}
